{% extends "layout.twig" %}

{% block title %}{{ header_title }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}
<div class="container mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ header_title }}</h2>
        <span class="badge bg-warning text-dark" style="font-size: 0.7rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="নিরাপত্তা সেটিংস শুধুমাত্র সুপারঅ্যাডমিন এবং অ্যাডমিনরা পরিবর্তন করতে পারবেন। পাসওয়ার্ড নীতি, 2FA এবং সেশন টাইমআউট সকল ব্যবহারকারীকে প্রভাবিত করে।">
            <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু
        </span>
    </div>

    <form id="securitySettingsForm" method="POST" action="/settings/security" class="mt-4">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="mb-3">
            <label for="password_policy" class="form-label">Password Policy</label>
            <input
                type="text"
                class="form-control"
                id="password_policy"
                name="settings[password_policy]"
                value="{{ security_settings.password_policy|e }}"
                placeholder="e.g. Minimum 8 characters, 1 uppercase, 1 number"
            >
            <div class="form-text">Specify password rules for users.</div>
        </div>

        <div class="mb-3 form-check">
            <input
                type="checkbox"
                class="form-check-input"
                id="two_factor_enabled"
                name="settings[two_factor_enabled]"
                value="1"
                {% if security_settings.two_factor_enabled == '1' %}checked{% endif %}
            >
            <label class="form-check-label" for="two_factor_enabled">Enable Two-Factor Authentication (2FA)</label>
        </div>

        <div class="mb-3">
            <label for="session_timeout_minutes" class="form-label">Session Timeout (minutes)</label>
            <input
                type="number"
                min="1"
                class="form-control"
                id="session_timeout_minutes"
                name="settings[session_timeout_minutes]"
                value="{{ security_settings.session_timeout_minutes|default(30) }}"
            >
            <div class="form-text">Set how long user sessions last before automatic logout.</div>
        </div>

        <button type="submit" class="btn btn-primary">Save Security Settings</button>
    </form>

    <div id="securityAlert" class="alert mt-3 d-none" role="alert"></div>
</div>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('securitySettingsForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            var btn = form.querySelector('button[type="submit"]');
            var url = form.getAttribute('action');
            var data = new URLSearchParams(new FormData(form)).toString();
            var restore = btnLoading(btn, 'সংরক্ষণ করা হচ্ছে...');
            var alertEl = document.getElementById('securityAlert');

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: data
            })
            .then(function(r) { return r.json(); })
            .then(function(response) {
                alertEl.classList.remove('d-none', 'alert-danger', 'alert-success');
                if (response.status === 'success') {
                    alertEl.classList.add('alert-success');
                } else {
                    alertEl.classList.add('alert-danger');
                }
                alertEl.textContent = response.message;
                restore();
            })
            .catch(function() {
                alertEl.classList.remove('d-none', 'alert-success');
                alertEl.classList.add('alert-danger');
                alertEl.textContent = 'Something went wrong. Please try again.';
                restore();
            });
        });
    }

    // Initialize admin-only tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            new bootstrap.Tooltip(el, { trigger: 'hover focus', boundary: 'clippingParents' });
        }
    });
});
</script>
{% endblock %}
{% endblock %}
