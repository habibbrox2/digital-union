{% extends "layout.twig" %}

{% block title %}{{ title }}{% endblock %}
{% block header_title %}{{ header_title }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}

<div class="container py-4">
    <div class="card shadow-lg border-0">
        <div class="card-body">

            <h2 class="mb-4 text-center text-primary">{{ header_title }}</h2>

            <!-- Search -->
            <div class="row mb-4 justify-content-center">
                <div class="col-md-6">
                    <input type="text" id="searchTerm" class="form-control form-control-lg" placeholder="🔍 অনুসন্ধান করুন (নাম, পোস্ট কোড, উপজেলা...)">
                </div>
            </div>

            <!-- Form -->
            <form id="poForm" class="row g-3 mb-5 p-4 bg-light rounded border">
                <div id="responseMessage" class="col-12"></div>
                <input type="hidden" name="id" id="id">

                <div class="col-md-4">
                    <label for="upazila_name" class="form-label fw-semibold">উপজেলা <span class="text-danger">*</span></label>
                    <select name="upazila_name" id="upazila_name" class="form-select" required>
                        <option value="">— উপজেলা নির্বাচন করুন —</option>
                        {% for u in upazilas %}
                            <option value="{{ u.name_en }}">{{ u.name_en }} ({{ u.name_bn }})</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="union_name" class="form-label fw-semibold">ইউনিয়ন <span class="text-danger">*</span></label>
                    <select name="union_name" id="union_name" class="form-select" required>
                        <option value="">— ইউনিয়ন নির্বাচন করুন —</option>
                        {% for u in unions %}
                            <option value="{{ u.name_en }}">{{ u.name_en }} ({{ u.name_bn }})</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="en_name" class="form-label fw-semibold">পোস্ট অফিস (ইংরেজি)</label>
                    <input type="text" name="en_name" id="en_name" class="form-control" placeholder="Post office name (English)">
                </div>

                <div class="col-md-4">
                    <label for="bn_name" class="form-label fw-semibold">পোস্ট অফিস (বাংলা)</label>
                    <input type="text" name="bn_name" id="bn_name" class="form-control" placeholder="পোস্ট অফিসের নাম (বাংলায়)">
                </div>

                <div class="col-md-4">
                    <label for="post_code" class="form-label fw-semibold">পোস্ট কোড</label>
                    <input type="text" name="post_code" id="post_code" class="form-control" placeholder="যেমন: 1350">
                </div>

                <div class="col-12 text-end">
                    <button type="button" id="cancelEdit" class="btn btn-secondary btn-lg px-4 me-2" style="display:none;">বাতিল</button>
                    <button type="submit" class="btn btn-success btn-lg px-4">💾 সংরক্ষণ করুন</button>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive mb-4">
                <table class="table table-hover table-bordered align-middle" id="poTable">
                    <thead class="table-primary">
                        <tr>
                            <th data-column="p.upazila_name" style="cursor:pointer;">উপজেলা ⬍</th>
                            <th data-column="p.union_name" style="cursor:pointer;">ইউনিয়ন ⬍</th>
                            <th data-column="p.en_name" style="cursor:pointer;">পোস্ট অফিস (ইং) ⬍</th>
                            <th data-column="p.bn_name" style="cursor:pointer;">পোস্ট অফিস (বাং) ⬍</th>
                            <th data-column="p.post_code" style="cursor:pointer;">পোস্ট কোড ⬍</th>
                            <th class="text-center" style="width:160px;">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div id="pagination" class="d-flex justify-content-center mt-4"></div>
        </div>
    </div>
</div>

<script>
var currentPage = 1;
var currentSort = { column: 'p.upazila_name', direction: 'asc' };
var searchQuery = '';

function loadItems(page) {
    page = page || currentPage;
    currentPage = page;

    var params = new URLSearchParams({
        action: 'filter',
        page: page,
        sortColumn: currentSort.column,
        sortDirection: currentSort.direction,
        search: searchQuery
    });

    fetch('/ajax/post-offices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        var tbody = document.querySelector('#poTable tbody');
        if (res.status !== 'success') {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">তথ্য লোড করতে ব্যর্থ</td></tr>';
            return;
        }

        var html = '';
        if (!res.data || !res.data.length) {
            html = '<tr><td colspan="6" class="text-center text-muted">কোনো পোস্ট অফিস পাওয়া যায়নি</td></tr>';
        } else {
            res.data.forEach(function(item) {
                html += '<tr>' +
                    '<td>' + escapeHtml(item.upazila_name) + '</td>' +
                    '<td>' + escapeHtml(item.union_name) + '</td>' +
                    '<td>' + escapeHtml(item.en_name) + '</td>' +
                    '<td>' + escapeHtml(item.bn_name) + '</td>' +
                    '<td>' + escapeHtml(item.post_code) + '</td>' +
                    '<td class="text-center">' +
                        '<button class="btn btn-sm btn-warning me-1 edit-po-btn" data-po-id="' + item.id + '">সম্পাদনা</button>' +
                        '<button class="btn btn-sm btn-danger delete-po-btn" data-po-id="' + item.id + '">মুছুন</button>' +
                    '</td>' +
                '</tr>';
            });
        }

        tbody.innerHTML = html;
        renderPagination(res.total, page);
    })
    .catch(function() {
        document.querySelector('#poTable tbody').innerHTML = '<tr><td colspan="5" class="text-center text-danger">সার্ভার ত্রুটি</td></tr>';
    });
}

function renderPagination(totalItems, curPage) {
    var itemsPerPage = 20;
    var totalPages = Math.ceil(totalItems / itemsPerPage);
    var paginationEl = document.getElementById('pagination');

    if (totalPages <= 1) {
        paginationEl.innerHTML = '';
        return;
    }

    var html = '<nav><ul class="pagination justify-content-center">';
    for (var i = 1; i <= totalPages; i++) {
        html += '<li class="page-item ' + (i === curPage ? 'active' : '') + '">' +
            '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
    }
    html += '</ul></nav>';
    paginationEl.innerHTML = html;
}

function editItem(id) {
    var params = new URLSearchParams({ action: 'get', id: id });
    fetch('/ajax/post-offices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(item) {
        if (!item || item.status === 'error') {
            Swal.fire('ত্রুটি', item.message || 'পাওয়া যায়নি', 'error');
            return;
        }
        document.getElementById('id').value = item.id;
        document.getElementById('upazila_name').value = item.upazila_name;
        document.getElementById('union_name').value = item.union_name;
        document.getElementById('en_name').value = item.en_name;
        document.getElementById('bn_name').value = item.bn_name;
        document.getElementById('post_code').value = item.post_code;
        document.getElementById('cancelEdit').style.display = '';
        document.getElementById('poForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
}

function resetForm() {
    document.getElementById('poForm').reset();
    document.getElementById('id').value = '';
    document.getElementById('cancelEdit').style.display = 'none';
    document.getElementById('responseMessage').innerHTML = '';
}

function deleteItem(id) {
    Swal.fire({
        title: 'নিশ্চিত?',
        text: 'এই পোস্ট অফিসটি স্থায়ীভাবে মুছে যাবে।',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'হ্যাঁ, মুছুন!',
        cancelButtonText: 'বাতিল'
    }).then(function(result) {
        if (result.isConfirmed) {
            var params = new URLSearchParams({ action: 'delete', id: id });
            fetch('/ajax/post-offices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            }).then(function() {
                loadItems(currentPage);
            });
        }
    });
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

document.addEventListener('DOMContentLoaded', function() {
    // Pagination click
    document.getElementById('pagination').addEventListener('click', function(e) {
        var link = e.target.closest('.page-link');
        if (!link) return;
        e.preventDefault();
        var page = parseInt(link.dataset.page);
        if (page && page !== currentPage) loadItems(page);
    });

    // Search input
    document.getElementById('searchTerm').addEventListener('input', function() {
        searchQuery = this.value.trim();
        loadItems(1);
    });

    // Sort columns
    document.querySelectorAll('#poTable thead th[data-column]').forEach(function(th) {
        th.addEventListener('click', function() {
            var col = this.dataset.column;
            if (currentSort.column === col) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = col;
                currentSort.direction = 'asc';
            }
            loadItems(1);
        });
    });

    // Cancel edit
    document.getElementById('cancelEdit').addEventListener('click', resetForm);

    // Form submit
    document.getElementById('poForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var idVal = document.getElementById('id').value;
        var action = idVal ? 'update' : 'create';
        var formData = new URLSearchParams(new FormData(this)).toString() + '&action=' + action;
        var btn = this.querySelector('button[type="submit"]');
        var restore = btnLoading(btn, 'সংরক্ষণ করা হচ্ছে...');
        var msgEl = document.getElementById('responseMessage');

        fetch('/ajax/post-offices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            var msgClass = res.status === 'success' ? 'alert-success' : 'alert-danger';
            msgEl.innerHTML = '<div class="alert ' + msgClass + ' alert-dismissible fade show" role="alert">' +
                res.message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
            if (res.status === 'success') {
                resetForm();
                loadItems(currentPage);
            }
            restore();
        })
        .catch(function() {
            msgEl.innerHTML = '<div class="alert alert-danger alert-dismissible fade show" role="alert">সার্ভার ত্রুটি। আবার চেষ্টা করুন।</div>';
            restore();
        });
    });

    // Edit/Delete buttons (event delegation)
    document.addEventListener('click', function(e) {
        var editBtn = e.target.closest('.edit-po-btn');
        if (editBtn) { editItem(editBtn.dataset.poId); return; }
        var delBtn = e.target.closest('.delete-po-btn');
        if (delBtn) { deleteItem(delBtn.dataset.poId); return; }
    });

    // Initial load
    loadItems(1);
});
</script>
{% endblock %}
