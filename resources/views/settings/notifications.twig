{% extends "layout.twig" %}

{% block title %}{{ header_title }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}
<div class="container mt-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ header_title }}</h2>
        <span class="badge bg-warning text-dark" style="font-size: 0.7rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="নোটিফিকেশন সেটিংস শুধুমাত্র অ্যাডমিনরা পরিবর্তন করতে পারবেন। ইমেইল, SMS এবং পুশ নোটিফিকেশন চ্যানেল সকল ব্যবহারকারীকে প্রভাবিত করে।">
            <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু
        </span>
    </div>

    <form id="notificationSettingsForm" method="POST" action="/settings/notifications" class="mt-4">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="mb-3 form-check">
            <input
                type="checkbox"
                class="form-check-input"
                id="email_notifications_enabled"
                name="settings[email_notifications_enabled]"
                value="1"
                {% if notification_settings.email_notifications_enabled == '1' %}checked{% endif %}
            >
            <label class="form-check-label" for="email_notifications_enabled">Enable Email Notifications</label>
        </div>

        <div class="mb-3 form-check">
            <input
                type="checkbox"
                class="form-check-input"
                id="sms_notifications_enabled"
                name="settings[sms_notifications_enabled]"
                value="1"
                {% if notification_settings.sms_notifications_enabled == '1' %}checked{% endif %}
            >
            <label class="form-check-label" for="sms_notifications_enabled">Enable SMS Notifications</label>
        </div>

        <div class="mb-3 form-check">
            <input
                type="checkbox"
                class="form-check-input"
                id="push_notifications_enabled"
                name="settings[push_notifications_enabled]"
                value="1"
                {% if notification_settings.push_notifications_enabled == '1' %}checked{% endif %}
            >
            <label class="form-check-label" for="push_notifications_enabled">Enable Push Notifications</label>
        </div>

        <button type="submit" class="btn btn-primary">Save Notification Settings</button>
    </form>

    <div id="notificationAlert" class="alert mt-3 d-none" role="alert"></div>
</div>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('notificationSettingsForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            var btn = form.querySelector('button[type="submit"]');
            var url = form.getAttribute('action');
            var data = new URLSearchParams(new FormData(form)).toString();
            var restore = btnLoading(btn, 'সংরক্ষণ করা হচ্ছে...');
            var alertEl = document.getElementById('notificationAlert');

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: data
            })
            .then(function(r) { return r.json(); })
            .then(function(response) {
                alertEl.classList.remove('d-none', 'alert-danger', 'alert-success');
                if (response.status === 'success') {
                    alertEl.classList.add('alert-success');
                } else {
                    alertEl.classList.add('alert-danger');
                }
                alertEl.textContent = response.message;
                restore();
            })
            .catch(function() {
                alertEl.classList.remove('d-none', 'alert-success');
                alertEl.classList.add('alert-danger');
                alertEl.textContent = 'Something went wrong. Please try again.';
                restore();
            });
        });
    }

    // Initialize admin-only tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            new bootstrap.Tooltip(el, { trigger: 'hover focus', boundary: 'clippingParents' });
        }
    });
});
</script>
{% endblock %}
{% endblock %}
