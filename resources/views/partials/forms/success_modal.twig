{# partials/forms/success_modal.twig #}

<!-- ================= Success Modal ================= -->
<div id="successModal" class="custom-modal fade" tabindex="-1">
    <div class="custom-modal-dialog">
        <div class="custom-modal-content shadow-lg rounded-3 p-4">
            <div class="custom-modal-header d-flex align-items-center border-bottom pb-3 mb-3">
                <i class="fa fa-check-circle text-success fs-2 me-2"></i>
                <h5 class="modal-title m-0">{{ certificate_type_bn ? (certificate_type_bn ~ ' - ') : '' }}আবেদন সফল!</h5>
                <button type="button" class="btn-close ms-auto btn-close-modal" aria-label="Close"></button>
            </div>
            <div class="custom-modal-body mb-3">
                <p class="mb-2">আপনার আবেদনটি সফলভাবে সাবমিট হয়েছে।</p>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><b>আপনার ট্র্যাকিং নম্বর:</b> <span id="application_id"></span></li>
                    <li class="list-group-item"><b>ইউনিয়ন কোড:</b> <span id="union_code"></span></li>
                    <li class="list-group-item"><b>RMO কোড:</b> <span id="rmo_code"></span></li>
                </ul>
            </div>
            <div class="custom-modal-footer d-flex justify-content-end gap-2 flex-wrap">
                <a href="#" id="approveApplication" class="btn btn-warning btn-sm" style="display:none;"><i class="fa fa-check-circle me-1"></i> অনুমোদন দিন</a>
                <button class="btn btn-success btn-sm" id="downloadCopy"><i class="fa fa-download me-1"></i> আবেদন কপি ডাউনলোড</button>
                <button class="btn btn-primary btn-sm" id="newApplication"><i class="fa fa-plus me-1"></i> নতুন আবেদন করুন</button>
            </div>
        </div>
    </div>
</div>

<!-- ================= Update Modal ================= -->
<div id="updateModal" class="custom-modal fade" tabindex="-1">
    <div class="custom-modal-dialog">
        <div class="custom-modal-content shadow-lg rounded-3 p-4">
            <div class="custom-modal-header d-flex align-items-center border-bottom pb-3 mb-3">
                <i class="fa fa-check-circle text-info fs-2 me-2"></i>
                <h5 class="modal-title m-0">{{ certificate_type_bn ? (certificate_type_bn ~ ' - ') : '' }}আবেদন আপডেট সফল!</h5>
                <button type="button" class="btn-close ms-auto btn-close-modal" aria-label="Close"></button>
            </div>
            <div class="custom-modal-body mb-3">
                <p class="mb-2">আপনার আবেদনটি সফলভাবে আপডেট হয়েছে।</p>
                <ul id="updateChangeList" class="list-group list-group-flush mb-3"></ul>
                <div id="updateLinks" class="d-flex gap-2 flex-wrap">
                    <a href="#" id="downloadCertificate" class="btn btn-info btn-sm" data-preview="" data-preview-title="সার্টিফিকেট"><i class="fa fa-download me-1"></i> সার্টিফিকেট ডাউনলোড করুন</a>
                    <a href="/applications/{{ certificate_type|default('application') }}" class="btn btn-secondary btn-sm"><i class="fa fa-list me-1"></i> সকল আবেদন দেখুন</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ===== Modern Modal Styling ===== */
.custom-modal {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1050;
    opacity: 0;          /* default hidden */
    pointer-events: none; /* prevent clicks when hidden */
    transition: opacity 0.3s ease;
}

.custom-modal.show {
    opacity: 1;
    pointer-events: auto;
}


.custom-modal-dialog {
    max-width: 500px;
    width: 90%;
}

.btn-close-modal {
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    transition: transform 0.2s;
    opacity: 0.7;
}
.btn-close-modal:hover {
    transform: rotate(90deg);
    opacity: 1;
}

.list-group-item {
    border: none;
    padding: 0.25rem 0;
}

/* ===== Validation Error Styling ===== */
.is-required-empty {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    background-color: #fff5f5 !important;
}
.is-required-empty:focus {
    box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.4) !important;
}
select.is-required-empty {
    background-color: #fff5f5 !important;
}
.validation-error-text {
    color: #dc3545;
    font-size: 0.85em;
    margin-top: 4px;
    display: none;
}
.validation-error-text.show {
    display: block;
}
</style>


<!-- ================= JS Handling ================= -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('applicationForm');
    if (!form) return;
    var submitButton = form.querySelector("button[type='submit']");
    var certificateType = "{{ certificate_type|default('application') }}";
    var isLoggedIn = {{ is_logged_in ? 'true' : 'false' }};

    function clearFieldErrors() {
        form.querySelectorAll('.is-required-empty').forEach(function(el) {
            el.classList.remove('is-required-empty');
        });
        form.querySelectorAll('.validation-error-text.show').forEach(function(el) {
            el.classList.remove('show');
        });
    }

    function validateRequiredFields() {
        clearFieldErrors();
        var firstInvalid = null;
        form.querySelectorAll('[required]').forEach(function(el) {
            var val = el.value;
            var fieldName = el.name;
            if (el.offsetParent === null || el.disabled) return;

            if (certificateType === 'warish' && fieldName === 'birth_date') {
                var deathYear = document.querySelector('input[name="death_year"]');
                var deathYearVal = deathYear ? deathYear.value : '';
                if (deathYearVal && String(deathYearVal).trim() !== '') return;
                var isEmpty = val === null || val === undefined || String(val).trim() === '';
                if (isEmpty) {
                    el.classList.add('is-required-empty');
                    var error = el.nextElementSibling;
                    if (!error || !error.classList.contains('validation-error-text')) {
                        error = document.createElement('small');
                        error.className = 'validation-error-text';
                        error.textContent = '\u099C\u09A8\u09CD\u09AE\u09A4\u09BE\u09B0\u09BF\u0996 \u0985\u09A5\u09AC\u09BE \u09AE\u09C3\u09A4\u09CD\u09AF\u09C1\u09B8\u09BE\u09B2 \u09AF\u09C7\u0995\u09CB\u09A8\u09CB \u098F\u0995\u099F\u09BF \u09A6\u09BF\u09A8';
                        el.parentNode.insertBefore(error, el.nextSibling);
                    }
                    error.classList.add('show');
                    if (!firstInvalid) firstInvalid = el;
                }
                return;
            }

            var isEmpty = val === null || val === undefined || String(val).trim() === '';
            if (isEmpty) {
                el.classList.add('is-required-empty');
                var error2 = el.nextElementSibling;
                if (!error2 || !error2.classList.contains('validation-error-text')) {
                    error2 = document.createElement('small');
                    error2.className = 'validation-error-text';
                    error2.textContent = '\u098F\u0987 \u09AB\u09BF\u09B2\u09CD\u09A1\u099F\u09BF \u09AA\u09C2\u09B0\u09A3 \u0995\u09B0\u09C1\u09A8';
                    el.parentNode.insertBefore(error2, el.nextSibling);
                }
                error2.classList.add('show');
                if (!firstInvalid) firstInvalid = el;
            }
        });
        return firstInvalid;
    }

    form.addEventListener('input', function(e) {
        if (e.target.matches('[required]')) {
            e.target.classList.remove('is-required-empty');
            var next = e.target.nextElementSibling;
            if (next && next.classList.contains('validation-error-text')) next.classList.remove('show');
        }
    }, true);
    form.addEventListener('change', function(e) {
        if (e.target.matches('[required]')) {
            e.target.classList.remove('is-required-empty');
            var next = e.target.nextElementSibling;
            if (next && next.classList.contains('validation-error-text')) next.classList.remove('show');
        }
    }, true);

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        var firstInvalid = validateRequiredFields();
        if (firstInvalid) {
            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstInvalid.focus();
            return;
        }

        var appIdInput = form.querySelector("input[name='application_id']");
        var isUpdate = Boolean(appIdInput && appIdInput.value);
        var url = form.action;
        var restoreBtn = submitButton ? btnLoading(submitButton, '\u099C\u09AE\u09BE \u09A6\u09C7\u0993\u09AF\u09BC\u09BE \u09B9\u099A\u09CD\u099B\u09C7...') : function(){};

        fetch(url, { method: 'POST', body: new FormData(form) })
        .then(function(resp) { return resp.json(); })
        .then(function (response) {
            if (response.status === "success") {
                if (isUpdate) {
                    var updateChangeList = document.getElementById('updateChangeList');
                    var changes = Array.isArray(response.changes) ? response.changes : [];
                    if (changes.length > 0) {
                        updateChangeList.innerHTML = changes.map(function(item) { return '<li>' + item + '</li>'; }).join('');
                        updateChangeList.style.display = '';
                    } else {
                        updateChangeList.style.display = 'none';
                    }
                    var certLink = document.getElementById('downloadCertificate');
                    var existingSonod = response.sonod_number || (document.getElementById('sonod_number') ? document.getElementById('sonod_number').value : '');
                    if (isLoggedIn && existingSonod) {
                        certLink.setAttribute('data-preview', '/application/' + certificateType + '/bangla/' + existingSonod);
                        certLink.textContent = '\u09B8\u09BE\u09B0\u09CD\u099F\u09BF\u09AB\u09BF\u0995\u09C7\u099F \u09A1\u09BE\u0989\u09A8\u09B2\u09CB\u09A1 \u0995\u09B0\u09C1\u09A8';
                        certLink.style.display = '';
                    } else if (response.sonod_number) {
                        certLink.setAttribute('data-preview', '/application/' + certificateType + '/bangla/' + response.sonod_number);
                        certLink.textContent = '\u09B8\u09BE\u09B0\u09CD\u099F\u09BF\u09AB\u09BF\u0995\u09C7\u099F \u09A1\u09BE\u0989\u09A8\u09B2\u09CB\u09A1 \u0995\u09B0\u09C1\u09A8';
                        certLink.style.display = '';
                    } else if (response.application_id) {
                        certLink.href = '/applications/' + certificateType + '/approve/' + response.application_id;
                        certLink.textContent = '\u0985\u09A8\u09C1\u09AE\u09CB\u09A6\u09A8 \u09A6\u09BF\u09A8 / \u09A6\u09C7\u0996\u09C1\u09A8';
                        certLink.style.display = '';
                    } else {
                        certLink.style.display = 'none';
                    }
                    document.getElementById('updateModal').classList.add('show');
                    if (response.upload_warning) {
                        Swal.fire({ icon: 'warning', title: '\u099B\u09AC\u09BF \u0986\u09AA\u09B2\u09CB\u09A1 \u09B8\u09A4\u09B0্\u0995\u09A4\u09BE', text: response.upload_warning, timer: 6000, timerProgressBar: true, showConfirmButton: true, confirmButtonText: '\u09A0\u09BF\u0995 \u0986\u099B\u09C7' });
                    }
                } else {
                    document.getElementById('application_id').textContent = response.application_id || 'N/A';
                    document.getElementById('union_code').textContent = response.union_code || 'N/A';
                    document.getElementById('rmo_code').textContent = response.rmo_code || 'N/A';
                    var approveBtn = document.getElementById('approveApplication');
                    if (isLoggedIn && response.application_id) {
                        approveBtn.href = '/applications/' + certificateType + '/approve/' + response.application_id;
                        approveBtn.style.display = '';
                    } else {
                        approveBtn.style.display = 'none';
                    }
                    document.getElementById('successModal').classList.add('show');
                    if (response.upload_warning) {
                        Swal.fire({ icon: 'warning', title: '\u099B\u09AC\u09BF \u0986\u09AA\u09B2\u09CB\u09A1 \u09B8\u09A4\u09B0\u09CD\u0995\u09A4\u09BE', text: response.upload_warning, timer: 6000, timerProgressBar: true, confirmButtonText: '\u09A0\u09BF\u0995 \u0986\u099B\u09C7' });
                    }
                }
            } else {
                Swal.fire('Error', response.message || 'Unknown error', 'error');
            }
        })
        .catch(function (error) {
            var message = "\u26A0\uFE0F \u0995\u09BF\u099B\u09C1 \u09B8\u09AE\u09B8\u09CD\u09AF\u09BE \u09B9\u09AF\u09BC\u09C7\u099B\u09C7, \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964";
            if (error && error.text) {
                error.text().then(function(text) {
                    try { var resp = JSON.parse(text); if (resp.message) message = "\u26A0\uFE0F " + resp.message; } catch(e) {}
                    Swal.fire('Error', message, 'error');
                });
            } else {
                Swal.fire('Error', message, 'error');
            }
        })
        .finally(function() { restoreBtn(); });
    });

    document.getElementById('newApplication').addEventListener('click', function () {
        document.getElementById('successModal').classList.remove('show');
        clearFieldErrors();
        form.reset();
    });

    document.addEventListener('click', function (e) {
        var closeBtn = e.target.closest('.btn-close-modal');
        if (closeBtn) {
            var modal = closeBtn.closest('.custom-modal');
            if (modal) modal.classList.remove('show');
        }
    });

    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('custom-modal') && e.target.classList.contains('show')) {
            e.target.classList.remove('show');
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.custom-modal.show').forEach(function(m) { m.classList.remove('show'); });
        }
    });

    document.getElementById('downloadCopy').addEventListener('click', function () {
        var applicantId = document.getElementById('application_id').textContent.trim() || '0';
        var unionCode = document.getElementById('union_code').textContent.trim() || '0';
        var rmoCode = document.getElementById('rmo_code').textContent.trim() || '0';
        openPreview('/' + certificateType + '_verify/application/' + applicantId, '\u0986\u09AC\u09C7\u09A6\u09A8 \u0995\u09AA\u09BF');
    });
});
</script>
