{% extends "layout.twig" %}

{% block title %}চ্যাট সেটিংস{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0 fw-bold" style="color: #008B8B;">
            <i class="fas fa-comment-dots me-2"></i>চ্যাট উইজেট সেটিংস
        </h5>
    </div>

    <form id="chatSettingsForm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <!-- General Settings -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center justify-content-between" style="border-left: 4px solid #008B8B;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-cog me-2" style="color: #008B8B;"></i>
                    <h6 class="mb-0 fw-semibold">সাধারণ সেটিংস</h6>
                </div>
                {% if is_superadmin or is_admin %}
                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="শুধুমাত্র সুপারঅ্যাডমিন এবং অ্যাডমিন ব্যবহারকারীরা চ্যাট চালু/বন্ধ করতে পারবেন। অন্যান্য ভূমিকার ব্যবহারকারীদের জন্য এই সেটিংস নিরাপদ।">
                    <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু (চ্যাট চালু/বন্ধ)
                </span>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">চ্যাট সক্রিয়</label>
                        {% if is_superadmin or is_admin %}
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" class="form-check-input" id="chat_enabled" name="settings[chat_enabled]" value="1" {% if settings.chat_enabled == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_enabled">উইজেট সক্রিয় করুন</label>
                        </div>
                        {% else %}
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" class="form-check-input" id="chat_enabled" disabled {% if settings.chat_enabled == '1' %}checked{% endif %}>
                            <label class="form-check-label text-muted" for="chat_enabled">
                                {% if settings.chat_enabled == '1' %}সক্রিয়{% else %}নিষ্ক্রিয়{% endif %}
                                <br><small>শুধুমাত্র অ্যাডমিন পরিবর্তন করতে পারবেন</small>
                            </label>
                        </div>
                        {% endif %}
                    </div>
                    <div class="col-md-4">
                        <label for="chat_primary_color" class="form-label fw-medium">প্রাথমিক রঙ</label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color" id="chat_primary_color" name="settings[chat_primary_color]" value="{{ settings.chat_primary_color ?: '#008B8B' }}" style="max-width: 60px;">
                            <input type="text" class="form-control" id="chat_primary_color_text" value="{{ settings.chat_primary_color ?: '#008B8B' }}" readonly>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="chat_agent_name" class="form-label fw-medium">এজেন্টের নাম</label>
                        <input type="text" class="form-control" id="chat_agent_name" name="settings[chat_agent_name]" value="{{ settings.chat_agent_name ?: 'সহায়ক' }}" maxlength="50">
                        <small class="text-muted">ভিজিটরদের কাছে প্রদর্শিত এজেন্টের নাম</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center" style="border-left: 4px solid #008B8B;">
                <i class="fas fa-header me-2" style="color: #008B8B;"></i>
                <h6 class="mb-0 fw-semibold">উইজেট হেডার</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="chat_title" class="form-label fw-medium">শিরোনাম</label>
                        <input type="text" class="form-control" id="chat_title" name="settings[chat_title]" value="{{ settings.chat_title ?: 'লাইভ চ্যাট সহায়তা' }}" maxlength="100">
                    </div>
                    <div class="col-md-6">
                        <label for="chat_subtitle" class="form-label fw-medium">উপশিরোনাম</label>
                        <input type="text" class="form-control" id="chat_subtitle" name="settings[chat_subtitle]" value="{{ settings.chat_subtitle ?: 'স্মার্ট ইউনিয়ন পরিষদ' }}" maxlength="100">
                    </div>
                </div>
            </div>
        </div>

        <!-- Welcome Message -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center" style="border-left: 4px solid #008B8B;">
                <i class="fas fa-hand-peace me-2" style="color: #008B8B;"></i>
                <h6 class="mb-0 fw-semibold">স্বাগতম বার্তা</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="chat_welcome_title" class="form-label fw-medium">স্বাগতম শিরোনাম</label>
                        <input type="text" class="form-control" id="chat_welcome_title" name="settings[chat_welcome_title]" value="{{ settings.chat_welcome_title ?: 'সাহায্য প্রয়োজন?' }}" maxlength="100">
                    </div>
                    <div class="col-md-6">
                        <label for="chat_welcome_message" class="form-label fw-medium">স্বাগতম বার্তা</label>
                        <input type="text" class="form-control" id="chat_welcome_message" name="settings[chat_welcome_message]" value="{{ settings.chat_welcome_message ?: 'আপনার প্রশ্ন লিখুন, আমরা সহায়তা করব।' }}" maxlength="200">
                    </div>
                </div>
            </div>
        </div>

        <!-- Input Placeholders -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center" style="border-left: 4px solid #008B8B;">
                <i class="fas fa-keyboard me-2" style="color: #008B8B;"></i>
                <h6 class="mb-0 fw-semibold">ইনপুট ফিল্ড</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="chat_placeholder" class="form-label fw-medium">বার্তা ইনপুট প্লেসহোল্ডার</label>
                        <input type="text" class="form-control" id="chat_placeholder" name="settings[chat_placeholder]" value="{{ settings.chat_placeholder ?: 'বার্তা লিখুন...' }}" maxlength="100">
                    </div>
                    <div class="col-md-6">
                        <label for="chat_name_placeholder" class="form-label fw-medium">নাম ইনপুট প্লেসহোল্ডার</label>
                        <input type="text" class="form-control" id="chat_name_placeholder" name="settings[chat_name_placeholder]" value="{{ settings.chat_name_placeholder ?: 'আপনার নাম (ঐচ্ছিক)' }}" maxlength="100">
                    </div>
                </div>
            </div>
        </div>

        <!-- Notification Settings -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center" style="border-left: 4px solid #008B8B;">
                <i class="fas fa-bell me-2" style="color: #008B8B;"></i>
                <h6 class="mb-0 fw-semibold">বিজ্ঞপ্তি সেটিংস</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- Visitor notification sound -->
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" class="form-check-input" id="chat_sound_enabled" name="settings[chat_sound_enabled]" value="1" {% if settings.chat_sound_enabled == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_sound_enabled">
                                <strong>ভিজিটর সাউন্ড</strong>
                                <br>
                                <small class="text-muted">ভিজিটরদের জন্য নতুন বার্তার সাউন্ড</small>
                            </label>
                        </div>
                    </div>

                    <!-- Admin notification toggles -->
                    <div class="col-12">
                        <hr class="my-2">
                        <p class="fw-medium mb-2" style="color: #555;">
                            <i class="fas fa-user-shield me-1"></i>এডমিন নোটিফিকেশন প্রেফারেন্স
                        </p>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-1">
                            <input type="checkbox" class="form-check-input" id="chat_admin_notify_sound" name="settings[chat_admin_notify_sound]" value="1" {% if settings.chat_admin_notify_sound == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_admin_notify_sound">
                                <strong>সাউন্ড নোটিফিকেশন</strong>
                                <br>
                                <small class="text-muted">নতুন ভিজিটর বার্তা এলে সাউন্ড বাজান</small>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-1">
                            <input type="checkbox" class="form-check-input" id="chat_admin_notify_desktop" name="settings[chat_admin_notify_desktop]" value="1" {% if settings.chat_admin_notify_desktop == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_admin_notify_desktop">
                                <strong>ডেস্কটপ নোটিফিকেশন</strong>
                                <br>
                                <small class="text-muted">ট্যাব হিডেন থাকলে ব্রাউজার নোটিফিকেশন দেখান</small>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-1">
                            <input type="checkbox" class="form-check-input" id="chat_admin_notify_toast" name="settings[chat_admin_notify_toast]" value="1" {% if settings.chat_admin_notify_toast == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_admin_notify_toast">
                                <strong>টোস্ট নোটিফিকেশন</strong>
                                <br>
                                <small class="text-muted">পৃষ্ঠায় পপ-আপ টোস্ট বার্তা দেখান</small>
                            </label>
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="alert alert-info py-2 px-3 mb-0" role="alert" style="font-size: 13px;">
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>নোট:</strong> এই সেটিংস শুধুমাত্র এডমিনদের জন্য প্রযোজ্য। ভিজিটরদের সাউন্ড সেটিং উপরে আলাদাভাবে নিয়ন্ত্রণ করা যায়।
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visitor Push Notifications (Web Push) — Admin/Superadmin only -->
        {% if is_superadmin or is_admin %}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center justify-content-between" style="border-left: 4px solid #008B8B;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-bell me-2" style="color: #008B8B;"></i>
                    <h6 class="mb-0 fw-semibold">ভিজিটর পুশ নোটিফিকেশন (Web Push)</h6>
                </div>
                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="পুশ নোটিফিকেশন কনফিগারেশন শুধুমাত্র অ্যাডমিনরা পরিবর্তন করতে পারবেন। ভুল কনফিগারেশন ভিজিটরদের অবাঞ্ছিত বিজ্ঞপ্তি পাঠাতে পারে।">
                    <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" class="form-check-input" id="chat_visitor_push_enabled" name="settings[chat_visitor_push_enabled]" value="1" {% if settings.chat_visitor_push_enabled == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_visitor_push_enabled">
                                <strong>ভিজিটর পুশ সক্রিয়</strong>
                                <br>
                                <small class="text-muted">এডমিন উত্তর দিলে ব্রাউজার নোটিফিকেশন পাঠান — ট্যাব বন্ধ থাকলেও</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label for="chat_push_subject" class="form-label fw-medium">VAPID Subject</label>
                        <input type="text" class="form-control" id="chat_push_subject" name="settings[chat_push_subject]" value="{{ settings.chat_push_subject ?: '' }}" maxlength="200" placeholder="mailto:no-reply@example.com">
                        <small class="text-muted">সাধারণত mailto: ঠিকানা বা আপনার সাইটের URL।</small>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info py-2 px-3 mb-0" role="alert" style="font-size: 13px;">
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>HTTPS প্রয়োজন:</strong> ব্রাউজার পুশ নোটিফিকেশন শুধুমাত্র HTTPS (বা localhost) সাইটে কাজ করে।
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="chat_push_vapid_public_key" class="form-label fw-medium">VAPID Public Key</label>
                        <input type="text" class="form-control font-monospace" id="chat_push_vapid_public_key" name="settings[chat_push_vapid_public_key]" value="{{ settings.chat_push_vapid_public_key ?: '' }}" maxlength="200" placeholder="বিকল্প: নিজের কী পেস্ট করুন">
                    </div>
                    <div class="col-md-6">
                        <label for="chat_push_vapid_private_key" class="form-label fw-medium">VAPID Private Key</label>
                        <input type="password" class="form-control font-monospace" id="chat_push_vapid_private_key" name="settings[chat_push_vapid_private_key]" value="" maxlength="200" placeholder="শুধু নতুন কী সেট করতে পূরণ করুন">
                        {% if settings.chat_push_vapid_private_key %}
                        <small class="text-muted"><i class="fas fa-check-circle" style="color: #198754;"></i> একটি কী ইতিমধ্যে সংরক্ষিত আছে — খালি রাখলে অপরিবর্তিত থাকবে।</small>
                        {% else %}
                        <small class="text-muted">খালি রাখলে বিদ্যমান কী অপরিবর্তিত থাকবে।</small>
                        {% endif %}
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="vapidGenerateBtn">
                            <i class="fas fa-key me-1"></i>স্বয়ংক্রিয় VAPID কী তৈরি করুন
                        </button>
                        <span id="vapidStatus" class="ms-2 small text-muted"></span>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Offline Hours -->
        {% if is_superadmin or is_admin %}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center justify-content-between" style="border-left: 4px solid #008B8B;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-clock me-2" style="color: #008B8B;"></i>
                    <h6 class="mb-0 fw-semibold">অফলাইন সময়</h6>
                </div>
                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="অফলাইন সময় সেটিংস শুধুমাত্র অ্যাডমিনরা পরিবর্তন করতে পারবেন। এটি সকল ভিজিটরদের চ্যাট অ্যাক্সেস প্রভাবিত করে।">
                    <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" class="form-check-input" id="chat_offline_enabled" name="settings[chat_offline_enabled]" value="1" {% if settings.chat_offline_enabled == '1' %}checked{% endif %}>
                            <label class="form-check-label" for="chat_offline_enabled">অফলাইন সময় সক্রিয় করুন</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label for="chat_offline_start" class="form-label fw-medium">শুরুর সময়</label>
                        <input type="time" class="form-control" id="chat_offline_start" name="settings[chat_offline_start]" value="{{ settings.chat_offline_start ?: '17:00' }}">
                    </div>
                    <div class="col-md-3">
                        <label for="chat_offline_end" class="form-label fw-medium">শেষের সময়</label>
                        <input type="time" class="form-control" id="chat_offline_end" name="settings[chat_offline_end]" value="{{ settings.chat_offline_end ?: '09:00' }}">
                    </div>
                    <div class="col-md-12">
                        <label for="chat_offline_message" class="form-label fw-medium">অফলাইন বার্তা</label>
                        <textarea class="form-control" id="chat_offline_message" name="settings[chat_offline_message]" rows="2" maxlength="300">{{ settings.chat_offline_message ?: 'আমরা বর্তমানে অফলাইনে আছি। আপনার বার্তা ছেড়ে দিন, আমরা পরে উত্তর দেব।' }}</textarea>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">
                    <i class="fas fa-info-circle me-1"></i>
                    অফলাইন সময়ে ভিজিটররা বার্তা পাঠাতে পারবে কিন্তু উত্তর পাবে না। শুরুর সময় এবং শেষের সময়ের মধ্যে থাকলে অফলাইন মোড সক্রিয় হবে।
                </small>
            </div>
        </div>
        {% endif %}

        <!-- Preview -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center" style="border-left: 4px solid #008B8B;">
                <i class="fas fa-eye me-2" style="color: #008B8B;"></i>
                <h6 class="mb-0 fw-semibold">প্রিভিউ</h6>
            </div>
            <div class="card-body text-center py-4">
                <div style="max-width: 300px; margin: 0 auto; position: relative;">
                    <div style="background: linear-gradient(135deg, var(--preview-color, #008B8B), #007A7A); color: #fff; border-radius: 12px 12px 0 0; padding: 12px 16px; text-align: left; display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-headset" style="font-size: 16px;"></i>
                        </div>
                        <div style="flex: 1;">
                            <div style="font-size: 13px; font-weight: 600;" id="previewTitle">লাইভ চ্যাট সহায়তা</div>
                            <div style="font-size: 11px; opacity: 0.85;" id="previewSubtitle">স্মার্ট ইউনিয়ন পরিষদ</div>
                        </div>
                    </div>
                    <div style="background: #f8f9fa; padding: 20px; border-radius: 0 0 12px 12px; text-align: left;">
                        <div style="font-size: 13px; color: #666;" id="previewWelcome">
                            <div style="font-size: 14px; font-weight: 600; color: #333; margin-bottom: 4px;">সাহায্য প্রয়োজন?</div>
                            আপনার প্রশ্ন লিখুন, আমরা সহায়তা করব।
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <div class="d-flex justify-content-center gap-3 mb-5">
            <button type="submit" class="btn btn-primary px-5" style="background: #008B8B; border-color: #008B8B; border-radius: 8px; padding: 10px 30px;">
                <i class="fas fa-save me-2"></i>সেটিংস সংরক্ষণ করুন
            </button>
        </div>
        <div class="card shadow-sm mb-4" id="chatActiveDevices">
            <div class="card-header bg-white d-flex align-items-center justify-content-between" style="border-left: 4px solid #008B8B;">
                <h6 class="mb-0 fw-semibold"><i class="fas fa-laptop me-2" style="color:#008B8B"></i>Active devices</h6>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" id="enableSettingsPush"><i class="fas fa-bell me-1"></i>Enable Notifications</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="revokeAllChatDevices">সব device revoke</button>
                </div>
            </div>
            <div class="card-body"><div class="small text-muted mb-3">এই user-এর যেসব browser/device-এ chat notification সক্রিয় আছে।</div>
                <div id="chatDeviceList">
                {% for device in devices|default([]) %}
                    <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                        <div><strong>{{ device.device_info.browser|default('Browser')|e }}</strong><div class="small text-muted">{{ device.device_info.platform|default('Unknown device')|e }} · সর্বশেষ সক্রিয় {{ device.updated_at|e }}</div></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary revoke-chat-device" data-device-id="{{ device.id }}">Revoke</button>
                    </div>
                {% else %}<div class="text-muted small">কোনো active device পাওয়া যায়নি।</div>{% endfor %}
                </div>
            </div>
        </div>

        <!-- Push Notification Debug Panel -->
        <div class="card shadow-sm mb-4" id="pushDebugPanel">
            <div class="card-header bg-white d-flex align-items-center justify-content-between" style="border-left: 4px solid #6f42c1;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-bug me-2" style="color: #6f42c1;"></i>
                    <h6 class="mb-0 fw-semibold">পুশ নোটিফিকেশন ডিবাগ</h6>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="refreshDebugBtn">
                    <i class="fas fa-sync-alt"></i> রিফ্রেশ
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3" id="debugStatusGrid">
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center" id="debugPermission">
                            <div class="small text-muted mb-1">Permission Status</div>
                            <div class="fw-bold" id="debugPermissionValue">লোড হচ্ছে...</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center" id="debugSW">
                            <div class="small text-muted mb-1">Service Worker</div>
                            <div class="fw-bold" id="debugSWValue">লোড হচ্ছে...</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center" id="debugFirebase">
                            <div class="small text-muted mb-1">Firebase SDK</div>
                            <div class="fw-bold" id="debugFirebaseValue">লোড হচ্ছে...</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center" id="debugToken">
                            <div class="small text-muted mb-1">FCM Token</div>
                            <div class="fw-bold" id="debugTokenValue">লোড হচ্ছে...</div>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="small text-muted mb-2"><i class="fas fa-info-circle me-1"></i>বিস্তারিত তথ্য:</div>
                    <pre id="debugDetails" style="background: #f8f9fa; padding: 12px; border-radius: 6px; font-size: 12px; max-height: 200px; overflow-y: auto; margin: 0;">লোড হচ্ছে...</pre>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="testNotifBtn">
                        <i class="fas fa-paper-plane me-1"></i>টেস্ট নোটিফিকেশন পাঠান
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="resetPermBtn">
                        <i class="fas fa-undo me-1"></i>পারমিশন রিসেট গাইড
                    </button>
                </div>
            </div>
        </div>
    </form>
    <script>
    (function(){
      var csrf=(window.getCsrfToken?window.getCsrfToken():(document.querySelector('meta[name="csrf_token"]')||{}).content||'');
      function post(url, body){ return fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-TOKEN':csrf,'X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(body||{})}).then(function(r){return r.json();}); }
      document.querySelectorAll('.revoke-chat-device').forEach(function(btn){btn.addEventListener('click',function(){post('/api/chat/devices/revoke',{device_id:btn.dataset.deviceId}).then(function(){btn.closest('.d-flex').remove();});});});
      var all=document.getElementById('revokeAllChatDevices'); if(all) all.addEventListener('click',function(){post('/api/chat/devices/revoke-all').then(function(){var list=document.getElementById('chatDeviceList'); if(list) list.innerHTML='<div class="text-muted small">কোনো active device পাওয়া যায়নি।</div>';});});

      // ================================
      // Push Debug Panel
      // ================================
      function refreshDebugPanel() {
        var details = {};
        // 1. Permission
        var perm = "N/A"; var permColor = "#6c757d";
        if ("Notification" in window) {
          perm = Notification.permission;
          if (perm === "granted") { permColor = "#198754"; }
          else if (perm === "denied") { permColor = "#dc3545"; }
          else { permColor = "#ffc107"; }
        }
        document.getElementById("debugPermissionValue").textContent = perm;
        document.getElementById("debugPermissionValue").style.color = permColor;
        document.getElementById("debugPermission").style.borderColor = permColor;
        details.permission = perm;
        // 2. Service Worker
        var swState = "নেই"; var swColor = "#dc3545";
        if ("serviceWorker" in navigator) {
          if (navigator.serviceWorker.controller) {
            swState = "সক্রিয় (" + navigator.serviceWorker.controller.scope + ")";
            swColor = "#198754";
          } else { swState = "নিষ্ক্রিয়"; swColor = "#ffc107"; }
        }
        document.getElementById("debugSWValue").textContent = swState;
        document.getElementById("debugSWValue").style.color = swColor;
        document.getElementById("debugSW").style.borderColor = swColor;
        details.serviceWorker = swState;
        // 3. Firebase SDK
        var fbState = "লোড হয়নি"; var fbColor = "#dc3545";
        if (typeof firebase !== "undefined" && typeof firebase.messaging === "function") {
          if (firebase.apps && firebase.apps.length > 0) {
            fbState = "সক্রিয় (project: " + firebase.apps[0].options.projectId + ")";
            fbColor = "#198754";
          } else { fbState = "লোড হয়েছে, ইনিশিয়ালাইজ হয়নি"; fbColor = "#ffc107"; }
        }
        document.getElementById("debugFirebaseValue").textContent = fbState;
        document.getElementById("debugFirebaseValue").style.color = fbColor;
        document.getElementById("debugFirebase").style.borderColor = fbColor;
        details.firebase = fbState;
        // 4. FCM Token
        var tokenEl = document.getElementById("debugTokenValue");
        var tokenBox = document.getElementById("debugToken");
        if (perm === "granted" && typeof firebase !== "undefined" && firebase.messaging) {
          try {
            var messaging = firebase.messaging();
            messaging.getToken({ vapidKey: window.__chatVapidKey || "" }).then(function(token) {
              if (token) { tokenEl.textContent = token.substring(0, 20) + "..."; tokenEl.style.color = "#198754"; tokenBox.style.borderColor = "#198754"; }
              else { tokenEl.textContent = "টোকেন নেই"; tokenEl.style.color = "#ffc107"; }
            }).catch(function(err) { tokenEl.textContent = "Error: " + err.message; tokenEl.style.color = "#dc3545"; });
          } catch(e) { tokenEl.textContent = "Error: " + e.message; tokenEl.style.color = "#dc3545"; }
        } else { tokenEl.textContent = "পারমিশন প্রয়োজন"; tokenEl.style.color = "#6c757d"; }
        // 5. Details
        details.isSecureContext = window.isSecureContext;
        details.protocol = window.location.protocol;
        details.platform = navigator.platform;
        document.getElementById("debugDetails").textContent = JSON.stringify(details, null, 2);
      }
      refreshDebugPanel();
      var refreshBtn = document.getElementById("refreshDebugBtn");
      if (refreshBtn) refreshBtn.addEventListener("click", refreshDebugPanel);
      // Test notification
      var testBtn = document.getElementById("testNotifBtn");
      if (testBtn) {
        testBtn.addEventListener("click", async function() {
          testBtn.disabled = true; testBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>পাঠাচ্ছে...';
          try {
            var res = await fetch("/api/chat/admin/push/test", { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-TOKEN": csrf, "X-Requested-With": "XMLHttpRequest" }, body: JSON.stringify({}) });
            var result = await res.json();
            if (typeof Swal !== "undefined") Swal.fire({ icon: result.status === "success" ? "success" : "error", title: result.status === "success" ? "সফল" : "ত্রুটি", text: result.message || "টেস্ট নোটিফিকেশন", timer: 3000, showConfirmButton: false });
          } catch (e) { if (typeof Swal !== "undefined") Swal.fire({ icon: "error", title: "ত্রুটি", text: "সার্ভার ত্রুটি" }); }
          finally { testBtn.disabled = false; testBtn.innerHTML = '<i class="fas fa-paper-plane me-1"></i>টেস্ট নোটিফিকেশন পাঠান'; }
        });
      }
      // Reset permission guide
      var resetBtn = document.getElementById("resetPermBtn");
      if (resetBtn) {
        resetBtn.addEventListener("click", function() {
          if (typeof Swal !== "undefined") Swal.fire({ title: "পারমিশন রিসেট করুন", html: "<div style=text-align:left><p><strong>Chrome:</strong></p><ol><li>chrome://settings/content/notifications</li><li>সাইট খুঁজে Reset permissions</li></ol><p><strong>Firefox:</strong></p><ol><li>about:preferences#privacy</li><li>Notifications → Settings</li><li>সাইট মুছে ফেলুন</li></ol></div>", icon: "info", confirmButtonText: "বুঝেছি" });
        });
      }
    })();
    </script>
</div>
{% endblock %}

{% block scripts %}
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-messaging-compat.js"></script>
<script>
(function() {
    // Initialize Bootstrap tooltips for admin-only badges
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            new bootstrap.Tooltip(el, { trigger: 'hover focus', boundary: 'clippingParents' });
        }
    });

    const form = document.getElementById('chatSettingsForm');

    // Live preview
    function updatePreview() {
        const title = document.getElementById('chat_title').value || 'লাইভ চ্যাট সহায়তা';
        const subtitle = document.getElementById('chat_subtitle').value || 'স্মার্ট ইউনিয়ন পরিষদ';
        const welcomeTitle = document.getElementById('chat_welcome_title').value || 'সাহায্য প্রয়োজন?';
        const welcomeMsg = document.getElementById('chat_welcome_message').value || 'আপনার প্রশ্ন লিখুন, আমরা সহায়তা করব।';
        const color = document.getElementById('chat_primary_color').value || '#008B8B';

        document.getElementById('previewTitle').textContent = title;
        document.getElementById('previewSubtitle').textContent = subtitle;
        const previewWelcome = document.getElementById('previewWelcome');
        previewWelcome.replaceChildren();
        const previewWelcomeTitle = document.createElement('div');
        previewWelcomeTitle.style.cssText = 'font-size: 14px; font-weight: 600; color: #333; margin-bottom: 4px;';
        previewWelcomeTitle.textContent = welcomeTitle;
        previewWelcome.appendChild(previewWelcomeTitle);
        previewWelcome.appendChild(document.createTextNode(welcomeMsg));
        document.querySelector('[style*="--preview-color"]').style.setProperty('--preview-color', color);
    }

    // Listen to all relevant inputs
    ['chat_title', 'chat_subtitle', 'chat_welcome_title', 'chat_welcome_message', 'chat_primary_color'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', updatePreview);
    });

    // Color picker sync
    const colorPicker = document.getElementById('chat_primary_color');
    const colorText = document.getElementById('chat_primary_color_text');
    if (colorPicker && colorText) {
        colorPicker.addEventListener('input', function() {
            colorText.value = this.value;
            updatePreview();
        });
    }

    // Form submission
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>সংরক্ষণ হচ্ছে...';

        try {
            const formData = new FormData(form);
            const data = {};
            for (const [key, value] of formData.entries()) {
                if (key === 'csrf_token') continue;
                const match = key.match(/^settings\[(.+)\]$/);
                if (match) {
                    data[match[1]] = value;
                }
            }

            // Unchecked checkboxes never reach FormData, and the server
            // defaults missing toggles to ENABLED — so explicitly submit '0'
            // for every unchecked toggle or the admin could never switch one off.
            form.querySelectorAll('input[type="checkbox"][name^="settings["]').forEach(function(cb) {
                const match = cb.name.match(/^settings\[(.+)\]$/);
                if (match && !(match[1] in data)) {
                    data[match[1]] = '0';
                }
            });

            const res = await fetch('/api/chat/settings/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ settings: data, csrf_token: formData.get('csrf_token') })
            });
            const result = await res.json();

            if (result.status === 'success') {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'সফল',
                        text: result.message || 'সেটিংস সংরক্ষণ করা হয়েছে',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'ত্রুটি',
                        text: result.message || 'সংরক্ষণ ব্যর্থ হয়েছে'
                    });
                }
            }
        } catch (e) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'ত্রুটি',
                    text: 'সার্ভার ত্রুটি'
                });
            }
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-2"></i>সেটিংস সংরক্ষণ করুন';
        }
    });

    // Initial preview
    updatePreview();

    // ================================
    // VAPID key auto-generation
    // ================================
    const vapidBtn = document.getElementById('vapidGenerateBtn');
    const vapidStatus = document.getElementById('vapidStatus');
    if (vapidBtn) {
        vapidBtn.addEventListener('click', async function() {
            vapidBtn.disabled = true;
            vapidStatus.textContent = 'কী তৈরি হচ্ছে...';
            try {
                const res = await fetch('/api/chat/settings/vapid', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'generate', csrf_token: getCsrfToken ? getCsrfToken() : '' })
                });
                const result = await res.json();
                if (result.status === 'success' && result.data) {
                    const pubEl = document.getElementById('chat_push_vapid_public_key');
                    if (pubEl && result.data.public_key) pubEl.value = result.data.public_key;
                    vapidStatus.textContent = '✓ নতুন VAPID কী তৈরি হয়েছে। সংরক্ষণ করুন।';
                    vapidStatus.style.color = '#198754';
                } else {
                    vapidStatus.textContent = 'কী তৈরি করা যায়নি: ' + (result.message || 'অজানা ত্রুটি');
                    vapidStatus.style.color = '#dc3545';
                }
            } catch (e) {
                vapidStatus.textContent = 'কী তৈরি করতে ব্যর্থ হয়েছে';
                vapidStatus.style.color = '#dc3545';
            } finally {
                vapidBtn.disabled = false;
            }
        });
    }

    // ================================
    // Admin FCM Push Registration (Enable Notifications)
    // ================================
    let _settingsMessaging = null;
    let _settingsFcmToken = null;
    let _settingsFirebaseConfig = null;
    let _settingsVapidKey = '';

    async function loadSettingsFirebaseConfig() {
        try {
            const res = await fetch('/api/chat/push/config');
            const data = await res.json();
            if (data.status === 'success' && data.data.enabled && data.data.config) {
                _settingsFirebaseConfig = data.data.config;
                _settingsVapidKey = data.data.vapid_key || '';
                return true;
            }
        } catch (err) {
            console.error('[Settings] Failed to load Firebase config:', err);
        }
        return false;
    }

    async function initSettingsFirebase() {
        if (_settingsFirebaseConfig && typeof firebase !== 'undefined' && !firebase.apps.length) {
            firebase.initializeApp(_settingsFirebaseConfig);
        }
    }

    async function registerSettingsPush() {
        const btn = document.getElementById('enableSettingsPush');
        if (!btn) return;

        if (!('Notification' in window) || !navigator.serviceWorker) {
            if (typeof Swal !== 'undefined') Swal.fire({ icon: 'warning', title: 'সমর্থিত নয়', text: 'আপনার ব্রাউজার পুশ নোটিফিকেশন সমর্থন করে না।' });
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>লোড হচ্ছে...';

        try {
            // Load Firebase config from server
            if (!_settingsFirebaseConfig) {
                const loaded = await loadSettingsFirebaseConfig();
                if (!loaded) {
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'ত্রুটি', text: 'Firebase কনফিগ লোড করা যায়নি। পুশ নোটিফিকেশন কনফিগার করা হয়নি।' });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
                    return;
                }
            }

            await initSettingsFirebase();

            // Register service worker if not already active
            if (!navigator.serviceWorker.controller) {
                try {
                    await navigator.serviceWorker.register('/firebase-messaging-sw.js', { scope: '/' });
                } catch (swErr) {
                    try {
                        await navigator.serviceWorker.register('/sw.js', { scope: '/' });
                    } catch (swErr2) {
                        console.error('[Settings] Both SW registrations failed:', swErr2);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
                        return;
                    }
                }
            }

            // Only prompt if permission is default
            if (Notification.permission === 'default') {
                const permission = await Notification.requestPermission();
                if (permission !== 'granted') {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
                    return;
                }
            } else if (Notification.permission !== 'granted') {
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'warning', title: 'পারমিশন নেই', text: 'ব্রাউজার সেটিংস থেকে নোটিফিকেশন পারমিশন চালু করুন।' });
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
                return;
            }

            await navigator.serviceWorker.ready;
            if (!_settingsMessaging) _settingsMessaging = firebase.messaging();

            const tokenOptions = {};
            if (_settingsVapidKey) tokenOptions.vapidKey = _settingsVapidKey;
            const token = await _settingsMessaging.getToken(tokenOptions);

            if (token) {
                const csrf = (window.getCsrfToken ? window.getCsrfToken() : '') || (document.querySelector('meta[name="csrf_token"]') || {}).content || '';
                await fetch('/api/chat/push/fcm-admin-subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf, 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ fcm_token: token, device_info: { browser: navigator.userAgent, platform: navigator.platform } })
                });
                _settingsFcmToken = token;
                btn.innerHTML = '<i class="fas fa-check-circle me-1"></i>Push চালু আছে';
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-success');
                if (typeof Swal !== 'undefined') Swal.fire({ icon: 'success', title: 'সফল', text: 'পুশ নোটিফিকেশন চালু হয়েছে!', timer: 2000, showConfirmButton: false });
                // Reload device list
                location.reload();
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
            }
        } catch (err) {
            console.error('[Settings] Push registration error:', err);
            if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'ত্রুটি', text: 'পুশ নোটিফিকেশন চালু করতে ব্যর্থ হয়েছে।' });
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-bell me-1"></i>Enable Notifications';
        }
    }

    // Initialize the Enable Notifications button state
    (function initEnablePushBtn() {
        const btn = document.getElementById('enableSettingsPush');
        if (!btn) return;
        if (!('Notification' in window)) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-ban me-1"></i>সমর্থিত নয়';
            return;
        }
        if (Notification.permission === 'granted') {
            btn.innerHTML = '<i class="fas fa-check-circle me-1"></i>Push চালু আছে';
            btn.classList.remove('btn-success');
            btn.classList.add('btn-outline-success');
        } else if (Notification.permission === 'denied') {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-ban me-1"></i>ব্রাউজারে চালু করুন';
        }
        btn.addEventListener('click', registerSettingsPush);
    })();
})();
</script>
{% endblock %}
