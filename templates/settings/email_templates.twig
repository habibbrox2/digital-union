{% extends "layout.twig" %}

{% block title %}ইমেইল টেমপ্লেট{% endblock %}
{% block header_title %}{{ header_title|default('ইমেইল টেমপ্লেট') }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}

<div class="container-fluid px-0">

    <!-- Stats Banner -->
    <div class="row g-3 mb-4 stats-banner">
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-card-primary">
                <div class="stat-icon"><i class="bi bi-envelope-paper"></i></div>
                <div class="stat-info">
                    <span class="stat-label">মোট টেমপ্লেট</span>
                    <span class="stat-value">৬ টি</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-card-success">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-info">
                    <span class="stat-label">কাস্টমাইজড</span>
                    <span class="stat-value" id="customizedCount">০ টি</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="stat-card stat-card-warning">
                <div class="stat-icon"><i class="bi bi-file-earmark-code"></i></div>
                <div class="stat-info">
                    <span class="stat-label">ডিফল্ট ব্যবহৃত</span>
                    <span class="stat-value" id="defaultCount">৬ টি</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="mb-1 fw-bold" style="color: #1e293b;">
                    <i class="bi bi-envelope-gear me-2 text-primary"></i>ইমেইল টেমপ্লেট সেটিংস
                </h4>
                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="ইমেইল টেমপ্লেট সম্পাদনা শুধুমাত্র অ্যাডমিনরা করতে পারবেন। ভুল সম্পাদনা সকল ব্যবহারকারীদের অটো-জেনারেটেড ইমেইলের মান নষ্ট করতে পারে।">
                    <i class="fas fa-shield-alt me-1"></i>অ্যাডমিন শুধু
                </span>
            </div>
            <p class="text-muted mb-0" style="font-size: 0.85rem;">
                সিস্টেম কর্তৃক ব্যবহৃত ইমেইল বার্তার মূল অংশ সম্পাদনা করুন।
                Twig প্লেসহোল্ডার (যেমন <code>{{ '{{ username }}' }}</code>) ব্যবহার করুন।
            </p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" id="expandAllBtn" type="button">
            <i class="bi bi-arrows-expand me-1"></i> সব খুলুন
        </button>
    </div>

    <form id="emailTemplatesForm" method="post" action="/settings/email-templates">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        {% set templates = {
            'welcome': {
                'title': 'স্বাগতম বার্তা',
                'icon': 'bi-hand-wave',
                'color': 'primary',
                'desc': 'নতুন ব্যবহারকারী রেজিস্ট্রেশনের পর প্রেরিত স্বাগতম ইমেইল।',
                'placeholders': ['username', 'email', 'login_url']
            },
            'email_verification': {
                'title': 'ইমেইল যাচাইকরণ',
                'icon': 'bi-patch-check',
                'color': 'success',
                'desc': 'ব্যবহারকারীর ইমেইল ঠিকানা যাচাই করার জন্য প্রেরিত ভেরিফিকেশন লিংক।',
                'placeholders': ['username', 'verification_url', 'code']
            },
            'password_reset': {
                'title': 'পাসওয়ার্ড রিসেট',
                'icon': 'bi-key',
                'color': 'warning',
                'desc': 'পাসওয়ার্ড রিসেট অনুরোধের পর প্রেরিত রিসেট লিংক ইমেইল।',
                'placeholders': ['username', 'reset_url', 'expires_in']
            },
            'password_changed': {
                'title': 'পাসওয়ার্ড পরিবর্তন',
                'icon': 'bi-shield-lock',
                'color': 'info',
                'desc': 'পাসওয়ার্ড সফলভাবে পরিবর্তন হলে প্রেরিত নোটিফিকেশন ইমেইল।',
                'placeholders': ['username', 'ip_address', 'timestamp']
            },
            'failed_login_alert': {
                'title': 'ব্যর্থ লগইন সতর্কতা',
                'icon': 'bi-exclamation-triangle',
                'color': 'danger',
                'desc': 'ব্যর্থ লগইন প্রচেষ্টার পর প্রেরিত নিরাপত্তা সতর্কতা ইমেইল।',
                'placeholders': ['username', 'ip_address', 'attempt_count', 'timestamp']
            },
            'new_device_login': {
                'title': 'নতুন ডিভাইস লগইন',
                'icon': 'bi-phone',
                'color': 'secondary',
                'desc': 'নতুন ডিভাইস বা ব্রাউজার থেকে লগইনের পর প্রেরিত নিরাপত্তা নোটিফিকেশন।',
                'placeholders': ['username', 'device_info', 'ip_address', 'location']
            }
        } %}

        <div class="template-list">
            {% for key, tpl in templates %}
                {% set currentValue = system_settings['email_template_' ~ key] | default('') %}
                <div class="section-card mb-3 template-card" id="card-{{ key }}">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="template-icon bg-{{ tpl.color }} bg-opacity-10 text-{{ tpl.color }}">
                                <i class="bi {{ tpl.icon }}"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold" style="color: #1e293b;">{{ tpl.title }}</h6>
                                <small class="text-muted">{{ tpl.desc }}</small>
                            </div>
                            {% if currentValue %}
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill" style="font-size: 0.7rem;">
                                    <i class="bi bi-check-circle me-1"></i>কাস্টম
                                </span>
                            {% else %}
                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill" style="font-size: 0.7rem;">
                                    <i class="bi bi-file-earmark me-1"></i>ডিফল্ট
                                </span>
                            {% endif %}
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-{{ tpl.color }} rounded-pill px-3 preview-btn" data-template="{{ key }}">
                                <i class="bi bi-eye me-1"></i>প্রিভিউ
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle toggle-card-btn" style="width:32px;height:32px;" title="খুলুন/বন্ধ করুন">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>

                    <div class="template-body" style="display: none;">
                        {% if tpl.placeholders %}
                        <div class="mb-2 d-flex flex-wrap gap-1">
                            <small class="text-muted me-1">প্লেসহোল্ডার:</small>
                            {% for ph in tpl.placeholders %}
                                <code class="placeholder-tag" title="কপি করতে ক্লিক করুন" data-ph="{{ '{{ ' ~ ph ~ ' }}' }}">{{ '{{ ' ~ ph ~ ' }}' }}</code>
                            {% endfor %}
                        </div>
                        {% endif %}
                        <textarea
                            name="templates[{{ key }}]"
                            class="form-control template-textarea"
                            rows="10"
                            placeholder="এখানে টেমপ্লেট লিখুন... খালি রাখলে templates/emails/{{ key }}.twig ফাইলটি ব্যবহৃত হবে।"
                            spellcheck="false"
                        >{{ currentValue }}</textarea>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Sticky Save Bar -->
        <div class="save-bar mt-4 mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small" id="changeIndicator"></span>
                <button class="btn btn-primary rounded-pill px-5 shadow-sm" type="submit" id="saveBtn">
                    <i class="bi bi-floppy me-1"></i> সংরক্ষণ করুন
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="emailPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="emailPreviewTitle">প্রিভিউ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="emailPreviewBody" style="min-height:200px; background: #f8f9fa;">
            </div>
        </div>
    </div>
</div>

<style>
/* ─── Stats Banner ─── */
.stats-banner .stat-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}
.stats-banner .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    opacity: 0.3;
}
.stats-banner .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
}
.stats-banner .stat-card:hover::before { opacity: 1; }
.stat-card-primary::before { background: linear-gradient(90deg, #0D6EFD, #5B9CFF); }
.stat-card-success::before { background: linear-gradient(90deg, #28A745, #5DD475); }
.stat-card-warning::before { background: linear-gradient(90deg, #FFC107, #FFD54F); }
.stat-icon {
    width: 48px; height: 48px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0; transition: all 0.3s ease;
}
.stat-card-primary .stat-icon { background: rgba(13,110,253,0.1); color: #0D6EFD; }
.stat-card-success .stat-icon { background: rgba(40,167,69,0.1); color: #28A745; }
.stat-card-warning .stat-icon { background: rgba(255,193,7,0.1); color: #e6a800; }
.stat-card:hover .stat-icon { transform: scale(1.1) rotate(-5deg); }
.stat-info { display: flex; flex-direction: column; }
.stat-label { font-size: 0.78rem; color: #6c757d; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
.stat-value { font-size: 1.05rem; font-weight: 700; color: #1e293b; }

/* ─── Template Cards ─── */
.template-card {
    animation: slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    opacity: 0;
    transform: translateY(8px);
}
.template-card:nth-child(1) { animation-delay: 0ms; }
.template-card:nth-child(2) { animation-delay: 50ms; }
.template-card:nth-child(3) { animation-delay: 100ms; }
.template-card:nth-child(4) { animation-delay: 150ms; }
.template-card:nth-child(5) { animation-delay: 200ms; }
.template-card:nth-child(6) { animation-delay: 250ms; }
@keyframes slideIn {
    to { opacity: 1; transform: translateY(0); }
}
.template-icon {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
}
.toggle-card-btn {
    transition: all 0.3s ease;
}
.toggle-card-btn.open i {
    transform: rotate(180deg);
}
.template-body {
    animation: expandBody 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes expandBody {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ─── Textarea ─── */
.template-textarea {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    border: 2px solid #e9ecef;
    border-radius: 12px;
    padding: 14px 16px;
    background: #fafbfc;
    transition: all 0.25s ease;
    resize: vertical;
}
.template-textarea:focus {
    border-color: #0D6EFD;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(13,110,253,0.1);
}

/* ─── Placeholder Tags ─── */
.placeholder-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    background: #e8f4fd;
    color: #0D6EFD;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}
.placeholder-tag:hover {
    background: #0D6EFD;
    color: #fff;
    transform: translateY(-1px);
}

/* ─── Save Bar ─── */
.save-bar {
    background: #fff;
    border-radius: 16px;
    padding: 1rem 1.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.06);
    position: sticky;
    bottom: 20px;
    z-index: 10;
}

/* ─── Responsive ─── */
@media (max-width: 768px) {
    .template-icon { width: 36px; height: 36px; font-size: 1rem; }
    .save-bar { position: static; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // Initialize admin-only tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            new bootstrap.Tooltip(el, { trigger: 'hover focus', boundary: 'clippingParents' });
        }
    });

    // ─── Toggle Card ───
    document.querySelectorAll(".toggle-card-btn").forEach(function(btn) {
        btn.addEventListener("click", function() {
            var body = this.closest(".template-card").querySelector(".template-body");
            var isOpen = body.style.display !== "none";
            body.style.display = isOpen ? "none" : "";
            this.classList.toggle("open", !isOpen);
        });
    });

    // ─── Expand All ───
    var expandAllBtn = document.getElementById("expandAllBtn");
    var allExpanded = false;
    expandAllBtn.addEventListener("click", function() {
        allExpanded = !allExpanded;
        document.querySelectorAll(".template-body").forEach(function(body) {
            body.style.display = allExpanded ? "" : "none";
        });
        document.querySelectorAll(".toggle-card-btn").forEach(function(btn) {
            btn.classList.toggle("open", allExpanded);
        });
        expandAllBtn.innerHTML = allExpanded
            ? '<i class="bi bi-arrows-collapse me-1"></i> সব বন্ধ করুন'
            : '<i class="bi bi-arrows-expand me-1"></i> সব খুলুন';
    });

    // ─── Placeholder Click to Copy ───
    document.querySelectorAll(".placeholder-tag").forEach(function(tag) {
        tag.addEventListener("click", function() {
            var text = this.dataset.ph;
            navigator.clipboard.writeText(text).then(function() {
                Swal.fire({ icon: 'success', title: 'কপি হয়েছে', text: text + ' কপি করা হয়েছে', timer: 1200, showConfirmButton: false, toast: true, position: 'top-end' });
            });
        });
    });

    // ─── Form Submit ───
    document.getElementById("emailTemplatesForm").addEventListener("submit", async function(e) {
        e.preventDefault();
        var saveBtn = document.getElementById("saveBtn");
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> সংরক্ষণ করা হচ্ছে...';
        try {
            var form = e.target;
            var data = new FormData(form);
            var resp = await fetch(form.action, { method: 'POST', body: data });
            var json = await resp.json();
            if (json.status === 'success') {
                Swal.fire({ icon: 'success', title: 'সফল', text: 'ইমেইল টেমপ্লেট সংরক্ষণ করা হয়েছে', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
                updateStats();
            } else {
                Swal.fire('ত্রুটি', json.alert?.message || 'সংরক্ষণ ব্যর্থ হয়েছে', 'error');
            }
        } catch(err) {
            Swal.fire('ত্রুটি', 'সংযোগ ব্যর্থ', 'error');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="bi bi-floppy me-1"></i> সংরক্ষণ করুন';
        }
    });

    // ─── Preview ───
    document.querySelectorAll(".preview-btn").forEach(function(btn) {
        btn.addEventListener("click", async function() {
            var template = this.dataset.template;
            var fd = new FormData();
            fd.append('name', template);
            fd.append('csrf_token', '{{ csrf_token }}');
            try {
                var res = await fetch('/settings/email-templates/preview', { method: 'POST', body: fd });
                var json = await res.json();
                if (json.success) {
                    document.getElementById('emailPreviewTitle').innerText = template + ' (প্রিভিউ)';
                    document.getElementById('emailPreviewBody').innerHTML = json.html;
                    new bootstrap.Modal(document.getElementById('emailPreviewModal')).show();
                } else {
                    Swal.fire('ত্রুটি', json.message || 'প্রিভিউ ব্যর্থ', 'error');
                }
            } catch(err) {
                Swal.fire('ত্রুটি', 'প্রিভিউ লোড ব্যর্থ', 'error');
            }
        });
    });

    // ─── Stats ───
    function updateStats() {
        var customized = 0;
        var defaultCount = 0;
        document.querySelectorAll(".template-textarea").forEach(function(ta) {
            if (ta.value.trim()) customized++;
            else defaultCount++;
        });
        document.getElementById("customizedCount").textContent = toBangla(customized) + " টি";
        document.getElementById("defaultCount").textContent = toBangla(defaultCount) + " টি";
    }
    function toBangla(n) {
        var bn = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
        return n.toString().replace(/\d/g, function(d) { return bn[d]; });
    }
    updateStats();
});
</script>
{% endblock %}
