{# common/address_fields_script.twig — Geo-loading, autocomplete, address copy script (include once per page) #}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // This partial is included once per address block, so bind everything only once
    if (window.__addressFieldsScriptBound) return;
    window.__addressFieldsScriptBound = true;

    var prefixes = ['business', 'present', 'permanent'];
    window.postOfficeDebug = window.postOfficeDebug ?? true;
    window.postOfficeDebugLog = window.postOfficeDebugLog || function () {
        if (window.postOfficeDebug && window.console) {
            console.log.apply(console, arguments);
        }
    };

    function escapeAttr(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function postOfficeDropdownFor(input) {
        var wrapper = input && input.closest ? input.closest('.autocomplete-wrapper') : null;
        return wrapper ? wrapper.querySelector('.autocomplete-dropdown') : null;
    }

    function clearPostOfficeDropdown(input) {
        var dropdown = postOfficeDropdownFor(input);
        if (!dropdown) return;
        dropdown.innerHTML = '';
        dropdown.classList.remove('show');
        dropdown._bnMap = {};
        dropdown._items = [];
    }

    // Render post-office items into one dropdown. The selection handler is bound
    // here (once per item) so it never stacks up on repeated focus/click.
    function fillPostOfficeDropdown(dropdown, input, items, map) {
        if (!dropdown || !input) return;
        dropdown.innerHTML = '';
        dropdown.classList.remove('show');
        dropdown._bnMap = map || {};
        dropdown._items = items || [];

        (items || []).forEach(function(item) {
            var enName = item.en_name || '';
            var bnName = item.bn_name || '';
            var postCode = item.post_code ? '-' + item.post_code : '';

            var li = document.createElement('li');
            li.dataset.en = enName;
            li.dataset.bn = bnName;
            li.dataset.postcode = postCode;
            li.innerHTML = '<span class="postoffice-name">' +
                escapeAttr(enName + postCode) + '</span>' +
                (bnName ? '<span class="postoffice-bn">' + escapeAttr(bnName) + '</span>' : '');

            li.addEventListener('mousedown', function(e) {
                e.preventDefault();
                var isBengaliField = input.id && input.id.endsWith('_postoffice_bn');
                input.value = isBengaliField ? (bnName || enName) : enName;

                var prefix = (input.id || '').replace(/_postoffice_(en|bn)$/, '');
                var enInput = document.getElementById(prefix + '_postoffice_en');
                var bnInput = document.getElementById(prefix + '_postoffice_bn');
                if (enInput) enInput.value = enName;
                if (bnInput) bnInput.value = bnName || enName;
                dropdown.classList.remove('show');
                input.focus();
            });

            dropdown.appendChild(li);
        });

        // Data arrived while this box had focus: open the full list right away
        if (document.activeElement === input) {
            showPostOfficeDropdown(input, true);
        }
    }

    // Fill the English and the Bengali post-office dropdowns of one address block
    function fillPostOfficeDropdowns(prefix, items, map) {
        ['_postoffice_en', '_postoffice_bn'].forEach(function(suffix) {
            var input = document.getElementById(prefix + suffix);
            if (!input) return;
            fillPostOfficeDropdown(postOfficeDropdownFor(input), input, items, map);
        });
    }

    window.isPrefixAvailable = window.isPrefixAvailable || function(prefix) {
        return document.getElementById(prefix + '_district_id') !== null;
    };

    window.populateDropdown = window.populateDropdown || function(selector, data) {
        var el = typeof selector === 'string' ? document.querySelector(selector) : selector;
        if (!el) return;

        var selectedValue = el.dataset.selected;
        el.innerHTML = '<option value="">\u099A\u09BF\u09B9\u09CD\u09A8\u09BF\u09A4 \u0995\u09B0\u09C1\u09A8</option>';
        var selectedValueNorm = selectedValue ? String(selectedValue).trim().toLowerCase() : null;

        data.forEach(function (item) {
            var itemIdNorm = String(item.id).trim().toLowerCase();
            var itemNameEnNorm = String(item.name_en).trim().toLowerCase();
            var isSelected = selectedValueNorm && (selectedValueNorm === itemIdNorm || selectedValueNorm === itemNameEnNorm) ? 'selected' : '';

            var opt = document.createElement('option');
            opt.value = item.name_en;
            opt.setAttribute('data-geo-code', item.geo_code);
            opt.setAttribute('data-name-en', item.name_en);
            opt.setAttribute('data-name-bn', item.name_bn);
            opt.setAttribute('data-geo-id', item.id);
            if (isSelected) opt.selected = true;
            opt.textContent = item.name_en + ' (' + item.name_bn + ')';
            el.appendChild(opt);
        });
    };

    window.resetDropdown = window.resetDropdown || function(selector) {
        var el = typeof selector === 'string' ? document.querySelector(selector) : selector;
        if (el) {
            el.innerHTML = '<option value="">\u099A\u09BF\u09B9\u09CD\u09A8\u09BF\u09A4 \u0995\u09B0\u09C1\u09A8</option>';
        }
    };

    window.fetchGeoData = window.fetchGeoData || function(geoOrder, parentGeoId, dropdownSelector, nextGeoOrder, nextGeoIdSelector, callback) {
        nextGeoOrder = nextGeoOrder || null;
        nextGeoIdSelector = nextGeoIdSelector || null;
        callback = callback || null;
        if (!dropdownSelector || !document.querySelector(dropdownSelector)) return;

        var formData = new FormData();
        formData.append('geo_order', geoOrder);
        formData.append('parent_geo_id', parentGeoId);

        fetch('/geo/getdata', {
            method: 'POST',
            body: formData,
        })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
            populateDropdown(dropdownSelector, data);
            if (nextGeoOrder && nextGeoIdSelector) resetDropdown(nextGeoIdSelector);
            if (callback) callback();
        })
        .catch(function(err) {
            console.error('Geo fetch error:', err);
        });
    };

    // Initial District Load for available prefixes
    (function() {
        var formData = new FormData();
        formData.append('geo_order', '1');
        formData.append('parent_geo_id', '0');

        fetch('/geo/getdata', {
            method: 'POST',
            body: formData,
        })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
            prefixes.forEach(function(prefix) {
                if (isPrefixAvailable(prefix)) {
                    populateDropdown('#' + prefix + '_district_id', data);
                    // Trigger change if a value is pre-selected
                    var distEl = document.getElementById(prefix + '_district_id');
                    var selected = distEl.dataset.selected;
                    if (selected) {
                        distEl.value = selected;
                        distEl.dispatchEvent(new Event('change'));
                    }
                }
            });

            // Auto-check after initial data load
            setTimeout(function() {
                if (addressesMatch('business', 'present')) {
                    var el = document.getElementById('same_as_business_address');
                    if (el) el.checked = true;
                }
                if (addressesMatch('present', 'permanent')) {
                    var el2 = document.getElementById('permanentBtn');
                    if (el2) el2.checked = true;
                }
                if (addressesMatch('present', 'business')) {
                    var el3 = document.getElementById('copy_present_to_business');
                    if (el3) el3.checked = true;
                }
            }, 500);
        })
        .catch(function(error) {
            console.error('Error loading districts:', error);
        });
    })();

    // Bind dropdown change events
    prefixes.forEach(function(prefix) {
        if (!isPrefixAvailable(prefix)) return;

        var distIdEl = document.getElementById(prefix + '_district_id');
        var upaIdEl = document.getElementById(prefix + '_upazila_id');
        var unionIdEl = document.getElementById(prefix + '_union_id');
        var distEl = document.getElementById(prefix + '_district');
        var upaEl = document.getElementById(prefix + '_upazila');
        var unionEl = document.getElementById(prefix + '_union');
        var postEnEl = document.getElementById(prefix + '_postoffice_en');

        if (distIdEl) {
            distIdEl.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                var id = (opt ? opt.getAttribute('data-geo-id') : null) || 0;
                var nameBn = (opt ? opt.getAttribute('data-name-bn') : '') || '';
                if (!id) return;
                if (distEl) distEl.value = nameBn;
                fetchGeoData(2, id, '#' + prefix + '_upazila_id', 3, '#' + prefix + '_union_id', function() {
                    var selectedUpazila = upaIdEl ? upaIdEl.dataset.selected : null;
                    if (selectedUpazila && upaIdEl) {
                        upaIdEl.value = selectedUpazila;
                        upaIdEl.dispatchEvent(new Event('change'));
                    }
                });
            });
        }

        if (upaIdEl) {
            upaIdEl.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                var id = (opt ? opt.getAttribute('data-geo-id') : null) || 0;
                var nameBn = (opt ? opt.getAttribute('data-name-bn') : '') || '';
                if (!id) return;
                if (upaEl) upaEl.value = nameBn;
                fetchGeoData(3, id, '#' + prefix + '_union_id', null, null, function() {
                    var selectedUnion = unionIdEl ? unionIdEl.dataset.selected : null;
                    if (selectedUnion && unionIdEl) {
                        unionIdEl.value = selectedUnion;
                        unionIdEl.dispatchEvent(new Event('change'));
                    }
                });
                // If no union dropdown, load post offices based on upazila
                if (!unionIdEl) {
                    loadPostOfficesByUpazila(prefix, id);
                }
            });
        }

        if (unionIdEl) {
            unionIdEl.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                var nameBn = (opt ? opt.getAttribute('data-name-bn') : '') || '';
                if (unionEl) unionEl.value = nameBn;
                var unionName = (opt ? opt.getAttribute('data-name-en') : '') || this.value;
                window.postOfficeDebugLog('[post-office] union change', {
                    prefix: prefix,
                    unionName: unionName,
                    unionBn: nameBn
                });
                if (unionName) {
                    fetchPostOffices(
                        unionName,
                        '#' + prefix + '_postoffice_en',
                        '#' + prefix + '_postoffice_bn'
                    );
                }
            });
        }

        if (postEnEl) {
            postEnEl.addEventListener('input', function() { updateBnFromMap(prefix); });
            postEnEl.addEventListener('change', function() { updateBnFromMap(prefix); });
        }
    });

    function updateBnFromMap(prefix) {
        var wrapper = document.querySelector('#' + prefix + '_postoffice_en').closest('.autocomplete-wrapper');
        if (!wrapper) return;
        var dropdown = wrapper.querySelector('.autocomplete-dropdown');
        if (!dropdown) return;
        var map = dropdown._bnMap || {};
        var val = String(document.getElementById(prefix + '_postoffice_en').value).trim().toLowerCase();
        if (val && map[val]) {
            document.getElementById(prefix + '_postoffice_bn').value = map[val];
        }
    }

    // Load post offices by upazila when union dropdown is not present
    function loadPostOfficesByUpazila(prefix, upazilaId) {
        fetch('/api/v2/geo/post-offices/' + upazilaId)
        .then(function(resp) { return resp.json(); })
        .then(function(res) {
            if (!res || res.status !== 'success' || !res.data || !Array.isArray(res.data) || !res.data.length) {
                console.log('No post offices found for upazila:', upazilaId);
                return;
            }
            var input = document.getElementById(prefix + '_postoffice_en');
            if (!input) return;

            window.postOfficeDebugLog('[post-office] fetch by upazila', {
                upazilaId: upazilaId,
                prefix: prefix
            });

            var currentVal = String(input.value).trim().toLowerCase();
            var map = {};

            res.data.forEach(function(item) {
                var enName = item.en_name || '';
                if (enName) map[enName.trim().toLowerCase()] = item.bn_name || '';
            });

            // Fill both the English and the Bengali post-office dropdowns
            fillPostOfficeDropdowns(prefix, res.data, map);

            // Auto-fill BN if current value matches an option
            if (currentVal && map[currentVal]) {
                var bnInput = document.getElementById(prefix + '_postoffice_bn');
                if (bnInput) bnInput.value = map[currentVal];
            }
        })
        .catch(function(err) {
            console.error('Post offices fetch error for upazila:', err);
        });
    }

    window.fetchPostOffices = window.fetchPostOffices || function(unionName, inputSelector, bnInputSelector) {
        if (!unionName) return;
        var input = document.querySelector(inputSelector);
        if (!input) return;

        var bnInput = bnInputSelector ? document.querySelector(bnInputSelector) : null;
        var prefix = (input.id || '').replace(/_postoffice_(en|bn)$/, '');

        // Clear previous items while the request is in flight
        clearPostOfficeDropdown(input);
        clearPostOfficeDropdown(bnInput);

        window.postOfficeDebugLog('[post-office] fetch start', {
            unionName: unionName,
            inputSelector: inputSelector,
            bnInputSelector: bnInputSelector
        });

        fetch('/api/post-offices?union_name=' + encodeURIComponent(unionName))
        .then(function(resp) { return resp.json(); })
        .then(function(res) {
            window.postOfficeDebugLog('[post-office] fetch response', res);
            if (res.status !== 'success' || !res.data) return;

            var currentVal = String(input.value).trim().toLowerCase();
            var map = {};

            res.data.forEach(function(item) {
                var enName = item.en_name || '';
                if (enName) map[enName.trim().toLowerCase()] = item.bn_name || '';
            });

            if (prefix) {
                // Fill both the English and the Bengali post-office dropdowns
                fillPostOfficeDropdowns(prefix, res.data, map);
            } else {
                fillPostOfficeDropdown(postOfficeDropdownFor(input), input, res.data, map);
            }

            // Auto-fill BN if current value matches an option
            if (currentVal && map[currentVal] && bnInput) {
                bnInput.value = map[currentVal];
            }
        })
        .catch(function(err) {
            window.postOfficeDebugLog('[post-office] fetch error', err);
            console.error('Post offices fetch error:', err);
        });
    };

    // Generic address copy function
    window.copyAddress = window.copyAddress || function(from, to) {
        if (!isPrefixAvailable(from) || !isPrefixAvailable(to)) return;

        var fields = ['village_en', 'village_bn', 'rbs_en', 'rbs_bn', 'holding_no', 'ward_no', 'postoffice_en', 'postoffice_bn'];
        fields.forEach(function(field) {
            var fromEl = document.getElementById(from + '_' + field);
            var toEl = document.getElementById(to + '_' + field);
            if (fromEl && toEl) toEl.value = fromEl.value;
        });

        var fromDistId = document.getElementById(from + '_district_id');
        var toDistId = document.getElementById(to + '_district_id');
        var fromDist = document.getElementById(from + '_district');
        if (fromDistId && toDistId) {
            toDistId.value = fromDistId.value;
            var selectedOpt = fromDistId.options[fromDistId.selectedIndex];
            var districtGeoId = selectedOpt ? selectedOpt.getAttribute('data-geo-id') : 0;

            fetchGeoData(2, districtGeoId, '#' + to + '_upazila_id', 3, '#' + to + '_union_id', function () {
                if (fromDist && document.getElementById(to + '_district'))
                    document.getElementById(to + '_district').value = fromDist.value;

                var fromUpaId = document.getElementById(from + '_upazila_id');
                var toUpaId = document.getElementById(to + '_upazila_id');
                var fromUpa = document.getElementById(from + '_upazila');
                if (fromUpaId && toUpaId) {
                    toUpaId.value = fromUpaId.value;
                    var upaOpt = fromUpaId.options[fromUpaId.selectedIndex];
                    var upazilaGeoId = upaOpt ? upaOpt.getAttribute('data-geo-id') : 0;

                    fetchGeoData(3, upazilaGeoId, '#' + to + '_union_id', null, null, function () {
                        var fromUnionId = document.getElementById(from + '_union_id');
                        var toUnionId = document.getElementById(to + '_union_id');
                        var fromUnion = document.getElementById(from + '_union');

                        if (fromUpa && document.getElementById(to + '_upazila'))
                            document.getElementById(to + '_upazila').value = fromUpa.value;
                        if (fromUnionId && toUnionId) toUnionId.value = fromUnionId.value;
                        if (fromUnion && document.getElementById(to + '_union'))
                            document.getElementById(to + '_union').value = fromUnion.value;
                    });
                }
            });
        }
    };

    // Compare two addresses
    window.addressesMatch = window.addressesMatch || function(prefix1, prefix2) {
        var fields = [
            'village_en', 'village_bn', 'rbs_en', 'rbs_bn',
            'holding_no', 'ward_no', 'postoffice_en', 'postoffice_bn',
            'district_id', 'district', 'upazila_id', 'upazila'
        ];
        return fields.every(function(field) {
            var el1 = document.getElementById(prefix1 + '_' + field);
            var el2 = document.getElementById(prefix2 + '_' + field);
            return (el1 ? el1.value : '') === (el2 ? el2.value : '');
        });
    };

    // Bind address copy + auto check/uncheck
    window.bindAddressSync = window.bindAddressSync || function(from, to, checkboxSelector) {
        var checkbox = document.querySelector(checkboxSelector);
        if (!checkbox) return;

        checkbox.addEventListener('change', function () {
            if (this.checked) {
                copyAddress(from, to);
            } else {
                var container = document.getElementById(to + '_address_fields');
                if (container) {
                    container.querySelectorAll('input, select').forEach(function(el) { el.value = ''; });
                }
            }
        });

        var toContainer = document.getElementById(to + '_address_fields');
        if (toContainer) {
            toContainer.addEventListener('input', function() {
                if (!addressesMatch(from, to)) checkbox.checked = false;
            });
            toContainer.addEventListener('change', function() {
                if (!addressesMatch(from, to)) checkbox.checked = false;
            });
        }

        var fromContainer = document.getElementById(from + '_address_fields');
        if (fromContainer) {
            fromContainer.addEventListener('input', function() {
                checkbox.checked = addressesMatch(from, to);
            });
            fromContainer.addEventListener('change', function() {
                checkbox.checked = addressesMatch(from, to);
            });
        }
    };

    // Call sync bindings
    bindAddressSync('business', 'present', '#same_as_business_address');
    bindAddressSync('present', 'permanent', '#permanentBtn');
    bindAddressSync('present', 'business', '#copy_present_to_business');

    // Manual button to copy present to permanent
    var copyBtn = document.getElementById('copy_present_to_permanent');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            copyAddress('present', 'permanent');
        });
    }

    // Custom Autocomplete Dropdown: show/filter on click/focus/input.
    // showAll = true renders the complete list (used on focus/reopen);
    // otherwise the list is filtered by the text currently typed.
    function showPostOfficeDropdown(input, showAll) {
        var dropdown = postOfficeDropdownFor(input);
        if (!dropdown) return;
        var items = dropdown._items;
        if (!items || items.length === 0) return;

        // Show only the language of the focused field
        var isEnglishField = input.id && input.id.endsWith('_postoffice_en');
        var isBengaliField = input.id && input.id.endsWith('_postoffice_bn');
        var searchVal = showAll ? '' : String(input.value || '').toLowerCase();
        var visibleCount = 0;
        var lis = dropdown.querySelectorAll('li');
        lis.forEach(function(li) {
            var en = (li.dataset.en || '').toLowerCase();
            var bn = (li.dataset.bn || '').toLowerCase();
            var match = false;
            if (isEnglishField) {
                match = !searchVal || en.includes(searchVal);
            } else if (isBengaliField) {
                match = !searchVal || bn.includes(searchVal) || (!bn && en.includes(searchVal));
            } else {
                // Default: search in both
                match = !searchVal || en.includes(searchVal) || bn.includes(searchVal);
            }
            li.style.display = match ? '' : 'none';
            if (!match) return;
            visibleCount++;

            // Render the row in the language of the focused field only
            var enName = li.dataset.en || '';
            var bnName = li.dataset.bn || '';
            var postCode = li.dataset.postcode;
            if (postCode === undefined || postCode === null) {
                postCode = '';
                var nameSpan = li.querySelector('.postoffice-name');
                if (nameSpan) {
                    var fullText = nameSpan.textContent;
                    var dashIndex = fullText.lastIndexOf('-');
                    if (dashIndex > 0) {
                        postCode = fullText.substring(dashIndex);
                    }
                }
            }
            if (isBengaliField) {
                li.innerHTML = '<span class="postoffice-name">' +
                    escapeAttr((bnName || enName) + postCode) + '</span>';
            } else if (isEnglishField) {
                li.innerHTML = '<span class="postoffice-name">' +
                    escapeAttr(enName + postCode) + '</span>';
            } else {
                li.innerHTML = '<span class="postoffice-name">' +
                    escapeAttr(enName + postCode) + '</span>' +
                    (bnName ? '<span class="postoffice-bn">' + escapeAttr(bnName) + '</span>' : '');
            }
        });

        // Keep only one post-office dropdown open inside the same address row
        var row = input.closest('.row');
        if (row) {
            row.querySelectorAll('.autocomplete-dropdown').forEach(function(other) {
                if (other !== dropdown) other.classList.remove('show');
            });
        }

        if (visibleCount > 0) {
            dropdown.classList.add('show');
        } else {
            dropdown.classList.remove('show');
        }
    }

    document.addEventListener('focus', function(e) {
        if (e.target.matches && e.target.matches('.autocomplete-wrapper input[type="text"]')) {
            showPostOfficeDropdown(e.target, true);
        }
    }, true);

    document.addEventListener('click', function(e) {
        if (e.target.matches && e.target.matches('.autocomplete-wrapper input[type="text"]')) {
            var dropdown = postOfficeDropdownFor(e.target);
            if (dropdown && dropdown.classList.contains('show')) return;
            showPostOfficeDropdown(e.target, true);
        }
    });

    document.addEventListener('input', function(e) {
        if (e.target.matches && e.target.matches('.autocomplete-wrapper input[type="text"]')) {
            showPostOfficeDropdown(e.target);
        }
    });

    // Hide on blur (with delay for click capture)
    document.addEventListener('blur', function(e) {
        if (e.target.matches && e.target.matches('.autocomplete-wrapper input[type="text"]')) {
            var wrapper = e.target.closest('.autocomplete-wrapper');
            if (!wrapper) return;
            var dropdown = wrapper.querySelector('.autocomplete-dropdown');
            if (!dropdown) return;
            setTimeout(function() {
                dropdown.classList.remove('show');
            }, 200);
        }
    }, true);// Keyboard navigation
    document.addEventListener('keydown', function(e) {
        if (!e.target.matches || !e.target.matches('.autocomplete-wrapper input[type="text"]')) return;

        var wrapper = e.target.closest('.autocomplete-wrapper');
        if (!wrapper) return;
        var dropdown = wrapper.querySelector('.autocomplete-dropdown');
        if (!dropdown || !dropdown.classList.contains('show')) return;

        // Determine which language field is focused
        var isEnglishField = e.target.id && e.target.id.endsWith('_postoffice_en');
        var isBengaliField = e.target.id && e.target.id.endsWith('_postoffice_bn');

        var allLis = Array.from(dropdown.querySelectorAll('li')).filter(function(li) {
            return li.style.display !== 'none';
        });
        if (allLis.length === 0) return;

        var activeLi = dropdown.querySelector('li.active');
        var idx = activeLi ? allLis.indexOf(activeLi) : -1;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            idx = Math.min(idx + 1, allLis.length - 1);
            allLis.forEach(function(li) { li.classList.remove('active'); });
            allLis[idx].classList.add('active');
            allLis[idx].scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            allLis.forEach(function(li) { li.classList.remove('active'); });
            if (idx > 0) {
                idx--;
                allLis[idx].classList.add('active');
                allLis[idx].scrollIntoView({ block: 'nearest' });
            }
        } else if (e.key === 'Enter' || e.key === 'Tab') {
            if (idx >= 0 && idx < allLis.length) {
                e.preventDefault();
                var item = allLis[idx];
                // Set value based on which field is focused
                if (isBengaliField) {
                    e.target.value = item.dataset.bn;
                } else {
                    e.target.value = item.dataset.en;
                }
                var bnInput = wrapper.closest('.row').querySelector('[id$="_postoffice_bn"]');
                var enInput = wrapper.closest('.row').querySelector('[id$="_postoffice_en"]');
                if (bnInput) bnInput.value = item.dataset.bn;
                if (enInput) enInput.value = item.dataset.en;
                dropdown.classList.remove('show');
            }
        } else if (e.key === 'Escape') {
            dropdown.classList.remove('show');
        }
    });

});
</script>
