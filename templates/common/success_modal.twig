{# common/success_modal.twig #}
<div id="successModal" class="custom-modal" style="display: none;">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <i class="fa fa-check-circle"></i> {{ certificate_type_bn ? (certificate_type_bn ~ ' - ') : '' }}আবেদন সফল!
        </div>
        <div class="custom-modal-body">
            <p>আপনার আবেদনটি সফলভাবে সাবমিট হয়েছে।</p>
            <p><b>আপনার ট্র্যাকিং নম্বর:</b> <span id="application_id"></span></p>
        </div>
        <div class="custom-modal-footer">
            <button class="btn-action" id="downloadCopy">আবেদন কপি ডাউনলোড</button>
            <button class="btn-action" id="newApplication">নতুন আবেদন করুন</button>
            <button class="btn-close-modal">বন্ধ করুন</button>
        </div>
    </div>
</div>

<div id="updateModal" class="custom-modal" style="display: none;">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <i class="fa fa-check-circle"></i> {{ certificate_type_bn ? (certificate_type_bn ~ ' - ') : '' }}আবেদন আপডেট সফল!
        </div>
        <div class="custom-modal-body">
            <p>আপনার আবেদনটি সফলভাবে আপডেট হয়েছে।</p>
            <ul id="updateChangeList" style="margin-bottom: 15px;"></ul>
            <div id="updateLinks" style="margin-top: 10px;">
                <a href="#" id="downloadCertificate" class="btn-action" target="_blank">সার্টিফিকেট ডাউনলোড করুন</a>
                <a href="/applications/{{ certificate_type|default('application') }}" class="btn-action">সকল আবেদন দেখুন</a>
            </div>
        </div>
        <div class="custom-modal-footer">
            <button class="btn-close-modal">বন্ধ করুন</button>
        </div>
    </div>
</div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('applicationForm');
            var submitButton = form ? form.querySelector("button[type='submit']") : null;
            var isLoggedIn = {{ is_logged_in ? 'true' : 'false' }};
            var certificateType = "{{ certificate_type }}";

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    var appIdEl = document.getElementById('application_id');
                    var isUpdate = appIdEl && appIdEl.value ? true : false;
                    var url = '/applications/' + certificateType + '/' + (isUpdate ? 'update' : 'insert');

                    var restoreBtn;
                    if (submitButton) {
                        restoreBtn = btnLoading(submitButton, 'জমা দেওয়া হচ্ছে...');
                    }

                    fetch(url, {
                        method: 'POST',
                        body: new FormData(form),
                    })
                    .then(function (resp) {
                        return resp.json();
                    })
                    .then(function (response) {
                        if (restoreBtn) restoreBtn();
                        if (response.status === "success") {
                            if (isUpdate) {
                                var updateChangeList = document.getElementById('updateChangeList');
                                if (response.changes && Array.isArray(response.changes) && response.changes.length > 0) {
                                    var listHtml = response.changes.map(function(item) {
                                        return '<li>' + item + '</li>';
                                    }).join('');
                                    updateChangeList.innerHTML = listHtml;
                                    updateChangeList.style.display = '';
                                } else {
                                    updateChangeList.style.display = 'none';
                                }
                                var certType = certificateType || 'application';
                                var existingSonod = response.sonod_number || (document.getElementById('sonod_number') ? document.getElementById('sonod_number').value : '');
                                var downloadCert = document.getElementById('downloadCertificate');
                                if (isLoggedIn && existingSonod) {
                                    downloadCert.href = '/application/' + certType + '/bangla/' + existingSonod;
                                    downloadCert.textContent = '\u09B8\u09BE\u09B0\u09CD\u099F\u09BF\u09AB\u09BF\u0995\u09C7\u099F \u09A1\u09BE\u0989\u09A8\u09B2\u09CB\u09A1 \u0995\u09B0\u09C1\u09A8';
                                    downloadCert.style.display = '';
                                } else if (response.sonod_number && (!response.status || response.status.toLowerCase() !== 'pending')) {
                                    downloadCert.href = '/application/' + certType + '/bangla/' + response.sonod_number;
                                    downloadCert.textContent = '\u09B8\u09BE\u09B0\u09CD\u099F\u09BF\u09AB\u09BF\u0995\u09C7\u099F \u09A1\u09BE\u0989\u09A8\u09B2\u09CB\u09A1 \u0995\u09B0\u09C1\u09A8';
                                    downloadCert.style.display = '';
                                } else if (response.application_id) {
                                    downloadCert.href = '/applications/' + certType + '/approve/' + response.application_id;
                                    downloadCert.textContent = '\u0985\u09A8\u09C1\u09AE\u09CB\u09A6\u09A8 \u09A6\u09BF\u09A8 / \u09A6\u09C7\u0996\u09C1\u09A8';
                                    downloadCert.style.display = '';
                                } else {
                                    downloadCert.style.display = 'none';
                                }
                                document.getElementById('updateModal').style.display = '';
                            } else {
                                document.getElementById('application_id').textContent = response.application_id;
                                document.getElementById('union_code').textContent = response.union_code;
                                document.getElementById('rmo_code').textContent = response.rmo_code;
                                document.getElementById('successModal').style.display = '';
                            }
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    })
                    .catch(function (error) {
                        if (restoreBtn) restoreBtn();
                        var message = '\u26A0\uFE0F \u0995\u09BF\u099B\u09C1 \u09B8\u09AE\u09B8\u09CD\u09AF\u09BE \u09B9\u09AF\u09BC\u09C7\u099B\u09C7, \u0986\u09AC\u09BE\u09B0 \u099A\u09C7\u09B7\u09CD\u099F\u09BE \u0995\u09B0\u09C1\u09A8\u0964';
                        if (error && error.text) {
                            error.text().then(function (text) {
                                try {
                                    var resp = JSON.parse(text);
                                    if (resp.message) message = '\u26A0\uFE0F ' + resp.message;
                                } catch (e) {
                                    if (text) message = '\u26A0\uFE0F \u09B8\u09BE\u09B0\u09CD\u09AD\u09BE\u09B0 \u09A5\u09C7\u0995\u09C7 \u0989\u09A4\u09CD\u09A4\u09B0: ' + text;
                                }
                                Swal.fire('Error', message, 'error');
                            });
                        } else {
                            Swal.fire('Error', message, 'error');
                        }
                    });
                });
            }

            var newAppBtn = document.getElementById('newApplication');
            if (newAppBtn) {
                newAppBtn.addEventListener('click', function () {
                    document.getElementById('successModal').style.display = 'none';
                    if (form) form.reset();
                });
            }

            document.addEventListener('click', function (e) {
                var closeBtn = e.target.closest('.btn-close-modal');
                if (closeBtn) {
                    var modal = closeBtn.closest('.custom-modal');
                    if (modal) {
                        modal.style.display = 'none';
                    } else {
                        ['successModal', 'updateModal'].forEach(function(id) {
                            var m = document.getElementById(id);
                            if (m && m.style.display !== 'none') m.style.display = 'none';
                        });
                    }
                }
            });

            document.addEventListener('click', function (e) {
                if (e.target.classList.contains('custom-modal') && e.target.style.display !== 'none') {
                    e.target.style.display = 'none';
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.custom-modal').forEach(function(m) {
                        if (m.style.display !== 'none') m.style.display = 'none';
                    });
                }
            });

            var downloadCopyBtn = document.getElementById('downloadCopy');
            if (downloadCopyBtn) {
                downloadCopyBtn.addEventListener('click', function () {
                    var applicantId = document.getElementById('application_id').textContent;
                    var union_code = (document.getElementById('union_code').textContent || '').trim() || "0";
                    var rmo_code = (document.getElementById('rmo_code').textContent || '').trim() || "0";

                    window.open(
                        "/" + certificateType + "/_verify/application/" + applicantId + "/" + union_code + "/" + rmo_code,
                        "_blank"
                    );
                });
            }
        });
    </script>