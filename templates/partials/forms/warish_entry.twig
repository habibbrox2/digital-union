{# partials/forms/warish_list.twig #}
<div class="row">
    <div class="col-12">
        <div id="warish_container">
            {% if data.members is not empty %}
                {% for w in data.members %}
                <div class="row g-2 warish_entry border rounded-0 p-2 mb-2">
    <div class="col-md-1">
        <input type="number" name="serial_no[]" id="warish_serial_{{ loop.index0 }}" class="form-control" value="{{ w.serial_no|e }}" placeholder="ক্রমিক" aria-label="ক্রমিক">
    </div>
    <div class="col-md-2">
        <input type="text" name="warish_name_bn[]" id="warish_name_bn_{{ loop.index0 }}" class="form-control" value="{{ w.name_bn|e }}" placeholder="নাম (বাংলায়)" required aria-label="নাম (বাংলায়)">
    </div>
    <div class="col-md-2">
        <input type="text" name="warish_name_en[]" id="warish_name_en_{{ loop.index0 }}" class="form-control" value="{{ w.name_en|e }}" placeholder="নাম (ইংরেজিতে)" pattern="^[a-zA-Z. ]+$" aria-label="নাম (ইংরেজিতে)">
    </div>
    <div class="col-md-1">
        {% set rel = w.relation_bn ~ '|' ~ w.relation_en %}
        <select name="relation[]" id="warish_relation_{{ loop.index0 }}" class="form-control" required aria-label="সম্পর্ক">
            <option value="">সম্পর্ক নির্বাচন করুন</option>
            <option value="পিতা|Father" {{ rel=='পিতা|Father'?'selected' }}>পিতা (Father)</option>
            <option value="মাতা|Mother" {{ rel=='মাতা|Mother'?'selected' }}>মাতা (Mother)</option>
            <option value="স্ত্রী|Wife" {{ rel=='স্ত্রী|Wife'?'selected' }}>স্ত্রী (Wife)</option>
            <option value="স্বামী|Husband" {{ rel=='স্বামী|Husband'?'selected' }}>স্বামী (Husband)</option>
            <option value="পুত্র|Son" {{ rel=='পুত্র|Son'?'selected' }}>পুত্র (Son)</option>
            <option value="কন্যা|Daughter" {{ rel=='কন্যা|Daughter'?'selected' }}>কন্যা (Daughter)</option>
            <option value="ভাই|Brother" {{ rel=='ভাই|Brother'?'selected' }}>ভাই (Brother)</option>
            <option value="বোন|Sister" {{ rel=='বোন|Sister'?'selected' }}>বোন (Sister)</option>
        </select>
    </div>

    <div class="col-md-2">
        <input type="text" name="member_birth_date[]" id="warish_birth_date_{{ loop.index0 }}" class="form-control date-input-ddmmyyyy" value="{{ w.birth_date and w.birth_date != '0000-00-00' ? w.birth_date|date('d-m-Y') : '' }}" placeholder="DD-MM-YYYY / 26 years old" title="DD-MM-YYYY or age (e.g. 26 years old)" aria-label="জন্ম তারিখ">
    </div>
    <div class="col-md-2">
        <input type="text" name="relation_nid[]" id="warish_nid_{{ loop.index0 }}" class="form-control" value="{{ w.nid|e }}" placeholder="জাতীয় পরিচয়পত্র" pattern="^[0-9০-৯]+$" aria-label="জাতীয় পরিচয়পত্র">
    </div>
    <div class="col-md-2">
        <select name="marrage_state[]" id="warish_marital_{{ loop.index0 }}" class="form-control" required aria-label="বৈবাহিক অবস্থা">
            <option value="">বৈবাহিক অবস্থা</option>
            <option value="অবিবাহিত" {{ w.marital_status=='অবিবাহিত'?'selected' }}>অবিবাহিত</option>
            <option value="বিবাহিত" {{ w.marital_status=='বিবাহিত'?'selected' }}>বিবাহিত</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="is_dead[]" id="warish_is_dead_{{ loop.index0 }}" class="form-control" required aria-label="জীবিত/মৃত">
            <option value="">জীবিত/মৃত</option>
            <option value="0" {{ w.is_dead=='0'?'selected' }}>জীবিত</option>
            <option value="1" {{ w.is_dead=='1'?'selected' }}>মৃত</option>
        </select>
    </div>
    <!-- মুছুন -->
    <div class="col-md-2 text-end">
        <button type="button" class="btn btn-danger remove_warish">মুছুন</button>
    </div>
</div>
                {% endfor %}
            {% else %}
                {# যদি ডাটা না থাকে, ডিফল্ট খালি ইনপুট দেখাবে #}
                <div class="row g-2 warish_entry border rounded-0 p-2 mb-2">
                    <div class="col-md-1">
                        <input type="number" name="serial_no[]" id="warish_serial_0" class="form-control" value="1" placeholder="ক্রমিক" aria-label="ক্রমিক">
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="warish_name_bn[]" id="warish_name_bn_0" class="form-control" placeholder="নাম (বাংলায়)" aria-label="নাম (বাংলায়)">
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="warish_name_en[]" id="warish_name_en_0" class="form-control" placeholder="নাম (ইংরেজিতে)" pattern="^[a-zA-Z. ]+$" aria-label="নাম (ইংরেজিতে)">
                    </div>
                    <div class="col-md-1">
                    <select name="relation[]" id="warish_relation_0" class="form-control" required aria-label="সম্পর্ক">
                        <option value="">সম্পর্ক নির্বাচন করুন</option>
                        <option value="পিতা|Father">পিতা (Father)</option>
                        <option value="মাতা|Mother">মাতা (Mother)</option>
                        <option value="স্ত্রী|Wife">স্ত্রী (Wife)</option>
                        <option value="স্বামী|Husband">স্বামী (Husband)</option>
                        <option value="পুত্র|Son">পুত্র (Son)</option>
                        <option value="কন্যা|Daughter">কন্যা (Daughter)</option>
                        <option value="ভাই|Brother">ভাই (Brother)</option>
                        <option value="বোন|Sister">বোন (Sister)</option>
                    </select>

                    </div>
                    <div class="col-md-2">
                        <input type="text" name="member_birth_date[]" id="warish_birth_date_0" class="form-control date-input-ddmmyyyy" placeholder="DD-MM-YYYY / 26 years old" title="DD-MM-YYYY or age (e.g. 26 years old)" aria-label="জন্ম তারিখ">
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="relation_nid[]" id="warish_nid_0" class="form-control" placeholder="জাতীয় পরিচয়পত্র" aria-label="জাতীয় পরিচয়পত্র">
                    </div>
                    <div class="col-md-2">
                        <select name="marrage_state[]" id="warish_marital_0" class="form-control" aria-label="বৈবাহিক অবস্থা">
                            <option value="">বৈবাহিক অবস্থা</option>
                            <option value="অবিবাহিত">অবিবাহিত</option>
                            <option value="বিবাহিত">বিবাহিত</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="is_dead[]" id="warish_is_dead_0" class="form-control" aria-label="জীবিত/মৃত">
                            <option value="">জীবিত/মৃত</option>
                            <option value="0">জীবিত</option>
                            <option value="1">মৃত</option>
                        </select>
                    </div>
                    <!-- মুছুন -->
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-danger remove_warish">মুছুন</button>
                    </div>
                </div>
            {% endif %}
        </div>

        <button type="button" id="add_warish" class="btn btn-info mt-2">নতুন ওয়ারিশ</button>

        <div class="mt-2" id="emptyError" style="display: none;">
            <ul id="errorList" class="text-danger mb-0"></ul>
        </div>
    </div>
</div>


<script>
$(function () {
    // ----------------- Validation -----------------
    function validateEntries($form) {
        let isValid = true;
        let messages = [];

        $form.find('#warish_container .warish_entry').each((index, row) => {
            const rowNum = index + 1;

            const serial = $(row).find('input[name="serial_no[]"]');
            const nameBn = $(row).find('input[name="warish_name_bn[]"]');
            const relation = $(row).find('select[name="relation[]"]');
            const marital = $(row).find('select[name="marrage_state[]"]');
            const isDead = $(row).find('select[name="is_dead[]"]');

            // Required validation
            if (serial.prop('required') && !serial.val().trim()) {
                isValid = false;
                messages.push(`Row ${rowNum}: ক্রমিক নং দিতে হবে`);
                serial.addClass('is-invalid');
            } else { serial.removeClass('is-invalid'); }

            if (nameBn.prop('required') && !nameBn.val().trim()) {
                isValid = false;
                messages.push(`Row ${rowNum}: নাম (বাংলায়) দিতে হবে`);
                nameBn.addClass('is-invalid');
            } else { nameBn.removeClass('is-invalid'); }

            if (relation.prop('required') && !relation.val().trim()) {
                isValid = false;
                messages.push(`Row ${rowNum}: সম্পর্ক নির্বাচন করতে হবে`);
                relation.addClass('is-invalid');
            } else { relation.removeClass('is-invalid'); }

            if (marital.prop('required') && !marital.val().trim()) {
                isValid = false;
                messages.push(`Row ${rowNum}: বৈবাহিক অবস্থা দিতে হবে`);
                marital.addClass('is-invalid');
            } else { marital.removeClass('is-invalid'); }

            if (isDead.prop('required') && !isDead.val().trim()) {
                isValid = false;
                messages.push(`Row ${rowNum}: মৃত্যু অবস্থা নির্বাচন করতে হবে`);
                isDead.addClass('is-invalid');
            } else { isDead.removeClass('is-invalid'); }
        });

        const errorDiv = $form.find('#emptyError');
        const errorList = $form.find('#errorList');
        errorList.html('');

        if (!isValid) {
            messages.forEach(msg => {
                errorList.append(`<li>${msg}</li>`);
            });
            errorDiv.show();
            return false;
        } else {
            errorDiv.hide();
            return true;
        }
    }

    // ----------------- Apply to all forms -----------------
    $('form').on('submit', function(e) {
        const $form = $(this);
        if (!validateEntries($form)) {
            e.preventDefault();
        }
    });

    // ----------------- Dynamic Rows -----------------
    function updateRemoveButtons() {
        if ($(".warish_entry").length > 1) {
            $(".remove_warish").show();
        } else {
            $(".remove_warish").hide();
        }
    }

    function reorderSerials() {
        $(".warish_entry").each(function (index) {
            $(this).find("input[name='serial_no[]']").val(index + 1);
            // Reassign unique IDs when rows are removed/reordered
            $(this).find("input, select").each(function () {
                var $input = $(this);
                var oldId = $input.attr("id");
                if (oldId) {
                    $input.attr("id", oldId.replace(/\d+$/, index));
                }
            });
        });
    }

    function createNewEntry() {
        var newIndex = $(".warish_entry").length;
        var $clone = $(".warish_entry:first").clone();

        $clone.find("input, select").each(function () {
            var $input = $(this);
            var name = $input.attr("name");
            $input.val(name === "serial_no[]" ? (newIndex + 1) : "");
            // Assign a unique ID for the new row
            var oldId = $input.attr("id");
            if (oldId) {
                $input.attr("id", oldId.replace(/\d+$/, newIndex));
            }
        });

        return $clone;
    }

    $("#add_warish").click(function () {
        $("#warish_container").append(createNewEntry());
        updateRemoveButtons();
        reorderSerials();
    });

    $(document).on("click", ".remove_warish", function () {
        $(this).closest(".warish_entry").remove();
        updateRemoveButtons();
        reorderSerials();
    });

    updateRemoveButtons();
    reorderSerials();

    // ----------------- Bengali → English digit conversion -----------------
    function bnToEn(str) {
        return str.replace(/[০-৯]/g, d => String.fromCharCode(d.charCodeAt(0) - 0x09E6 + 0x30));
    }

    // ----------------- Age → DD-MM-YYYY converter -----------------
    // Accepts: "26", "26 years", "26 years old", "26 বছর", "26y"
    // Returns DD-MM-YYYY string (01-MM-YYYY) or null if not an age.
    function parseAgeInput(raw) {
        var val = bnToEn(raw.trim().toLowerCase());
        // Match digits followed by optional age keywords
        var m = val.match(/^(\d{1,3})\s*(?:years?|yrs?|y|বছর)?\s*(?:old)?$/);
        if (!m) return null;
        var age = parseInt(m[1], 10);
        if (age < 0 || age > 150) return null;
        var now = new Date();
        var birthYear = now.getFullYear() - age;
        // Use 01-01-YYYY as default when only age is known
        var dd = '01';
        var mm = String(now.getMonth() + 1).padStart(2, '0');
        return dd + '-' + mm + '-' + birthYear;
    }

    // ----------------- Auto-format birth date on input -----------------
    $('#warish_container').on('input', 'input[name="member_birth_date[]"]', function() {
        var val = bnToEn(this.value);

        // Only auto-format if the input looks like it's being typed as a date
        // (all digits and dashes, no letters like 'y', 'b', etc.)
        if (/^[\d\-]+$/.test(val)) {
            var digits = val.replace(/[^\d]/g, '');
            var formatted = '';
            if (digits.length > 0) formatted += digits.substring(0, 2);
            if (digits.length > 2) formatted += '-' + digits.substring(2, 4);
            if (digits.length > 4) formatted += '-' + digits.substring(4, 8);

            if (formatted !== this.value) {
                var start = this.selectionStart;
                this.value = formatted;
                var newStart = start + (formatted.length - val.length);
                this.setSelectionRange(newStart, newStart);
            }
        }
    });

    // ----------------- Convert age → DD-MM-YYYY on blur -----------------
    $('#warish_container').on('blur', 'input[name="member_birth_date[]"]', function() {
        var converted = parseAgeInput(this.value);
        if (converted) {
            this.value = converted;
        }
    });

    // Auto-convert Bengali digits to English on input for NID fields
    $('#warish_container').on('input', 'input[name="relation_nid[]"]', function() {
        var converted = bnToEn(this.value);
        if (converted !== this.value) {
            var start = this.selectionStart, end = this.selectionEnd;
            this.value = converted;
            this.setSelectionRange(start, end);
        }
    });

    // ----------------- Convert age → DD-MM-YYYY on form submit -----------------
    $('#warish_container').closest('form').on('submit', function() {
        $(this).find('input[name="member_birth_date[]"]').each(function() {
            var converted = parseAgeInput(this.value);
            if (converted) {
                this.value = converted;
            }
        });
    });
});
</script>
