        if (tradeFeeSection) tradeFeeSection.style.display = 'block';

        // Populate fiscal year options
        const fySelect = document.getElementById('modal_fiscal_year');
        fySelect.innerHTML = '<option value="">-- নির্বাচন করুন --</option>';
        (result.fiscal_year_options || []).forEach(opt => {
            const selected = opt.value === (bm.fiscal_year || result.data.fiscal_year || '') ? 'selected' : '';
            fySelect.innerHTML += `<option value="${opt.value}" ${selected}>${opt.label}</option>`;
        });
        // Populate ownership types
