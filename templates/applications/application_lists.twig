    document.getElementById('approveModalEducation').textContent = d.educational_qualification || '—';
    document.getElementById('approveModalOccupation').textContent = d.occupation || '—';
    const maritalStatusMap = { 'single': 'অবিবাহিত', 'married': 'বিবাহিত', 'divorced': 'বিচ্ছিন্ন', 'widowed': 'বিধবা/বিধুর' };
