    const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    const exportCsvBtn = document.getElementById('exportCsvBtn');

    function getSelectedAppIds() {
        return Array.from(document.querySelectorAll('#sonodTableBody .row-checkbox:checked')).map(cb => cb.value);
    }

    function updateBulkBar() {
        const count = getSelectedAppIds().length;
        if (selectedCountEl) selectedCountEl.textContent = count;
        if (bulkActionsBar) bulkActionsBar.style.display = count > 0 ? '' : 'none';
        if (selectAllApps) {
            const allCbs = document.querySelectorAll('#sonodTableBody .row-checkbox');
            const checked = document.querySelectorAll('#sonodTableBody .row-checkbox:checked');
            selectAllApps.checked = allCbs.length > 0 && checked.length === allCbs.length;
            selectAllApps.indeterminate = checked.length > 0 && checked.length < allCbs.length;
        }
    }

    if (selectAllApps) {
        selectAllApps.addEventListener('change', function() {
            document.querySelectorAll('#sonodTableBody .row-checkbox').forEach(cb => { cb.checked = selectAllApps.checked; });
            updateBulkBar();
        });
    }

    document.getElementById('sonodTableBody').addEventListener('change', function(e) {
        if (e.target.classList.contains('row-checkbox')) updateBulkBar();
    });

    if (clearSelectionBtn) {
        clearSelectionBtn.addEventListener('click', function() {
            document.querySelectorAll('#sonodTableBody .row-checkbox').forEach(cb => { cb.checked = false; });
            if (selectAllApps) { selectAllApps.checked = false; selectAllApps.indeterminate = false; }
            updateBulkBar();
        });
    }

