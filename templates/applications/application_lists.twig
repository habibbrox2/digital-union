    photo.src = d.applicant_photo ? (d.applicant_photo.startsWith('/') ? d.applicant_photo : '/' + d.applicant_photo) : '/assets/images/default-user.png';

    // Basic info
    document.getElementById('approveModalName').textContent = `${d.name_bn || '—'}`;
    document.getElementById('approveModalNameEn').textContent = d.name_en || '—';
    document.getElementById('approveModalFather').textContent = `${d.father_name_bn || '—'} (${d.father_name_en || ''})`;
    document.getElementById('approveModalMother').textContent = `${d.mother_name_bn || '—'} (${d.mother_name_en || ''})`;
