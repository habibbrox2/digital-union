    function updatePagination(totalPages, page) {
        var pagination = document.getElementById('pagination');
        pagination.innerHTML = '';

        // Add Previous button
        if (page > 1) {
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item"><button class="page-link" data-page="${page - 1}"><i class="fas fa-chevron-left"></i></button></li>`);
        } else {
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-left"></i></span></li>`);
        }

        // Add page numbers
        var maxPagesToShow = 5;
        var startPage = Math.max(1, page - Math.floor(maxPagesToShow / 2));
        var endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);

        if (endPage - startPage + 1 < maxPagesToShow) {
            startPage = Math.max(1, endPage - maxPagesToShow + 1);
        }

        if (startPage > 1) {
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item"><button class="page-link" data-page="1">1</button></li>`);
            if (startPage > 2) {
                pagination.insertAdjacentHTML('beforeend', `<li class="page-item disabled"><span class="page-link">...</span></li>`);
            }
        }

        for (var i = startPage; i <= endPage; i++) {
            var activeClass = i === page ? 'active' : '';
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item ${activeClass}"><button class="page-link" data-page="${i}">${i}</button></li>`);
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                pagination.insertAdjacentHTML('beforeend', `<li class="page-item disabled"><span class="page-link">...</span></li>`);
            }
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`);
        }

        // Add Next button
        if (page < totalPages) {
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item"><button class="page-link" data-page="${page + 1}"><i class="fas fa-chevron-right"></i></button></li>`);
        } else {
            pagination.insertAdjacentHTML('beforeend', `<li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-right"></i></span></li>`);
        }
    }

