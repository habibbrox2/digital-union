        otSelect.innerHTML = '<option value="">-- নির্বাচন করুন --</option>';
        (result.ownership_types || []).forEach(ot => {
            const selected = ot.id == (bm?.ownership_type_id || '') ? 'selected' : '';
            otSelect.innerHTML += `<option value="${ot.id}" ${selected}>${ot.ownership_name_bn || ot.ownership_name_en || ''}</option>`;
        });
        // Populate business types
        const btSelect = document.getElementById('modal_business_type_id');
        btSelect.innerHTML = '<option value="">-- নির্বাচন করুন --</option>';
        (result.business_types || []).forEach(bt => {
            const selected = bt.id == (bm?.business_type_id || '') ? 'selected' : '';
            btSelect.innerHTML += `<option value="${bt.id}" ${selected}>${bt.business_name_bn || bt.business_name_en || ''}</option>`;
        });

        // Populate trade fee fields
        document.getElementById('modal_license_fee').value = bm?.license_fee ?? '';
        document.getElementById('modal_vat_amount').value = bm?.vat_amount ?? '';
        document.getElementById('modal_occupation_tax').value = bm?.occupation_tax ?? '';
        document.getElementById('modal_income_tax').value = bm?.income_tax ?? '';
        document.getElementById('modal_signboard_tax').value = bm?.signboard_tax ?? '';
        document.getElementById('modal_surcharge').value = bm?.surcharge ?? '';
        // Calculate total fee
        const feeFields = ['modal_license_fee', 'modal_vat_amount', 'modal_occupation_tax', 'modal_income_tax', 'modal_signboard_tax', 'modal_surcharge'];
        let totalFee = 0;
        feeFields.forEach(fId => {
            const val = parseFloat(document.getElementById(fId)?.value) || 0;
            totalFee += val;
        });
        document.getElementById('modal_total_fee').value = totalFee.toFixed(2);

        // License number field
        const licenseInput = document.getElementById('modal_license_number');
        const licenseDigitCount = document.getElementById('modalLicenseDigitCount');
        const licenseStatusIcon = document.getElementById('modal_license_status_icon');
        const licenseStatusText = document.getElementById('modal_license_status_text');
        const licenseAvailMsg = document.getElementById('modal_license_availability_msg');
        licenseInput.value = d.sonod_number || result.license_number || ''; 
        // Live counter for license digits
        licenseInput.oninput = function() {
            const digits = this.value.replace(/\D/g, '').slice(0, 17);
            this.value = digits;
            const len = digits.length;
            licenseDigitCount.textContent = `সংখ্যা: ${len}/17`;
            licenseDigitCount.className = len === 17 ? 'form-text text-success' : 'form-text text-danger';
            // Show availability status when 17 digits entered
            if (len === 17) {
                licenseStatusIcon.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
                licenseStatusText.textContent = 'উপলব্ধ';
                licenseStatusText.className = 'input-group-text bg-light text-success fw-semibold small';
                licenseInput.className = 'form-control form-control-sm is-valid';
                licenseAvailMsg.textContent = '✅ এই লাইসেন্স নম্বরটি ব্যবহার করা যাবে।';
                licenseAvailMsg.className = 'form-text text-success';
            } else {
                licenseStatusIcon.innerHTML = '';
                licenseStatusText.textContent = '';
                licenseStatusText.className = 'input-group-text bg-light small fw-semibold';
                licenseInput.className = 'form-control form-control-sm';
                licenseAvailMsg.textContent = '';
                licenseAvailMsg.className = 'form-text';
            }
        };
        licenseInput.oninput(); // trigger initial count
    } else {
        tradeFields.style.display = 'none';
        licenseSection.style.display = 'none';
    }

    // Show/hide trade sync button


    initModalDatepickers();

    // Show content, hide loading
    document.getElementById('approveModalLoading').style.display = 'none';
    document.getElementById('approveModalContent').style.display = 'block';
}

function getModalToday() {
    const now = new Date();
    return String(now.getDate()).padStart(2, '0') + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + now.getFullYear();
}

function normalizeModalDate(value) {
    const raw = String(value || '').trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
        const parts = raw.split('-');
        return parts[2] + '-' + parts[1] + '-' + parts[0];
    }
    return raw;
}

function destroyModalDatepickers() {
    ['modal_verification_date', 'modal_approval_date'].forEach(function(id) {
        const input = document.getElementById(id);
        if (input && input.datepickerInstance) {
            input.datepickerInstance.destroy();
            input.datepickerInstance = null;
        }
    });
}

function initModalDatepickers() {
    if (typeof CompactDatepicker !== 'function') return;
    ['modal_verification_date', 'modal_approval_date'].forEach(function(id) {
        const input = document.getElementById(id);
        if (!input) return;
        if (input.datepickerInstance) {
            input.datepickerInstance.destroy();
            input.datepickerInstance = null;
        }
        const datepicker = new CompactDatepicker(input);

        // Prevent selectDate() from reopening the popup via the input focus handler.
        const selectDate = datepicker.selectDate.bind(datepicker);
        datepicker.selectDate = function(date) {
            const originalFocus = input.focus;
            input.focus = function() {};
            try {
                return selectDate(date);
            } finally {
                input.focus = originalFocus;
            }
        };

        // Override the input focus handler to prevent datepicker from opening
        // while the modal is closing (Bootstrap shifts focus during hide animation).
        const origShow = datepicker.showDatepicker.bind(datepicker);
        datepicker.showDatepicker = function() {
            if (approveModalIsClosing) return;
            origShow();
        };

        input.datepickerInstance = datepicker;
    });
}

function populateMemberDropdown(selectId, unionMembers) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    sel.innerHTML = '<option value="">-- নির্বাচন করুন --</option>';
    if (!unionMembers || typeof unionMembers !== 'object') return;
    for (const roleId in unionMembers) {
        const group = unionMembers[roleId];
        if (!group || !group.members) continue;
        let optgroup = `<optgroup label="${group.role_name || 'Unknown'}">`;
        group.members.forEach(m => {
            optgroup += `<option value="${m.user_id}" data-name-bn="${m.name_bn || ''}" data-name-en="${m.name_en || ''}" data-role-id="${roleId}" data-ward-no="${m.ward_no || ''}" data-wards="${m.ward_no || ''}">${m.name_bn || ''}${m.name_en ? ' (' + m.name_en + ')' : ''} - 📱 ${m.phone || ''}${m.ward_no ? ' | ওয়ার্ড: ' + m.ward_no : ''}</option>`;
        });
        optgroup += '</optgroup>';
        sel.innerHTML += optgroup;
    }
}

