    // Debounce utility for the live search input (with cancel support)
    function debounce(fn, delay) {
        let timer;
        function debounced(...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
        }
        debounced.cancel = function () {
            clearTimeout(timer);
        };
        return debounced;
    }

    function runSearch() {
        currentPage = 1;
        currentSearch = document.getElementById('liveSearch').value;
        fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
    }

    // Show/hide the clear (×) button based on input content
    document.getElementById('liveSearch').addEventListener('input', function () {
        document.getElementById('clearSearch').style.display = this.value.length > 0 ? '' : 'none';
    });
    // Debounced live search — fires 300ms after the user pauses typing.
    // Skips keys that don't change the value (arrows, Shift, etc.).
    var debouncedSearch = debounce(function () {
        if (document.getElementById('liveSearch').value === currentSearch) return;
        runSearch();
    }, 300);
    document.getElementById('liveSearch').addEventListener('keyup', debouncedSearch);

    // Clear button resets the search immediately (and cancels any pending timer)
    document.getElementById('clearSearch').addEventListener('click', function () {
        var liveSearchEl = document.getElementById('liveSearch');
        liveSearchEl.value = '';
        liveSearchEl.focus();
        document.getElementById('clearSearch').style.display = 'none';
        debouncedSearch.cancel();
        runSearch();
    });

    // Handle sortable header clicks via delegation
    document.addEventListener('click', function (e) {
        var sortableTh = e.target.closest('th.sortable');
        if (!sortableTh) return;
        var sortBy = sortableTh.dataset.sortBy;
        var sortOrder = sortableTh.dataset.sortOrder;

        // Toggle sort order
        if (sortBy === currentSortBy) {
            sortOrder = (currentSortOrder === 'asc') ? 'desc' : 'asc';
        } else {
            // New column, reset to ascending
            sortOrder = 'asc';
        }

        // Update data attributes for next click
        sortableTh.dataset.sortOrder = sortOrder;

        // Update current sort states
        currentSortBy = sortBy;
        currentSortOrder = sortOrder;

        // Reset all sort icons
        document.querySelectorAll('th.sortable i').forEach(function(icon) {
            icon.classList.remove('fa-sort-up', 'fa-sort-down');
            icon.classList.add('fa-sort');
        });
        // Update current column's icon
        var icon = sortableTh.querySelector('i');
        if (icon) {
            icon.classList.remove('fa-sort');
            icon.classList.add(sortOrder === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
        }

        currentPage = 1;
        fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
    });

