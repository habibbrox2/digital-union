{# applications/application_lists.twig #}

{% extends "layout.twig" %}

{% block title %}{{title}}{% endblock %}

{% block header_title %}{{header_title}}{% endblock %}

{% block content %}

{% include 'components/sweetAlert.twig' %}
{% include 'components/application_details_modal.twig' %}
{% include 'components/preview_modal.twig' %}
<div class="container my-5 px-4">
    <div id="message"></div>

    <!-- Search Applicant Card -->
    <div class="section-card section-appear mb-4 card-appear">
        <div class="section-header-icon text-primary">
            <i class="bi bi-search"></i>
        </div>
        <h6 class="section-title text-primary">
            <i class="bi bi-person-search"></i> আবেদনকারী খুঁজুন
        </h6>
        <form id="search-applicant-form" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-secondary"></i></span>
                    <input type="text" id="applicant_id_search" class="form-control input-enhanced" placeholder="আবেদনকারীর আইডি লিখুন...">
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" id="search-btn" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> খুঁজুন
                </button>
            </div>
        </form>

        <div id="reuse-options" class="mt-4" style="display:none;">
            <hr>
            <div id="reuse-links" class="d-flex flex-wrap gap-2"></div>
        </div>
    </div>

    <!-- Header: Title + Filters -->
    <div class="section-card section-appear mb-4">
        <div class="section-header-icon text-success">
            <i class="bi bi-file-earmark-text"></i>
        </div>
        <h6 class="section-title text-primary d-flex flex-wrap justify-content-between align-items-center">
            <span><i class="bi bi-file-alt"></i> সকল {{certificate_type_bn}} <small class="text-muted ms-2" id="totalCount">(মোট: 0)</small></span>
            <div class="d-flex gap-2">
                {% if is_superadmin %}
                <div class="input-group input-group-sm" style="max-width:200px;">
                    <label class="input-group-text bg-white small" for="unionFilter">ইউনিয়ন</label>
                    <select class="form-select form-select-sm" id="unionFilter">
                        <option value="">সকল</option>
                        {% for u in unions %}
                            <option value="{{ u.union_id }}">{{ u.union_name_bn }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <a href="/{{ go_url }}/apply" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> নতুন আবেদন
                </a>
            </div>
        </h6>

        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-secondary"></i></span>
                    <input type="text" id="liveSearch" class="form-control input-enhanced" placeholder="{% if url_path == 'trade' %}ব্যবসার নাম/ধরন, মালিকের নাম বা সনদ নং দিন...{% else %}নাম বা সনদ/পরিচয়পত্র নং দিন...{% endif %}">
                    <button type="button" id="clearSearch" class="btn btn-outline-secondary" style="display:none;" title="সার্চ মুছুন" aria-label="সার্চ মুছুন">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <label class="input-group-text bg-white" for="statusFilter">অবস্থা</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">সব</option>
                        <option value="Pending">অপেক্ষমান</option>
                        <option value="Approved">অনুমোদিত</option>
                        <option value="Rejected">বাতিল</option>
                        <option value="On Hold">স্থগিত</option>
                        <option value="Active">সক্রিয়</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <label class="input-group-text bg-white" for="recordsPerPage">রেকর্ড</label>
                    <select class="form-select" id="recordsPerPage">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Bulk Actions Toolbar -->
    <div class="section-card section-appear mb-3" id="bulkActionsBar" style="display:none;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-pill px-3 py-2"><i class="bi bi-check2-square me-1"></i> <span id="selectedCount">0</span> টি নির্বাচিত</span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="clearSelectionBtn"><i class="bi bi-x-circle me-1"></i> নির্বাচন মুছুন</button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="exportCsvBtn"><i class="bi bi-filetype-csv me-1"></i> CSV ডাউনলোড</button>
                <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" id="bulkDeleteBtn"><i class="bi bi-trash3 me-1"></i> মুছুন</button>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="section-card section-appear">
        <div class="section-header-icon text-info">
            <i class="bi bi-table"></i>
        </div>
        <h6 class="section-title text-info">
            <i class="bi bi-list-ul"></i> আবেদনের তালিকা
        </h6>

        <!-- Auto-refresh bar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 py-2 px-3 rounded" id="autoRefreshBar" style="background:#f0f7ff;border:1px solid #d0e3f7;">
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="autoRefreshToggle" checked title="স্বয়ংক্রিয় রিফ্রেশ">
                    <label class="form-check-label small text-muted" for="autoRefreshToggle">স্বয়ংক্রিয় রিফ্রেশ</label>
                </div>
                <span class="text-muted small" id="autoRefreshCountdown"></span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small" id="lastUpdatedTime"></span>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="manualRefreshBtn" title="এখনই রিফ্রেশ করুন">
                    <i class="bi bi-arrow-clockwise me-1"></i> রিফ্রেশ
                </button>
            </div>
        </div>

        <div class="table-responsive rounded-3" style="position:relative;">
            <table class="table table-hover align-middle mb-0 table-enhanced">
                <thead class="table-primary text-center">
                    <tr>
                        <th style="width:40px;min-width:40px;" class="text-center">
                            <div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="selectAllApps" title="সব নির্বাচন করুন"></div>
                        </th>
                        <th class="sortable" data-sort-by="application_id" data-sort-order="desc" aria-sort="none">
                            সনদ/আবেদন নং <i class="fas fa-sort float-end"></i>
                        </th>
                        <th class="sortable" data-sort-by="apply_date" data-sort-order="asc" aria-sort="none">
                            আবেদনের তারিখ <i class="fas fa-sort float-end"></i>
                        </th>
                        <th class="sortable" data-sort-by="name_bn" data-sort-order="asc" aria-sort="none">
                            নাম <i class="fas fa-sort float-end"></i>
                        </th>
                        <th class="sortable" data-sort-by="identity_no" data-sort-order="asc" aria-sort="none">
                            পরিচয়পত্র নং <i class="fas fa-sort float-end"></i>
                        </th>
                        <th class="sortable" data-sort-by="status" data-sort-order="asc" aria-sort="none">
                            অবস্থা <i class="fas fa-sort float-end"></i>
                        </th>
                        <th>ঠিকানা</th>
                        <th>অ্যাকশন</th>
                    </tr>
                </thead>
                <tbody id="sonodTableBody" class="text-center">
                    <tr>
                            <td colspan="8" class="text-muted py-4" id="noDataRow" style="display: none;">
                            <i class="bi bi-info-circle me-2 text-secondary fs-5"></i> কোনো তথ্য পাওয়া যায়নি।
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Loading overlay shown during search/fetch -->
            <div id="searchLoading" role="status" aria-live="polite" style="display:none;position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,0.85);z-index:10;border-radius:0.5rem;">
                <div class="d-flex flex-column align-items-center justify-content-center gap-2 h-100">
                    <div class="spinner-border text-primary" role="status" style="width:2.5rem;height:2.5rem;">
                        <span class="visually-hidden">লোড হচ্ছে...</span>
                    </div>
                    <span class="text-muted fw-semibold">অনুসন্ধান করা হচ্ছে...</span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
            <span id="rangeSummary" class="text-muted small" aria-live="polite"></span>
            <nav aria-label="Pagination">
                <ul class="pagination justify-content-center mb-0" id="pagination"></ul>
            </nav>
        </div>
    </div>
</div>

<style>
#bulkActionsBar { border-left: 4px solid #0d6efd; animation: fadeIn 0.25s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
.form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
.form-check-input:focus { box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.25); }
/* Auto-refresh flash animation */
@keyframes flashUpdate { 0% { background-color: transparent; } 30% { background-color: #d4edda; } 100% { background-color: transparent; } }
.flash-update { animation: flashUpdate 1.5s ease; }
/* Refresh spinning icon */
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.spinning { animation: spin 1s linear infinite; display: inline-block; }
#autoRefreshBar { transition: opacity 0.3s ease; }
#autoRefreshBar.disabled { opacity: 0.5; }
</style>
{% block scripts %}
<script>
// IntersectionObserver for section animations
document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('appeared');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.section-appear').forEach(function(el) {
        observer.observe(el);
    });
});
</script>

<script>
document.getElementById('search-applicant-form').addEventListener('submit', function (e) {
    e.preventDefault();

    const applicantId = document.getElementById('applicant_id_search').value.trim();
    const reuseContainer = document.getElementById('reuse-options');
    const reuseLinks = document.getElementById('reuse-links');

    if (!applicantId) {
        reuseContainer.style.display = 'none';
        displayMessage('error', 'Applicant ID is required.');
        return;
    }

    const formData = new FormData();
    formData.append('applicant_id', applicantId);

    // ✅ CSRF TOKEN
    const csrfToken = window.getCsrfToken?.();
    if (csrfToken) {
        formData.append('csrf_token', csrfToken);
    }

    const certificate_type = '{{ url_path|e('js') }}';

    fetch(`/api/applications/${certificate_type}/applicant`, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.querySelectorAll('.reuse-header-row').forEach(el => el.remove());

            const headerRow = document.createElement('div');
            headerRow.className = 'd-flex justify-content-between align-items-center mb-2 reuse-header-row';
            headerRow.innerHTML = `
                <h6 class="fw-semibold text-muted mb-0">নতুন আবেদন তৈরি করুন:</h6>
                <a href="/applications/of/${applicantId}" 
                   class="btn btn-sm btn-outline-primary">
                    সকল আবেদন দেখুন
                </a>
            `;

            reuseLinks.innerHTML = '';
            reuseLinks.parentNode.insertBefore(headerRow, reuseLinks);

            data.certificate_types.forEach(function (type) {
                const link = document.createElement('a');
                link.href = `/applications/${type.type_url}/reapply/${applicantId}`;
                link.className = 'btn btn-outline-secondary reuse-link';
                link.textContent = type.name_bn;
                reuseLinks.appendChild(link);
            });

            reuseContainer.style.display = '';

        } else {
            reuseContainer.style.display = 'none';
            displayMessage('error', data.message || 'Applicant not found.');
        }
    })
    .catch(error => {
        reuseContainer.style.display = 'none';
        displayMessage('error', 'Something went wrong.');
        console.error('Fetch Error:', error);
    });
});
</script>



<script>
document.addEventListener('DOMContentLoaded', function () {

    let currentPage = 1;
    let currentSearch = '';
    let currentSortBy = 'apply_date'; // Default sort column 'apply_date'
    let currentSortOrder = 'desc'; // Default sort order
    let recordsPerPage = document.getElementById('recordsPerPage').value; 
    let currentUnion = '';
    let currentStatus = '';
    /* ===============================
       Bangla Helpers
    =============================== */
    function toBanglaNumber(input) {
        if (input === null || input === undefined) return '';
        const bnDigits = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
        return input.toString().replace(/\d/g, d => bnDigits[d]);
    }

    function formatDateBN(dateString) {
        if (!dateString) return '—';
        const date = new Date(dateString);
        const months = [
            'জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন',
            'জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'
        ];
        return `${toBanglaNumber(date.getDate())} ${months[date.getMonth()]}, ${toBanglaNumber(date.getFullYear())}`;
    }

    // Loading overlay (counter handles overlapping requests)
    let tableLoadingCount = 0;
    function showTableLoading() {
        tableLoadingCount++;
        var el = document.getElementById('searchLoading');
        if (el) { el.style.display = ''; el.style.opacity = '1'; }
    }
    function hideTableLoading() {
        tableLoadingCount = Math.max(0, tableLoadingCount - 1);
        if (tableLoadingCount === 0) {
            var el = document.getElementById('searchLoading');
            if (el) { el.style.opacity = '0'; setTimeout(function(){ el.style.display = 'none'; }, 120); }
        }
    }

    function fetchApplications(page = 1, search = '', sortBy = 'application_id', sortOrder = 'desc', limit = 10, union = '', status = '') {
        var type = '{{ url_path |e('js') }}'; // সার্টিফিকেট টাইপ URL থেকে নেওয়া
        var url = "/applications/" + type + "/fetch_all";
        showTableLoading();

        var formData = new URLSearchParams();
        formData.append('page', page);
        formData.append('search', search);
        formData.append('sort_by', sortBy);
        formData.append('sort_order', sortOrder);
        formData.append('records_per_page', limit);
        formData.append('union_id', union);
        formData.append('status', status);

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(function(r) { return r.json(); })
        .then(function (response) {
                hideTableLoading();
                var tbody = document.getElementById('sonodTableBody');
                tbody.innerHTML = '';

                // যদি কোনো ডেটা না থাকে
                if (!response.data || response.data.length === 0) {
                    tbody.insertAdjacentHTML('beforeend', '<tr><td colspan="8" class="text-center">কোনো আবেদন পাওয়া যায়নি।</td></tr>');
                    updateRangeSummary(page, limit, response.total_records, 0);
                    return;
                }

                // প্রতিটি আবেদন লুপ করা
                response.data.forEach(function (application, index) {

                    let address = formatAddress(application);
                    let formattedDate = formatDateBN(application.apply_date);

                    let shortApplicationId = toBanglaNumber(shortenNumber(application.application_id));
                    let shortSonodNo = toBanglaNumber(shortenNumber(application.sonod_number));
                    let shortApplicantId = application.applicant_id
                        ? toBanglaNumber(shortenNumber(application.applicant_id))
                        : '';

                    let applicationSonodNo = `
                        ${application.applicant_id ? `
                        <small class="text-muted d-block mb-1">
                            আবেদনকারী আইডি:
                            <span style="max-width:80px;cursor:pointer"
                                  class="text-truncate d-inline-block"
                                  data-bs-toggle="tooltip"
                                  title="${application.applicant_id}">
                                ${shortApplicantId}
                            </span>
                        </small>` : ''}

                        <small class="text-muted d-block mb-1">আবেদন আইডি:</small>

                        <strong class="d-inline-block text-truncate"
                                style="max-width:120px;cursor:pointer"
                                data-bs-toggle="tooltip"
                                title="${application.application_id}">
                            ${shortApplicationId}
                        </strong><br>

                        <small class="d-inline-block text-truncate"
                               style="max-width:70px;cursor:pointer"
                               data-bs-toggle="tooltip"
                               title="${application.sonod_number || ''}">
                            সনদ নং:<br>${shortSonodNo}
                        </small>
                    `;

                    let identityNoFull = application.nid || application.birth_id || application.passport_no || "";
                    let identityNo = `
                        <span class="text-truncate d-inline-block"
                              style="max-width:60px;cursor:pointer"
                              data-bs-toggle="tooltip"
                              title="${identityNoFull}">
                            ${toBanglaNumber(shortenNumber(identityNoFull))}
                        </span>
                    `;

                    let applicantFullName = '';
                    let certificateType = '{{ url_path |e('js') }}';

                    if (certificateType === 'trade' && application.business_name_bn) {
                        applicantFullName = `
                            <strong>${application.business_name_bn}</strong><br>
                            <small>মালিকের নাম: ${application.name_bn}</small>
                        `;
                    } else {
                        applicantFullName = `<strong>${application.name_bn}</strong>`;
                    }

                    if (application.father_name_bn)
                        applicantFullName += `<br><small>পিতা: ${application.father_name_bn}</small>`;
                    if (application.mother_name_bn)
                        applicantFullName += `<br><small>মাতা: ${application.mother_name_bn}</small>`;

                    let statusBadge = getStatusBadge(application.status);

                    tbody.insertAdjacentHTML('beforeend', `
                        <tr data-app-id="${application.application_id}" data-sonod="${application.sonod_number || ''}" data-name="${(application.name_bn || '').replace(/"/g, '&quot;')}" data-status="${application.status}">
                            <td class="text-center"><div class="form-check mb-0"><input class="form-check-input row-checkbox" type="checkbox" value="${application.application_id}"></div></td>
                            <td>${applicationSonodNo}</td>
                            <td>${formattedDate}</td>
                            <td>${applicantFullName}</td>
                            <td>${identityNo}</td>
                            <td>${statusBadge}</td>
                            <td>${address}</td>
                            <td>${getActionButtons(application)}</td>
                        </tr>
                    `);
                });


                // পেজিনেশন আপডেট করা
                updatePagination(response.total_pages, page);
                // Initialize Bootstrap tooltips on new elements
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
                    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                        new bootstrap.Tooltip(el, { trigger: 'hover click' });
                    }
                });
                // মোট আবেদন সংখ্যা আপডেট করা
                var totalCountEl = document.getElementById('totalCount');
                if (response.total_records !== undefined) {
                    totalCountEl.textContent = `(মোট: ${response.total_records})`;
                } else {
                    totalCountEl.textContent = '(মোট: 0)';
                }
                // দৃশ্যমান পরিসর সারসংক্ষেপ (যেমন: মোট ২৪০টির মধ্যে ১–১০ দেখানো হচ্ছে)
                updateRangeSummary(page, limit, response.total_records, response.data ? response.data.length : 0);

                // Reset bulk selection after fetch
                if (typeof updateBulkBar === 'function') updateBulkBar();

                // Address expand/collapse
                document.querySelectorAll('.address-block').forEach(function(block) {
                    block.setAttribute('aria-expanded', 'false');
                    block.style.height = '40px';
                    block.style.overflow = 'hidden';
                });
                // Initialize address block event listeners
                document.removeEventListener('click', handleAddressBlockClick);
                document.addEventListener('click', handleAddressBlockClick);
                document.removeEventListener('keydown', handleAddressBlockKeydown);
                document.addEventListener('keydown', handleAddressBlockKeydown);
   
            })
            .catch(function(error) {
                hideTableLoading();
                displayMessage('error', `আবেদন আনতে ব্যর্থ হয়েছে। ত্রুটি: ${error.message || error}`);
            });
    }

    // ─── Address block expand/collapse (DOM-level handlers) ───
    function collapseAllAddress(except) {
        document.querySelectorAll('.address-block[aria-expanded="true"]').forEach(function(block) {
            if (!except || block !== except) {
                block.setAttribute('aria-expanded', 'false');
                block.style.transition = 'height 0.25s ease';
                block.style.height = '40px';
                block.style.overflow = 'hidden';
            }
        });
    }
    function handleAddressBlockClick(e) {
        var block = e.target.closest('.address-block');
        if (!block) return;
        if (e.target.matches('a,button,input,select,textarea,label')) return;
        e.stopPropagation();
        var expanded = block.getAttribute('aria-expanded') === 'true';
        if (expanded) {
            block.setAttribute('aria-expanded', 'false');
            block.style.transition = 'height 0.25s ease';
            block.style.height = '40px';
            block.style.overflow = 'hidden';
        } else {
            collapseAllAddress(block);
            block.style.height = 'auto';
            var fullHeight = block.scrollHeight;
            block.style.height = '40px';
            block.setAttribute('aria-expanded', 'true');
            block.style.overflow = 'visible';
            block.style.transition = 'height 0.25s ease';
            block.style.height = fullHeight + 'px';
            setTimeout(function(){ block.style.height = 'auto'; }, 250);
        }
    }
