            var timeParts = rawTime.split(':');
            rawTime = timeParts[0] + ':' + timeParts[1];
        }
        issueTimeInput.value = rawTime;
    }
    document.getElementById('modal_approval_note').value = a.approval_note || 'আবেদনটি অনুমোদিত হলো।';
    document.getElementById('modal_certificate_fee').value = a.certificate_fee || '';
    document.getElementById('modal_payment_method').value = a.payment_method || 'Cash';
    document.getElementById('modal_payment_status').value = a.payment_status || 'Unpaid';

    // View link
    const viewLink = document.getElementById('modalViewLink');
    viewLink.href = `/applications/${certType}/approve/${d.application_id}`;

    // Trade-specific fields
    const tradeFields = document.getElementById('modalTradeFields');
    const licenseSection = document.getElementById('modalLicenseSection');
    if (certType === 'trade') {
        tradeFields.style.display = 'block';
        licenseSection.style.display = 'block';
