// Helper: cleanup modal backdrop & body class after any modal closes
function cleanupModalBackdrop() {
    // Blur any focused element inside a modal to avoid aria-hidden warning
    if (document.activeElement && document.activeElement.closest('.modal')) {
        document.activeElement.blur();
    }
    document.body.classList.remove('modal-open');
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
}

// Reset approve modal to loading state (so re-opening shows fresh state)
function resetApproveModal() {
    // Destroy any open datepickers first
    destroyModalDatepickers();
    const loadingEl = document.getElementById('approveModalLoading');
    const contentEl = document.getElementById('approveModalContent');
    if (loadingEl) loadingEl.style.display = 'block';
    if (contentEl) contentEl.style.display = 'none';
    // Reset form fields
    const form = document.getElementById('approveModalForm');
    if (form) form.reset();
    // Reset issue_time to current time
    const issueTime = document.getElementById('modal_issue_time');
    if (issueTime) {
        const now = new Date();
        issueTime.value = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
    }
    // Reset trade fields
    const tradeFields = document.getElementById('modalTradeFields');
    if (tradeFields) tradeFields.style.display = 'none';
    // Reset trade fee fields in certificate fee section
    // Reset trade license fee section
    const tradeFeeSection = document.getElementById('modalTradeFeeSection');
    if (tradeFeeSection) tradeFeeSection.style.display = 'none';
    // Reset certificate fields
    const certFields = document.getElementById('modalCertificateFields');
    if (certFields) certFields.style.display = 'none';
    // Reset license section
    const licenseSection = document.getElementById('modalLicenseSection');
    if (licenseSection) licenseSection.style.display = 'none';
    // Reset trade fee fields
    ['modal_license_fee','modal_vat_amount','modal_occupation_tax','modal_income_tax','modal_signboard_tax','modal_surcharge','modal_total_fee'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    const licenseInput = document.getElementById('modal_license_number');
    if (licenseInput) {
        licenseInput.value = '';
        licenseInput.className = 'form-control form-control-sm';
    }
    const licenseDigitCount = document.getElementById('modalLicenseDigitCount');
    if (licenseDigitCount) licenseDigitCount.textContent = 'সংখ্যা: 0/17';
    const licenseStatusIcon = document.getElementById('modal_license_status_icon');
    if (licenseStatusIcon) licenseStatusIcon.innerHTML = '';
    const licenseStatusText = document.getElementById('modal_license_status_text');
    if (licenseStatusText) licenseStatusText.textContent = '';
    const licenseAvailMsg = document.getElementById('modal_license_availability_msg');
    if (licenseAvailMsg) licenseAvailMsg.textContent = '';
}

// Flag to prevent datepicker re-opening during modal close
var approveModalIsClosing = false;

// Cleanup after approve modal closes
var approveModalEl = document.getElementById('approveModal');
if (approveModalEl) {
    // Immediately destroy datepickers when modal starts hiding
    // (before Bootstrap shifts focus, which can re-open them)
    approveModalEl.addEventListener('hide.bs.modal', function() {
        approveModalIsClosing = true;
        destroyModalDatepickers();
        // Blur any focused element to prevent focus-related re-opening
        if (document.activeElement && document.activeElement.closest('#approveModal')) {
            document.activeElement.blur();
        }
    });
    approveModalEl.addEventListener('hidden.bs.modal', function() {
        destroyModalDatepickers();
        cleanupModalBackdrop();
        setTimeout(function() {
            resetApproveModal();
            approveModalIsClosing = false;
        }, 300);
    });
}

// Cleanup after approved modal closes
var approvedModalElCleanup = document.getElementById('approvedModal');
if (approvedModalElCleanup) {
    approvedModalElCleanup.addEventListener('hidden.bs.modal', function() {
        cleanupModalBackdrop();
    });
}

// Open approve modal via delegation
document.addEventListener('click', async function(e) {
    var btn = e.target.closest('.approveBtn');
    if (!btn) return;
    var appId = btn.dataset.id;
    var certType = btn.dataset.type;
    if (!appId || !certType) return;

    // Show modal with loading state
    const modalEl = document.getElementById('approveModal');
    const loadingEl = document.getElementById('approveModalLoading');
    const contentEl = document.getElementById('approveModalContent');
    if (loadingEl) loadingEl.style.display = 'block';
    if (contentEl) contentEl.style.display = 'none';
    if (modalEl) {
        const bsModal = new bootstrap.Modal(modalEl);
        bsModal.show();
    }

    try {
        const response = await fetch(`/api/applications/${certType}/approve-data/${appId}`);
        const result = await response.json();
        if (result.status !== 'success') throw new Error(result.message || 'Failed to load data');
        populateApproveModal(result, result.data.certificate_type || certType);
    } catch (err) {
        console.error('Approve modal error:', err);
        Swal.fire('❌ ত্রুটি', 'অনুমোদন তথ্য লোড করা যায়নি।', 'error');
        var bsModal2 = bootstrap.Modal.getInstance(modalEl);
        if (bsModal2) bsModal2.hide();
    }
});

function populateApproveModal(result, certType) {
    const d = Object.assign({}, result.data._all_fields || {}, result.data);
    const a = result.approval || {};
    const bm = result.business_meta || d.business_meta || {};

    // Set header
    document.getElementById('approveModalLabel').textContent = (d.certificate_type_bn || certType) + ' অনুমোদন';
    document.getElementById('approveModalSubtitle').textContent = `আবেদন আইডি: ${d.application_id}` + (certType === 'trade' && bm.business_name_bn ? ` | ব্যবসা: ${bm.business_name_bn}` : '');

    // Status badge
    const statusBadge = document.getElementById('approveModalStatusBadge');
    const statusMap = {
        'Pending': { cls: 'bg-warning text-dark', text: 'অপেক্ষমান' },
        'Approved': { cls: 'bg-success text-white', text: 'অনুমোদিত' },
        'Rejected': { cls: 'bg-danger text-white', text: 'বাতিলকৃত' },
        'On Hold': { cls: 'bg-secondary text-white', text: 'স্থগিত' }
    };
    const s = statusMap[d.status] || { cls: 'bg-secondary', text: d.status };
    statusBadge.className = `badge rounded-pill px-3 py-1 fs-6 ${s.cls}`;
    statusBadge.textContent = s.text;

    // Photo
