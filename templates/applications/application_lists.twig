// Validate trade approval fields
function validateModalTradeFields() {
    const certType = document.getElementById('modal_certificate_type').value;
    if (certType !== 'trade') return true;

    const fiscalYear = document.getElementById('modal_fiscal_year')?.value?.trim() || '';
    const ownershipTypeId = document.getElementById('modal_ownership_type_id')?.value?.trim() || '';
    const businessTypeId = document.getElementById('modal_business_type_id')?.value?.trim() || '';

    if (!fiscalYear) {
        Swal.fire('❌ ত্রুটি', 'অনুগ্রহ করে সনদের অর্থবছর নির্বাচন করুন।', 'error');
        return false;
    }
    if (!ownershipTypeId) {
        Swal.fire('❌ ত্রুটি', 'অনুগ্রহ করে মালিকানার ধরণ নির্বাচন করুন।', 'error');
        return false;
    }
    if (!businessTypeId) {
        Swal.fire('❌ ত্রুটি', 'অনুগ্রহ করে ব্যবসার ধরণ নির্বাচন করুন।', 'error');
        return false;
    }
    return true;
}

// Form submission - shows approved modal with certificate links on success
var approveModalFormEl = document.getElementById('approveModalForm');
if (approveModalFormEl) {
    approveModalFormEl.addEventListener('submit', function(e) {
    e.preventDefault();
    var form = this;
    const certType = document.getElementById('modal_certificate_type').value;
    const appId = document.getElementById('modal_application_id').value;
    const btn = document.getElementById('modalApproveBtn');

    // Validate approval date
    if (!document.getElementById('modal_approval_date')?.value.trim()) {
        Swal.fire('❌ ত্রুটি', 'অনুগ্রহ করে অনুমোদনের তারিখ নির্বাচন করুন।', 'error');
        return;
    }

    // Validate trade-specific fields
    if (!validateModalTradeFields()) return;

    // For trade: validate license number from modal field
    if (certType === 'trade') {
        const licenseInput = document.getElementById('modal_license_number');
        const licenseNumber = (licenseInput?.value || '').trim();
        const digits = licenseNumber.replace(/\D/g, '');
        if (!/^\d{17}$/.test(digits)) {
            Swal.fire('❌ ত্রুটি', 'লাইসেন্স নম্বর অবশ্যই ১৭ সংখ্যার হতে হবে।', 'error');
            return;
        }
        // Validate trade-specific fields
        if (!validateModalTradeFields()) return;
        processApprovalFromModal(form, certType, appId, btn, digits);
    } else {
        processApprovalFromModal(form, certType, appId, btn, null);
    }
});
}

function processApprovalFromModal(form, certType, appId, btn, licenseNumber) {
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> প্রসেসিং...';

    const fd = new FormData(form);
    fd.delete('license_number');
    if (licenseNumber) fd.set('license_number', licenseNumber);

    fetch(`/applications/${certType}/approve/${appId}`, {
        method: 'POST',
        body: new URLSearchParams(fd)
    })
    .then(r => r.json())
    .then(res => {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        if (res.status === 'success') {
            // Close approve modal first
            const approveModal = bootstrap.Modal.getInstance(document.getElementById('approveModal'));
            if (approveModal) approveModal.hide();
            // After approve modal closes, show approved modal with certificate links
            setTimeout(() => {
                showApprovedModalFromList(res, certType, licenseNumber);
            }, 400);
        } else {
            Swal.fire('❌ ব্যর্থ', res.message || 'অনুমোদন ব্যর্থ হয়েছে।', 'error');
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        console.error('Approval error:', err);
        Swal.fire('❌ ত্রুটি', 'সার্ভারে সংযোগ করা যায়নি।', 'error');
    });
}

/**
 * Show approved modal with certificate download links (list page version)
 */
function showApprovedModalFromList(res, certType, licenseNumber) {
    try {
        const aId = res.application_id || document.getElementById('modal_application_id').value;
        const unionCode = res.union_code || '';
        const rmoCode = res.rmo_code || '';
        const cert = res.certificate_type || certType || '';
        const license = licenseNumber || res.sonod_number || res.license_number || '';
        const certBn = res.certificate_type_bn || cert || '';

        // Determine if this is an update (already approved)
        const isUpdate = res.is_update === true;

        // Update modal title
        const modalTitle = document.getElementById('approvedModalLabel');
        if (modalTitle) {
            modalTitle.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i> ${certBn} ${isUpdate ? 'হালনাগাদ' : 'অনুমোদিত'}`;
        }

        // Update modal subtitle
        const modalSubtitle = document.getElementById('approvedModalSubtitle');
        if (modalSubtitle) {
            modalSubtitle.textContent = isUpdate ? 'অনুমোদনের তথ্য সফলভাবে হালনাগাদ করা হয়েছে' : 'আবেদনটি সফলভাবে অনুমোদিত হয়েছে';
        }

        // Update modal body texts
        const modalCongrats = document.getElementById('approvedModalCongrats');
        if (modalCongrats) {
            modalCongrats.textContent = isUpdate ? '✅ হালনাগাদ সম্পন্ন!' : 'অভিনন্দন!';
        }
        const modalBodyText = document.getElementById('approvedModalBodyText');
        if (modalBodyText) {
            modalBodyText.textContent = isUpdate
                ? 'অনুমোদনের তথ্য সফলভাবে হালনাগাদ করা হয়েছে। নিচের তথ্য ও অপশনগুলো দেখুন।'
                : 'আপনার আবেদন সফলভাবে অনুমোদিত হয়েছে। নিচের তথ্য ও অপশনগুলো দেখুন।';
        }

        // Set info values
        document.getElementById('approved_application_id').textContent = aId || '—';
        document.getElementById('approved_union_code').textContent = unionCode || '—';
        document.getElementById('approved_rmo_code').textContent = rmoCode || '—';
        document.getElementById('approved_certificate_type').textContent = certBn || '—';
        document.getElementById('approved_license_number').textContent = license || '—';

        // Set download/view links
        const downloadUrl = `/${cert}_verify/application/${aId}/${unionCode || 0}/${rmoCode || 0}`;
        const viewUrl = `/${cert}_verify/application/${aId}/${unionCode || 0}/0`;
        const certificateUrl = license ? `/application/${cert}/bangla/${license}` : '#';
        const certificateEnUrl = license ? `/application/${cert}/english/${license}` : '#';

        const dl = document.getElementById('approved_download_link');
        const vl = document.getElementById('approved_view_link');
        const cl = document.getElementById('approved_certificate_link');
        const clEn = document.getElementById('approved_certificate_en_link');
        if (dl) dl.href = downloadUrl;
        if (vl) vl.href = viewUrl;
        if (cl) cl.href = certificateUrl;
        if (clEn) clEn.href = certificateEnUrl;

        // Hide certificate links if no license number
        [cl, clEn].forEach(link => {
            if (link) {
                link.style.display = license ? '' : 'none';
            }
        });

        // New application button - go back to list
        const newBtn = document.getElementById('approved_new_btn');
        if (newBtn) {
            // Remove old listeners by cloning
            const newBtnClone = newBtn.cloneNode(true);
            newBtn.parentNode.replaceChild(newBtnClone, newBtn);
            newBtnClone.addEventListener('click', function() {
                if (typeof window.refreshApplicationList === 'function') window.refreshApplicationList();
                else location.reload();
            });
        }

        // Show the approved modal
        const approvedModalEl = document.getElementById('approvedModal');
        if (approvedModalEl && typeof bootstrap !== 'undefined') {
            const approvedModal = new bootstrap.Modal(approvedModalEl);
            approvedModal.show();
        }
    } catch (e) {
        console.error('Error showing approved modal:', e);
        // Fallback: just reload
        Swal.fire({
            icon: 'success',
            title: '✅ সফল!',
            text: res.message || 'আবেদন সফলভাবে অনুমোদিত হয়েছে।',
            confirmButtonColor: '#28a745'
        }).then(() => { if (typeof window.refreshApplicationList === 'function') window.refreshApplicationList(); else location.reload(); });
    }
}

