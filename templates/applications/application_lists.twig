    if (exportCsvBtn) {
        exportCsvBtn.addEventListener('click', function() {
            const rows = document.querySelectorAll('#sonodTableBody tr[data-app-id]');
            if (!rows.length) { Swal.fire({ icon: 'info', title: 'তথ্য নেই', text: 'এক্সপোর্ট করার জন্য কোনও ডাটা নেই।', timer: 2000, showConfirmButton: false }); return; }
            const ids = getSelectedAppIds();
            const exportRows = ids.length ? Array.from(rows).filter(r => ids.includes(r.dataset.appId)) : Array.from(rows);
            const headers = ['সনদ নং', 'আবেদন তারিখ', 'নাম', 'পরিচয়পত্র নং', 'অবস্থা', 'ঠিকানা'];
            const csvRows = [headers.join(',')];
            exportRows.forEach(row => {
                const cells = Array.from(row.children).slice(2, -1).map(td => {
                    let val = td.textContent.trim().replace(/[\n\r]+/g, ' ').replace(/,/g, ';').replace(/"/g, '""');
                    return '"' + val + '"';
                });
                csvRows.push(cells.join(','));
            });
            const blob = new Blob(['\uFEFF' + csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'আবেদন_তালিকা_' + new Date().toISOString().slice(0, 10) + '.csv';
            link.click();
            URL.revokeObjectURL(link.href);
            Swal.fire({ icon: 'success', title: 'ডাউনলোড সম্পন্ন', text: `${exportRows.length} টি রেকর্ড CSV ফাইলে ডাউনলোড করা হয়েছে।`, timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
        });
    }

    fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage); // Initial fetch

    /* ===============================
       Auto-Refresh System
    =============================== */
    var autoRefreshInterval = null;
    var autoRefreshSeconds = 30;
    var autoRefreshCountdownVal = autoRefreshSeconds;
    var autoRefreshEnabled = true;
    var lastRefreshTimestamp = Date.now();

    var autoRefreshToggle = document.getElementById('autoRefreshToggle');
    var autoRefreshCountdownEl = document.getElementById('autoRefreshCountdown');
    var lastUpdatedTimeEl = document.getElementById('lastUpdatedTime');
    var manualRefreshBtn = document.getElementById('manualRefreshBtn');
    var autoRefreshBar = document.getElementById('autoRefreshBar');

    function formatTimeAgo(timestamp) {
        var diff = Math.floor((Date.now() - timestamp) / 1000);
        if (diff < 5) return 'এইমাত্র রিফ্রেশ হয়েছে';
        if (diff < 60) return toBanglaNumber(diff) + ' সেকেন্ড আগে রিফ্রেশ হয়েছে';
        if (diff < 3600) return toBanglaNumber(Math.floor(diff / 60)) + ' মিনিট আগে রিফ্রেশ হয়েছে';
        return toBanglaNumber(Math.floor(diff / 3600)) + ' ঘণ্টা আগে রিফ্রেশ হয়েছে';
    }

    function updateLastUpdatedTime() {
        if (lastUpdatedTimeEl) {
            lastUpdatedTimeEl.textContent = 'শেষ রিফ্রেশ: ' + formatTimeAgo(lastRefreshTimestamp);
        }
    }

    function startAutoRefreshCountdown() {
        stopAutoRefreshCountdown();
        autoRefreshCountdownVal = autoRefreshSeconds;
        if (autoRefreshCountdownEl) {
            autoRefreshCountdownEl.textContent = toBanglaNumber(autoRefreshCountdownVal) + ' সেকেন্ড পরে রিফ্রেশ';
        }
        autoRefreshInterval = setInterval(function() {
            autoRefreshCountdownVal--;
            if (autoRefreshCountdownVal <= 0) {
                // Perform silent refresh (no loading spinner)
                doAutoRefresh();
                autoRefreshCountdownVal = autoRefreshSeconds;
            }
            if (autoRefreshCountdownEl) {
                autoRefreshCountdownEl.textContent = toBanglaNumber(autoRefreshCountdownVal) + ' সেকেন্ড পরে রিফ্রেশ';
            }
        }, 1000);
    }

    function stopAutoRefreshCountdown() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
    }

    function doAutoRefresh() {
        // Use the existing fetchApplications but suppress loading overlay
        var type = '{{ url_path |e("js") }}';
        var url = '/applications/' + type + '/fetch_all';

        var formData = new URLSearchParams();
        formData.append('page', currentPage);
        formData.append('search', currentSearch);
        formData.append('sort_by', currentSortBy);
        formData.append('sort_order', currentSortOrder);
        formData.append('records_per_page', recordsPerPage);
        formData.append('union_id', currentUnion);
        formData.append('status', currentStatus);

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(function(r) { return r.json(); })
        .then(function(response) {
            lastRefreshTimestamp = Date.now();
            updateLastUpdatedTime();

            var tbody = document.getElementById('sonodTableBody');
            var existingRows = {};
            var existingRowEls = tbody.querySelectorAll('tr[data-app-id]');
            existingRowEls.forEach(function(row) {
                existingRows[row.dataset.appId] = row;
            });

            if (!response.data || response.data.length === 0) {
                if (existingRowEls.length > 0) {
                    // Data was cleared — do a full refresh
                    fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
                }
                return;
            }

            var newIds = response.data.map(function(a) { return String(a.application_id); });

            // Check if any rows were added or removed
            var rowsChanged = false;
            Object.keys(existingRows).forEach(function(id) {
                if (newIds.indexOf(id) === -1) rowsChanged = true;
            });
            if (newIds.length !== existingRowEls.length) rowsChanged = true;

            if (rowsChanged) {
                // Full re-render for structural changes
                fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
                return;
            }

            // Diff-based update: only update rows whose status or data changed
            response.data.forEach(function(application, index) {
                var existingRow = existingRows[String(application.application_id)];
                if (!existingRow) return;

                var oldStatus = existingRow.dataset.status;
                var newStatus = application.status;

                // Check if status changed
                if (oldStatus !== newStatus) {
                    existingRow.dataset.status = newStatus;
                    var statusTd = existingRow.querySelectorAll('td')[5];
                    if (statusTd) {
                        statusTd.innerHTML = getStatusBadge(newStatus);
                    }
                    // Flash animation
                    existingRow.classList.add('flash-update');
                    setTimeout(function() {
                        existingRow.classList.remove('flash-update');
                    }, 1500);
                }
            });

            // Update total count if changed
            var totalCountEl = document.getElementById('totalCount');
            if (response.total_records !== undefined && totalCountEl) {
                totalCountEl.textContent = '(মোট: ' + response.total_records + ')';
            }
        })
        .catch(function(error) {
            // Silently fail for auto-refresh
            console.warn('Auto-refresh failed:', error.message);
        });
    }

    // Toggle auto-refresh on/off
    if (autoRefreshToggle) {
        autoRefreshToggle.addEventListener('change', function() {
            autoRefreshEnabled = this.checked;
            if (autoRefreshEnabled) {
                autoRefreshBar.classList.remove('disabled');
                startAutoRefreshCountdown();
            } else {
                autoRefreshBar.classList.add('disabled');
                stopAutoRefreshCountdown();
                if (autoRefreshCountdownEl) autoRefreshCountdownEl.textContent = '';
            }
        });
    }

    // Manual refresh button
    if (manualRefreshBtn) {
        manualRefreshBtn.addEventListener('click', function() {
            var icon = this.querySelector('i');
            if (icon) icon.classList.add('spinning');
            this.disabled = true;

            // Full refresh via existing function
            fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
            lastRefreshTimestamp = Date.now();
            updateLastUpdatedTime();

            var btn = this;
            setTimeout(function() {
                if (icon) icon.classList.remove('spinning');
                btn.disabled = false;
            }, 500);

            // Restart countdown
            if (autoRefreshEnabled) {
                startAutoRefreshCountdown();
            }
        });
    }

    // Pause auto-refresh when user is interacting with search/filter
    document.getElementById('liveSearch').addEventListener('focus', function() {
        if (autoRefreshEnabled) stopAutoRefreshCountdown();
    });
    document.getElementById('liveSearch').addEventListener('blur', function() {
        if (autoRefreshEnabled) startAutoRefreshCountdown();
    });

    // Update the "time ago" display every 10 seconds
    setInterval(updateLastUpdatedTime, 10000);

    // Start auto-refresh
    if (autoRefreshEnabled) {
        startAutoRefreshCountdown();
    }
    updateLastUpdatedTime();

    // Expose refresh function globally so modal handlers can trigger table refresh
    window.refreshApplicationList = function() {
        fetchApplications(currentPage, currentSearch, currentSortBy, currentSortOrder, recordsPerPage, currentUnion, currentStatus);
        lastRefreshTimestamp = Date.now();
        updateLastUpdatedTime();
    };
});

