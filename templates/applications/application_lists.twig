    /* ===============================
       Modal Issue Time - Live Clock & Auto-sync
    =============================== */
    if (typeof window.__modalIssueTimeBound === 'undefined') {
    window.__modalIssueTimeBound = true;
    const modalIssueTimeInput = document.getElementById('modal_issue_time');
    const modalIssueTimeLive = document.getElementById('modalIssueTimeLive');
    let modalIssueTimeTimer = null;
    let modalIssueTimeTimeout = null;

    const isDefaultModalIssueTime = (v) => {
        const value = String(v || '').trim();
        return value === '' || value === '12:00' || value === '12:00:00';
    };

    const formatModalTimeHHMMSS = (d) => {
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');
        const seconds = String(d.getSeconds()).padStart(2, '0');
        return hours + ':' + minutes + ':' + seconds;
    };

    const startModalLiveClock = () => {
        if (!modalIssueTimeLive || modalIssueTimeTimer) return;
        const tick = () => {
            modalIssueTimeLive.textContent = formatModalTimeHHMMSS(new Date());
        };
        tick();
        modalIssueTimeTimer = setInterval(tick, 1000);
    };

    const stopModalLiveClock = () => {
        if (modalIssueTimeTimer) {
            clearInterval(modalIssueTimeTimer);
            modalIssueTimeTimer = null;
        }
    };

    const startModalIssueTimeSync = () => {
        if (!modalIssueTimeInput || modalIssueTimeTimer) return;
        const tick = () => {
            if (!isDefaultModalIssueTime(modalIssueTimeInput.value)) {
                stopModalIssueTimeSync();
                return;
            }
            const now = new Date();
            modalIssueTimeInput.value = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        };
        tick();
        modalIssueTimeTimeout = setTimeout(() => {
            modalIssueTimeTimeout = null;
            tick();
            modalIssueTimeTimer = setInterval(() => {
                if (!isDefaultModalIssueTime(modalIssueTimeInput.value)) {
                    stopModalIssueTimeSync();
                    return;
                }
                const now = new Date();
                modalIssueTimeInput.value = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
            }, 1000);
        }, 1000 - (Date.now() % 1000));
    };

    const stopModalIssueTimeSync = () => {
        if (modalIssueTimeTimeout) {
            clearTimeout(modalIssueTimeTimeout);
            modalIssueTimeTimeout = null;
        }
        if (modalIssueTimeTimer) {
            clearInterval(modalIssueTimeTimer);
            modalIssueTimeTimer = null;
        }
    };

    // Initialize live clock and auto-sync when modal is shown
    if (approveModalEl) {
        approveModalEl.addEventListener('shown.bs.modal', function() {
            startModalLiveClock();
            startModalIssueTimeSync();
        });
        approveModalEl.addEventListener('hide.bs.modal', function() {
            stopModalLiveClock();
            stopModalIssueTimeSync();
        });
    }

    // Stop sync when user interacts with the time input
    if (modalIssueTimeInput) {
        modalIssueTimeInput.addEventListener('focus', stopModalIssueTimeSync);
        modalIssueTimeInput.addEventListener('blur', () => {
            if (isDefaultModalIssueTime(modalIssueTimeInput.value)) startModalIssueTimeSync();
        });
        modalIssueTimeInput.addEventListener('input', () => {
            if (!isDefaultModalIssueTime(modalIssueTimeInput.value)) stopModalIssueTimeSync();
        });
    }
    } // end __modalIssueTimeBound guard
</script>

