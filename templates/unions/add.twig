{% extends "layout.twig" %}

{% block title %}{{ title|default('নতুন ইউনিয়ন যোগ করুন') }}{% endblock %}
{% block header_title %}{{ header_title|default('নতুন ইউনিয়ন যোগ করুন') }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">{{ header_title }}</h2>
        <a href="/unions" class="btn btn-outline-secondary btn-md shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    {% if message %}
        <div class="alert alert-{{ status }} rounded-3 shadow-sm d-flex align-items-center">
            <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
        </div>
    {% endif %}

    <form method="post" id="unionForm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="division_id" id="division_id" value="">
        <input type="hidden" name="district_id" id="district_id" value="">
        <input type="hidden" name="upazila_id" id="upazila_id" value="">

        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>ইউনিয়নের তথ্য</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ইউনিয়নের নাম (ইংরেজি) <span class="text-danger">*</span></label>
                        <input type="text" name="union_name_en" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ইউনিয়নের নাম (বাংলা) <span class="text-danger">*</span></label>
                        <input type="text" name="union_name_bn" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">বিভাগ (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="division_en" name="division_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">বিভাগ (বাংলা)</label>
                        <input type="text" id="division_name_bn" name="division_name_bn" class="form-control" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ওয়ার্ড সংখ্যা</label>
                        <input type="number" name="ward_count" class="form-control" value="9" min="1">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">জেলা (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="district_en" name="district_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">জেলা (বাংলা)</label>
                        <input type="text" id="district_name_bn" name="district_name_bn" class="form-control" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ইউনিয়ন কোড</label>
                        <input type="text" name="union_code" class="form-control" maxlength="7">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">উপজেলা (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="upazila_en" name="upazila_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">উপজেলা (বাংলা)</label>
                        <input type="text" id="upazila_name_bn" name="upazila_name_bn" class="form-control" readonly>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-telephone me-2"></i>যোগাযোগের তথ্য</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ইমেইল</label>
                        <input type="email" name="email" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">মোবাইল</label>
                        <input type="text" name="phone" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ওয়েবসাইট</label>
                        <input type="url" name="website" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">পোস্ট কোড</label>
                        <input type="text" name="postcode" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success btn-md px-4 shadow-sm">
                <i class="bi bi-check-circle me-1"></i> সংরক্ষণ করুন
            </button>
            <a href="/unions" class="btn btn-outline-secondary btn-md px-4">বাতিল</a>
        </div>
    </form>
</div>

{% endblock %}

{% block scripts %}
<script>
$(document).ready(function () {
    // AJAX form submission with spinner
    $('#unionForm').on('submit', function (e) {
        e.preventDefault();

        const $form = $(this);
        const btn = $form.find('button[type="submit"]')[0];
        const restoreBtn = btn ? btnLoading(btn, 'সংরক্ষণ করা হচ্ছে...') : function(){};

        $.ajax({
            url: window.location.href,
            method: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            success: function (res) {
                restoreBtn();
                if (res.alert && res.success === false) {
                    Swal.fire(res.alert.title, res.alert.message, res.alert.type);
                }
                if (res.success && res.redirect) {
                    window.location.href = res.redirect;
                }
            },
            error: function (xhr) {
                restoreBtn();
                let msg = 'সার্ভারের সাথে সংযোগ ব্যর্থ';
                try {
                    const res = JSON.parse(xhr.responseText);
                    msg = res.alert?.message || msg;
                } catch(e) {}
                Swal.fire('ত্রুটি', msg, 'error');
            }
        });
    });

    const selectedDivision = "";
    const selectedDistrict = "";
    const selectedUpazila  = "";

    $.ajax({
        url: '/geo/getdata',
        method: 'POST',
        data: { geo_order: 0, parent_geo_id: 1 },
        dataType: 'json',
        success: function (divisions) {
            populateDropdown('#division_en', divisions, selectedDivision);

            const divisionId = divisions.find(d => d.name_en === selectedDivision)?.id;
            if (!divisionId) return;

            $.ajax({
                url: '/geo/getdata',
                method: 'POST',
                data: { geo_order: 1, parent_geo_id: divisionId },
                dataType: 'json',
                success: function (districts) {
                    populateDropdown('#district_en', districts, selectedDistrict);

                    const districtId = districts.find(d => d.name_en === selectedDistrict)?.id;
                    if (!districtId) return;

                    $.ajax({
                        url: '/geo/getdata',
                        method: 'POST',
                        data: { geo_order: 2, parent_geo_id: districtId },
                        dataType: 'json',
                        success: function (upazilas) {
                            populateDropdown('#upazila_en', upazilas, selectedUpazila);
                        }
                    });
                }
            });
        },
        error: function (error) {
            console.error('Error fetching divisions', error);
        }
    });

    $('#division_en').on('change', function () {
        const divisionId = $(this).find('option:selected').data('geo-id');
        const bnName = $(this).find('option:selected').data('name-bn');
        $('#division_name_bn').val(bnName);
        $('#division_id').val(divisionId || '');

        if (!divisionId) return;

        $.ajax({
            url: '/geo/getdata',
            method: 'POST',
            data: { geo_order: 1, parent_geo_id: divisionId },
            dataType: 'json',
            success: function (districts) {
                populateDropdown('#district_en', districts, '');
                resetDropdown('#upazila_en');
                $('#district_name_bn').val('');
                $('#district_id').val('');
                $('#upazila_name_bn').val('');
                $('#upazila_id').val('');
            }
        });
    });

    $('#district_en').on('change', function () {
        const districtId = $(this).find('option:selected').data('geo-id');
        const bnName = $(this).find('option:selected').data('name-bn');
        $('#district_name_bn').val(bnName);
        $('#district_id').val(districtId || '');

        if (!districtId) return;

        $.ajax({
            url: '/geo/getdata',
            method: 'POST',
            data: { geo_order: 2, parent_geo_id: districtId },
            dataType: 'json',
            success: function (upazilas) {
                populateDropdown('#upazila_en', upazilas, '');
                $('#upazila_name_bn').val('');
                $('#upazila_id').val('');
            }
        });
    });

    $('#upazila_en').on('change', function () {
        const upazilaId = $(this).find('option:selected').data('geo-id');
        const bnName = $(this).find('option:selected').data('name-bn');
        $('#upazila_name_bn').val(bnName);
        $('#upazila_id').val(upazilaId || '');
    });

    function populateDropdown(selector, data, selectedValue) {
        $(selector).empty().append('<option value="">Select</option>');
        $.each(data, function (index, item) {
            const isSelected = selectedValue === item.name_en ? 'selected' : '';
            $(selector).append(`
                <option value="${item.name_en}"
                        data-geo-id="${item.id}"
                        data-name-bn="${item.name_bn}"
                        data-geo-code="${String(item.geo_code).substr(2)}"
                        ${isSelected}>
                    ${item.name_bn} (${item.name_en})
                </option>
            `);
        });

        if (selectedValue) {
            $(selector).val(selectedValue);
            const bnName = data.find(d => d.name_en === selectedValue)?.name_bn || '';
            const geoId = data.find(d => d.name_en === selectedValue)?.id || '';
            if (selector === '#division_en') {
                $('#division_name_bn').val(bnName);
                $('#division_id').val(geoId);
            } else if (selector === '#district_en') {
                $('#district_name_bn').val(bnName);
                $('#district_id').val(geoId);
            } else if (selector === '#upazila_en') {
                $('#upazila_name_bn').val(bnName);
                $('#upazila_id').val(geoId);
            }
        }
    }

    function resetDropdown(selector) {
        $(selector).empty().append('<option value="">Select</option>');
    }
});
</script>
{% endblock %}
