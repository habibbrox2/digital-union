{% extends "layout.twig" %}

{% block title %}{{ title|default('ইউনিয়ন সম্পাদনা করুন') }}{% endblock %}
{% block header_title %}{{ header_title|default('ইউনিয়ন সম্পাদনা করুন') }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">{{ header_title }}</h2>
        <a href="/unions" class="btn btn-outline-secondary btn-md shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    {% if message %}
        <div class="alert alert-{{ status }} rounded-3 shadow-sm d-flex align-items-center">
            <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
        </div>
    {% endif %}

    <form method="post" id="unionForm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="division_id" id="division_id" value="{{ union.division_id }}">
        <input type="hidden" name="district_id" id="district_id" value="{{ union.district_id }}">
        <input type="hidden" name="upazila_id" id="upazila_id" value="{{ union.upazila_id }}">

        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>ইউনিয়নের তথ্য</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ইউনিয়নের নাম (ইংরেজি) <span class="text-danger">*</span></label>
                        <input type="text" name="union_name_en" class="form-control" value="{{ union.union_name_en }}" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ইউনিয়নের নাম (বাংলা) <span class="text-danger">*</span></label>
                        <input type="text" name="union_name_bn" class="form-control" value="{{ union.union_name_bn }}" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">বিভাগ (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="division_en" name="division_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">বিভাগ (বাংলা)</label>
                        <input type="text" id="division_name_bn" name="division_name_bn" class="form-control" value="{{ union.division_name_bn }}" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ওয়ার্ড সংখ্যা</label>
                        <input type="number" name="ward_count" class="form-control" value="{{ union.ward_count }}" min="1">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">জেলা (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="district_en" name="district_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">জেলা (বাংলা)</label>
                        <input type="text" id="district_name_bn" name="district_name_bn" class="form-control" value="{{ union.district_name_bn }}" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ইউনিয়ন কোড</label>
                        <input type="text" name="union_code" class="form-control" value="{{ union.union_code }}" maxlength="7">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">উপজেলা (ইংরেজি) <span class="text-danger">*</span></label>
                        <select id="upazila_en" name="upazila_name_en" class="form-select" required>
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">উপজেলা (বাংলা)</label>
                        <input type="text" id="upazila_name_bn" name="upazila_name_bn" class="form-control" value="{{ union.upazila_name_bn }}" readonly>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-telephone me-2"></i>যোগাযোগের তথ্য</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ইমেইল</label>
                        <input type="email" name="email" class="form-control" value="{{ union.email }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">মোবাইল</label>
                        <input type="text" name="phone" class="form-control" value="{{ union.phone }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">ওয়েবসাইট</label>
                        <input type="url" name="website" class="form-control" value="{{ union.website }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">পোস্ট কোড</label>
                        <input type="text" name="postcode" class="form-control" value="{{ union.postcode }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">অবস্থা</label>
                        <select name="is_active" class="form-select">
                            <option value="1" {% if union.is_active %}selected{% endif %}>Active</option>
                            <option value="0" {% if not union.is_active %}selected{% endif %}>Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-md px-4 shadow-sm">
                <i class="bi bi-check-circle me-1"></i> আপডেট করুন
            </button>
            <a href="/unions" class="btn btn-outline-secondary btn-md px-4">বাতিল</a>
        </div>
    </form>
</div>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // AJAX form submission with spinner
    var unionForm = document.getElementById('unionForm');
    if (unionForm) {
        unionForm.addEventListener('submit', function (e) {
            e.preventDefault();

            var btn = unionForm.querySelector('button[type="submit"]');
            var restoreBtn = btn ? btnLoading(btn, 'সংরক্ষণ করা হচ্ছে...') : function(){};

            fetch(window.location.href, {
                method: 'POST',
                body: new FormData(unionForm),
            })
            .then(function(resp) { return resp.json(); })
            .then(function (res) {
                restoreBtn();
                if (res.alert && res.success === false) {
                    Swal.fire(res.alert.title, res.alert.message, res.alert.type);
                }
                if (res.success && res.redirect) {
                    window.location.href = res.redirect;
                }
            })
            .catch(function (error) {
                restoreBtn();
                var msg = 'সার্ভারের সাথে সংযোগ ব্যর্থ';
                if (error && error.text) {
                    error.text().then(function(text) {
                        try { var res = JSON.parse(text); msg = (res.alert && res.alert.message) || msg; } catch(e) {}
                        Swal.fire('ত্রুটি', msg, 'error');
                    });
                } else {
                    Swal.fire('ত্রুটি', msg, 'error');
                }
            });
        });
    }

    const selectedDivision = "";
    const selectedDistrict = "";
    const selectedUpazila  = "";

    var fd0 = new FormData(); fd0.append('geo_order', '0'); fd0.append('parent_geo_id', '1');
    fetch('/geo/getdata', { method: 'POST', body: fd0 })
    .then(function(r) { return r.json(); })
    .then(function (divisions) {
        populateDropdown('#division_en', divisions, selectedDivision);
        var divisionIdObj = divisions.find(function(d) { return d.name_en === selectedDivision; });
        var divisionId = divisionIdObj ? divisionIdObj.id : null;
        if (!divisionId) return;
        var fd1 = new FormData(); fd1.append('geo_order', '1'); fd1.append('parent_geo_id', divisionId);
        fetch('/geo/getdata', { method: 'POST', body: fd1 })
        .then(function(r) { return r.json(); })
        .then(function (districts) {
            populateDropdown('#district_en', districts, selectedDistrict);
            var districtIdObj = districts.find(function(d) { return d.name_en === selectedDistrict; });
            var districtId = districtIdObj ? districtIdObj.id : null;
            if (!districtId) return;
            var fd2 = new FormData(); fd2.append('geo_order', '2'); fd2.append('parent_geo_id', districtId);
            fetch('/geo/getdata', { method: 'POST', body: fd2 })
            .then(function(r) { return r.json(); })
            .then(function (upazilas) {
                populateDropdown('#upazila_en', upazilas, selectedUpazila);
            });
        });
    })
    .catch(function (error) {
        console.error('Error fetching divisions', error);
    });

    document.getElementById('division_en').addEventListener('change', function () {
        const divisionId = this.options[this.selectedIndex].getAttribute('data-geo-id');
        const bnName = this.options[this.selectedIndex].getAttribute('data-name-bn');
        document.getElementById('division_name_bn').value = bnName;
        document.getElementById('division_id').value = divisionId || '';

        if (!divisionId) return;

        var fd = new FormData(); fd.append('geo_order', '1'); fd.append('parent_geo_id', divisionId);
        fetch('/geo/getdata', { method: 'POST', body: fd })
        .then(function(r) { return r.json(); })
        .then(function (districts) {
            populateDropdown('#district_en', districts, '');
            resetDropdown('#upazila_en');
            document.getElementById('district_name_bn').value = '';
            document.getElementById('district_id').value = '';
            document.getElementById('upazila_name_bn').value = '';
            document.getElementById('upazila_id').value = '';
        });
    });

    document.getElementById('district_en').addEventListener('change', function () {
        const districtId = this.options[this.selectedIndex].getAttribute('data-geo-id');
        const bnName = this.options[this.selectedIndex].getAttribute('data-name-bn');
        document.getElementById('district_name_bn').value = bnName;
        document.getElementById('district_id').value = districtId || '';

        if (!districtId) return;

        var fd = new FormData(); fd.append('geo_order', '2'); fd.append('parent_geo_id', districtId);
        fetch('/geo/getdata', { method: 'POST', body: fd })
        .then(function(r) { return r.json(); })
        .then(function (upazilas) {
            populateDropdown('#upazila_en', upazilas, '');
            document.getElementById('upazila_name_bn').value = '';
            document.getElementById('upazila_id').value = '';
        });
    });

    document.getElementById('upazila_en').addEventListener('change', function () {
        const upazilaId = this.options[this.selectedIndex].getAttribute('data-geo-id');
        const bnName = this.options[this.selectedIndex].getAttribute('data-name-bn');
        document.getElementById('upazila_name_bn').value = bnName;
        document.getElementById('upazila_id').value = upazilaId || '';
    });

    function populateDropdown(selector, data, selectedValue) {
        var el = document.querySelector(selector);
        if (!el) return;
        el.innerHTML = '<option value="">Select</option>';
        data.forEach(function (item) {
            const isSelected = selectedValue === item.name_en ? 'selected' : '';
            var opt = document.createElement('option');
            opt.value = item.name_en;
            opt.setAttribute('data-geo-id', item.id);
            opt.setAttribute('data-name-bn', item.name_bn);
            opt.setAttribute('data-geo-code', String(item.geo_code).substr(2));
            if (isSelected) opt.selected = true;
            opt.textContent = item.name_bn + ' (' + item.name_en + ')';
            el.appendChild(opt);
        });

        if (selectedValue) {
            el.value = selectedValue;
            const bnName = data.find(d => d.name_en === selectedValue)?.name_bn || '';
            const geoId = data.find(d => d.name_en === selectedValue)?.id || '';
            if (selector === '#division_en') {
                document.getElementById('division_name_bn').value = bnName;
                document.getElementById('division_id').value = geoId;
            } else if (selector === '#district_en') {
                document.getElementById('district_name_bn').value = bnName;
                document.getElementById('district_id').value = geoId;
            } else if (selector === '#upazila_en') {
                document.getElementById('upazila_name_bn').value = bnName;
                document.getElementById('upazila_id').value = geoId;
            }
        }
    }

    function resetDropdown(selector) {
        var el = document.querySelector(selector);
        if (el) {
            el.innerHTML = '<option value="">Select</option>';
        }
    }
});
</script>
{% endblock %}
