{% extends "layout.twig" %}

{% block title %}{{ title }}{% endblock %}
{% block header_title %}{{ header_title }}{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container py-4">
    <!-- Page Header -->
    <div class="page-header-bar mb-4">
        <div>
            <h2 class="page-header-title mb-1">{{ header_title }}</h2>
            <p class="page-header-subtitle mb-0">সিস্টেমের শব্দ ও তাদের বাংলা, ইংরেজি ও বাংলিশ অনুবাদ পরিচালনা করুন।</p>
        </div>
        <span class="badge-page"><i class="fas fa-language me-1"></i> শব্দ অনুবাদ</span>
    </div>

    <div class="row g-4">
        <!-- Form Card -->
        <div class="col-12 col-xl-5">
            <div class="section-card h-100">
                <h3 class="section-title"><i class="fas fa-edit text-primary"></i> নতুন শব্দ যোগ / সম্পাদনা</h3>

                <form id="termForm">
                    <input type="hidden" name="id" id="id">
                    <div id="responseMessage"></div>

                    <div class="mb-3">
                        <label for="slug" class="form-label">Slug</label>
                        <input type="text" name="slug" id="slug" class="form-control input-enhanced" placeholder="যেমন: application_status" required>
                    </div>

                    <div class="mb-3">
                        <label for="bn" class="form-label">বাংলা <span>*</span></label>
                        <input type="text" name="name_bn" id="bn" class="form-control input-enhanced" placeholder="বাংলা অনুবাদ" required>
                    </div>

                    <div class="mb-3">
                        <label for="en" class="form-label">English</label>
                        <input type="text" name="name_en" id="en" class="form-control input-enhanced" placeholder="English translation">
                    </div>

                    <div class="mb-3">
                        <label for="bl" class="form-label">Banglish</label>
                        <input type="text" name="name_bl" id="bl" class="form-control input-enhanced" placeholder="Banglish version" required>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input type="checkbox" name="is_certificate_type" id="is_certificate_type" value="1" class="form-check-input" role="switch">
                        <label for="is_certificate_type" class="form-check-label">সার্টিফিকেটের ধরণ হিসেবে ব্যবহার করুন</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="fas fa-save me-1"></i> <span id="submitBtnText">সংরক্ষণ করুন</span>
                        </button>
                        <button type="button" id="resetFormBtn" class="btn btn-outline-secondary btn-lg" title="ফর্ম পরিষ্কার করুন">
                            <i class="fas fa-rotate-left"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- List Card -->
        <div class="col-12 col-xl-7">
            <div class="section-card h-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h3 class="section-title mb-0"><i class="fas fa-list text-primary"></i> শব্দের তালিকা</h3>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchTerm" class="form-control form-control-sm" placeholder="অনুসন্ধান করুন...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-enhanced align-middle mb-0" id="termTable">
                        <thead>
                            <tr>
                                <th data-column="slug" class="sortable">Slug <i class="fas fa-sort sort-icon"></i></th>
                                <th data-column="name_bn" class="sortable">বাংলা <i class="fas fa-sort sort-icon"></i></th>
                                <th data-column="name_en" class="sortable">English <i class="fas fa-sort sort-icon"></i></th>
                                <th data-column="name_bl" class="sortable">Banglish <i class="fas fa-sort sort-icon"></i></th>
                                <th class="text-center">সার্টিফিকেট</th>
                                <th class="text-center">অ্যাকশন</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="tableEmpty" class="table-empty d-none">
                        <i class="fas fa-inbox"></i>
                        <p class="mb-0">কোনো শব্দ পাওয়া যায়নি।</p>
                    </div>
                </div>

                <div id="pagination" class="d-flex justify-content-center mt-3"></div>
            </div>
        </div>
    </div>
</div>

<script>
var currentPage = 1;
var currentSort = { column: 'slug', direction: 'asc' };
var searchQuery = '';

function escapeHtml(str) {
    if (!str) return '';
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
}

function loadTerms(page) {
    page = page || 1;
    currentPage = page;

    var params = new URLSearchParams({
        action: 'filter',
        page: page,
        sortColumn: currentSort.column,
        sortDirection: currentSort.direction,
        search: searchQuery
    });

    fetch('/ajax/term_translations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(response) {
        if (response.status !== 'success') {
            throw new Error(response.message || 'ডেটা লোড করা যায়নি');
        }

        var terms = response.data || [];
        var html = '';
        var tbody = document.querySelector('#termTable tbody');
        var tableEmpty = document.getElementById('tableEmpty');

        terms.forEach(function(term) {
            var certBadge = term.is_certificate_type == 1
                ? '<span class="badge bg-success-subtle text-success"><i class="fas fa-check me-1"></i> হ্যাঁ</span>'
                : '<span class="text-muted">—</span>';
            html += '<tr>' +
                '<td><code class="term-slug">' + escapeHtml(term.slug) + '</code></td>' +
                '<td class="fw-medium">' + escapeHtml(term.name_bn) + '</td>' +
                '<td>' + escapeHtml(term.name_en) + '</td>' +
                '<td>' + escapeHtml(term.name_bl) + '</td>' +
                '<td class="text-center">' + certBadge + '</td>' +
                '<td class="text-center text-nowrap">' +
                    '<button class="btn btn-sm btn-outline-primary me-1 edit-term-btn" data-term-id="' + term.id + '"><i class="fas fa-pen"></i></button>' +
                    '<button class="btn btn-sm btn-outline-danger delete-term-btn" data-term-id="' + term.id + '"><i class="fas fa-trash"></i></button>' +
                '</td>' +
            '</tr>';
        });

        tbody.innerHTML = html;
        if (tableEmpty) {
            tableEmpty.classList.toggle('d-none', terms.length > 0);
        }
        updateSortIcons();
        renderPagination(response.total, page);
    })
    .catch(function(err) {
        console.error('Invalid JSON or server error:', err);
        Swal.fire('ত্রুটি', 'ডেটা লোড করা যায়নি। অনুগ্রহ করে পরে আবার চেষ্টা করুন।', 'error');
    });
}

function updateSortIcons() {
    document.querySelectorAll('#termTable thead th.sortable').forEach(function(th) {
        var icon = th.querySelector('.sort-icon');
        if (!icon) return;
        icon.classList.remove('fa-sort', 'fa-sort-up', 'fa-sort-down');
        if (th.dataset.column === currentSort.column) {
            icon.classList.add(currentSort.direction === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
        } else {
            icon.classList.add('fa-sort');
        }
    });
}

function renderPagination(totalItems, curPage) {
    var itemsPerPage = 10;
    var totalPages = Math.ceil(totalItems / itemsPerPage);
    var paginationEl = document.getElementById('pagination');

    if (totalPages <= 1) {
        paginationEl.innerHTML = '';
        return;
    }

    var html = '<nav><ul class="pagination justify-content-center mb-0">';
    for (var i = 1; i <= totalPages; i++) {
        html += '<li class="page-item ' + (i === curPage ? 'active' : '') + '">' +
            '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
    }
    html += '</ul></nav>';
    paginationEl.innerHTML = html;
}

function setEditMode(isEdit) {
    document.getElementById('submitBtnText').textContent = isEdit ? 'আপডেট করুন' : 'সংরক্ষণ করুন';
}

function editTerm(id) {
    var params = new URLSearchParams({ action: 'get', id: id });
    fetch('/ajax/term_translations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(response) {
        var term = response.data || response;
        document.getElementById('id').value = term.id;
        var slugField = document.getElementById('slug');
        slugField.value = term.slug;
        slugField.dataset.oldSlug = term.slug;
        document.getElementById('bn').value = term.name_bn;
        document.getElementById('en').value = term.name_en;
        document.getElementById('bl').value = term.name_bl;
        document.getElementById('is_certificate_type').checked = term.is_certificate_type == 1;
        setEditMode(true);
        document.getElementById('termForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
}

function resetForm() {
    document.getElementById('termForm').reset();
    document.getElementById('id').value = '';
    document.getElementById('slug').dataset.oldSlug = '';
    document.getElementById('responseMessage').innerHTML = '';
    setEditMode(false);
}

function submitForm(formData) {
    var msgEl = document.getElementById('responseMessage');

    fetch('/ajax/term_translations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.status === 'success') {
            msgEl.innerHTML = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                escapeHtml(res.message) +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
            resetForm();
            loadTerms(currentPage);
        } else {
            msgEl.innerHTML = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                escapeHtml(res.message || 'কিছু ভুল হয়েছে!') +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
        }
    })
    .catch(function() {
        msgEl.innerHTML = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
            'সার্ভার ত্রুটি। অনুগ্রহ করে আবার চেষ্টা করুন।' +
            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
    });
}

function deleteTerm(id) {
    Swal.fire({
        title: 'মুছে ফেলবেন?',
        text: 'এটি স্থায়ীভাবে মুছে ফেলা হবে।',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'হ্যাঁ, মুছে ফেলুন',
        cancelButtonText: 'বাতিল'
    }).then(function(result) {
        if (result.isConfirmed) {
            var params = new URLSearchParams({ action: 'delete', id: id });
            fetch('/ajax/term_translations', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            }).then(function() {
                loadTerms(currentPage);
            });
        }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    // Pagination click
    document.getElementById('pagination').addEventListener('click', function(e) {
        var link = e.target.closest('.page-link');
        if (!link) return;
        e.preventDefault();
        var page = parseInt(link.dataset.page);
        if (page && page !== currentPage) loadTerms(page);
    });

    // Search input
    document.getElementById('searchTerm').addEventListener('input', function() {
        searchQuery = this.value.trim();
        loadTerms(1);
    });

    // Sort columns
    document.querySelectorAll('#termTable thead th.sortable').forEach(function(th) {
        th.addEventListener('click', function() {
            var col = this.dataset.column;
            if (currentSort.column === col) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = col;
                currentSort.direction = 'asc';
            }
            loadTerms(1);
        });
    });

    // Reset form
    document.getElementById('resetFormBtn').addEventListener('click', resetForm);

    // Form submit
    document.getElementById('termForm').addEventListener('submit', function(e) {
        e.preventDefault();

        var idVal = document.getElementById('id').value;
        var action = idVal ? 'update' : 'create';
        var slugField = document.getElementById('slug');
        var newSlug = slugField.value.trim();
        var oldSlug = slugField.dataset.oldSlug || '';
        var isCertificateType = document.getElementById('is_certificate_type').checked ? '1' : '0';
        var formData = new URLSearchParams(new FormData(this)).toString() + '&is_certificate_type=' + isCertificateType + '&action=' + action;

        if (action === 'update' && oldSlug && newSlug !== oldSlug) {
            Swal.fire({
                title: 'স্লাগ পরিবর্তন করবেন?',
                html: 'আপনি <strong>slug</strong> পরিবর্তন করছেন।<br><br>পুরাতন: <code>' + escapeHtml(oldSlug) + '</code><br>নতুন: <code>' + escapeHtml(newSlug) + '</code>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'হ্যাঁ, পরিবর্তন করুন',
                cancelButtonText: 'বাতিল করুন'
            }).then(function(result) {
                if (result.isConfirmed) {
                    submitForm(formData);
                }
            });
        } else {
            submitForm(formData);
        }
    });

    // Edit/Delete buttons (event delegation)
    document.addEventListener('click', function(e) {
        var editBtn = e.target.closest('.edit-term-btn');
        if (editBtn) { editTerm(editBtn.dataset.termId); return; }
        var delBtn = e.target.closest('.delete-term-btn');
        if (delBtn) { deleteTerm(delBtn.dataset.termId); return; }
    });

    // Initial load
    loadTerms();
});
</script>
{% endblock %}
