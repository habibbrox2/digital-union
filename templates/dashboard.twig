{% extends "layout.twig" %}

{% block title %}ড্যাশবোর্ড{% endblock %}
{% block header_title %}স্বাগতম আপনার ড্যাশবোর্ডে{% endblock %}

{% block content %}
{% include 'components/sweetAlert.twig' %}
{% include 'components/application_details_modal.twig' %}
{% include 'components/preview_modal.twig' %}

<!-- Libraries -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- jQuery UI removed — native search autocomplete in use -->

<div class="container py-4">

<style>
/* ===============================
   Global UI Enhancements
================================= */

.loading {
    border: 4px solid #f3f3f3;
    border-top: 4px solid #008B8B;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.card:hover {
    transform: translateY(-4px);
    transition: 0.2s ease-in-out;
    box-shadow: 0 4px 20px rgba(0,0,0,.12);
}

#certificateSearch { height: 45px; }

/* ===============================
   Autocomplete – Modern UI
================================= */

.ui-autocomplete {
    max-height: 180px;
    overflow-y: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0,0,0,.15);
    padding: 6px 0;
    z-index: 1055;
}
.ui-autocomplete::-webkit-scrollbar { width: 6px; }
.ui-autocomplete::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
}

.ui-menu-item-wrapper {
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    border-radius: 8px;
    margin: 2px 6px;
    transition: .2s;
}
.ui-menu-item-wrapper:hover,
.ui-menu-item-wrapper.ui-state-active {
    background: #008B8B;
    color: #fff;
    transform: translateX(4px);
}

/* ===============================
   Search Result Cards
================================= */

.list-group-item.hover-shadow {
    transition: .25s;
}
.list-group-item.hover-shadow:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 25px rgba(0,0,0,.12);
}
.list-group-item pre {
    background: #f8f9fa;
    padding: 8px;
    border-radius: 6px;
    font-size: .85rem;
}

/* Custom color utilities */
.text-purple { color: #7c3aed !important; }
</style>

<!-- ===============================
     Search Bar
================================= -->
<div class="row mb-4">
    <div class="col-md-6 offset-md-3">
        <div class="position-relative w-100" style="max-width:500px;margin:auto;">
            <input type="text" id="certificateSearch"
                   class="form-control rounded-pill ps-4 pe-5 shadow-sm"
                   placeholder="সনদ / আবেদন অনুসন্ধান করুন...">

            <div id="searchLoader"
                 class="loading position-absolute top-50 end-0 translate-middle-y me-5 d-none"></div>

            <button id="searchIcon"
                    class="btn position-absolute top-50 end-0 translate-middle-y me-2 bg-light rounded-circle shadow-sm">
                <i class="fas fa-search text-muted"></i>
            </button>
        </div>
    </div>
</div>

<!-- ===============================
     Search Results
================================= -->
<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="list-group"></div>
    </div>
</div>

<!-- ===============================
     Dashboard Widgets
================================= -->
<div class="row g-4 mt-5">
    {% set cards = [
        ['/analytics','chart-pie','বিশ্লেষণ','আপনার কর্মক্ষমতা ও পরিসংখ্যান দেখুন।'],
        ['/users','user-friends','ব্যবহারকারী','ব্যবহারকারীর প্রোফাইল ও নিয়ন্ত্রণ করুন।'],
        ['/reports','file-alt','রিপোর্টসমূহ','বিস্তারিত রিপোর্ট তৈরি ও দেখুন।'],
        ['/settings','cogs','সেটিংস','সিস্টেমের পছন্দ ও অপশন নির্ধারণ করুন।'],
        ['/applications','certificate','সকল সনদ','সমস্ত সনদ দেখুন ও পরিচালনা করুন。']
    ] %}

    {% for c in cards %}
    <div class="col-md-3 col-sm-6">
        <div class="card text-center p-3 h-100 shadow-sm dashboard-nav-card" data-href="{{ c[0] }}">
            <i class="fas fa-{{ c[1] }} fa-2x text-success mb-2"></i>
            <h5>{{ c[2] }}</h5>
            <p class="small text-muted">{{ c[3] }}</p>
        </div>
    </div>
    {% endfor %}

    {% if is_superadmin %}
    <div class="col-md-3 col-sm-6">
        <div class="card text-center p-3 h-100 shadow-sm dashboard-nav-card" data-href="/unions">
            <i class="fas fa-map-marker-alt fa-2x text-success mb-2"></i>
            <h5>সকল ইউনিয়ন</h5>
            <p class="small text-muted">সমস্ত ইউনিয়নের তথ্য ও ব্যবস্থাপনা।</p>
        </div>
    </div>
    {% endif %}
</div>

<!-- ===============================
     Error Statistics Panel
================================= -->
<div class="row g-4 mt-5" id="errorStatsRow">
    <div class="col-12">
        <div class="card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                    Error Statistics
                </h5>
                <div id="errorStatsLoader" class="spinner-border spinner-border-sm text-muted" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div id="errorStatsGrid" class="row g-3" style="display:none;">
                <!-- Total Errors -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#f8f9fa;">
                        <div class="display-6 fw-bold text-dark" id="statTotal">—</div>
                        <div class="small text-muted mt-1">মোট Errors</div>
                    </div>
                </div>

                <!-- Fatal Errors -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#fff5f5;">
                        <div class="display-6 fw-bold text-danger" id="statFatal">—</div>
                        <div class="small text-muted mt-1">Fatal</div>
                    </div>
                </div>

                <!-- Warnings -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#fffbeb;">
                        <div class="display-6 fw-bold text-warning" id="statWarning">—</div>
                        <div class="small text-muted mt-1">Warnings</div>
                    </div>
                </div>

                <!-- Exceptions -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#f0f7ff;">
                        <div class="display-6 fw-bold text-primary" id="statException">—</div>
                        <div class="small text-muted mt-1">Exceptions</div>
                    </div>
                </div>

                <!-- Notices -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#fefce8;">
                        <div class="display-6 fw-bold text-info" id="statNotice">—</div>
                        <div class="small text-muted mt-1">Notices</div>
                    </div>
                </div>

                <!-- Route Errors -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#f5f3ff;">
                        <div class="display-6 fw-bold text-purple" id="statRoute">—</div>
                        <div class="small text-muted mt-1">Route Errors</div>
                    </div>
                </div>

                <!-- Twig Errors -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#fff0f6;">
                        <div class="display-6 fw-bold" style="color:#e83e8c;" id="statTwig">—</div>
                        <div class="small text-muted mt-1">Twig Errors</div>
                    </div>
                </div>

                <!-- HTTP Errors (new) -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#e7f5ff;">
                        <div class="display-6 fw-bold text-info" id="statHttp">—</div>
                        <div class="small text-muted mt-1">HTTP Errors</div>
                    </div>
                </div>

                <!-- 404 Not Found (new) -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#fff4e6;">
                        <div class="display-6 fw-bold" style="color:#fd7e14;" id="stat404">—</div>
                        <div class="small text-muted mt-1">404 Not Found</div>
                    </div>
                </div>

                <!-- Log File Size -->
                <div class="col-md-2 col-sm-4 col-6">
                    <div class="rounded-3 p-3 text-center border" style="background:#f0fdf4;">
                        <div class="display-6 fw-bold text-success" id="statFileSize">—</div>
                        <div class="small text-muted mt-1">Log Size</div>
                    </div>
                </div>
            </div>

            <div class="mt-3 text-end">
                <a href="/admin/logs" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-eye me-1"></i> বিস্তারিত Log দেখুন
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ===============================
     Charts Section
================================= -->
    <!-- মাসভিত্তিক মোট আবেদন চার্ট -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm p-4">
                <h5 class="mb-4">মাসভিত্তিক মোট আবেদন</h5>
                <canvas id="monthlyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- মাসভিত্তিক স্ট্যাটাস (Pending/Approved/Rejected/On Hold) -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm p-4">
                <h5 class="mb-4">মাসভিত্তিক আবেদন (স্ট্যাটাস অনুযায়ী)</h5>
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- সার্টিফিকেট টাইপ অনুযায়ী মোট আবেদন -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm p-4">
                <h5 class="mb-4">সনদ প্রকার অনুযায়ী মোট আবেদন</h5>
                <div style="position: relative; height: 400px;">
                    <canvas id="certificateChart"></canvas>
                </div>
                <div id="chartLegend" class="mt-3 d-flex flex-wrap gap-3"></div>
                <div id="chartLoader" class="text-center text-muted mt-3" style="display:none;">চার্ট ডেটা লোড হচ্ছে...</div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
/* ===============================
   Utility
================================= */
function toBn(v){
    const d=['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
    return v? v.toString().replace(/\d/g,x=>d[x]):'—';
}

/* ===============================
   Autocomplete Rendering
================================= */
/* jQuery UI autocomplete removed — using native search */

function renderResults(res) {
    var listEl = document.querySelector('.list-group');
    if (!listEl) return;
    listEl.innerHTML = '';

    if (!res.results || !res.results.length) {
        listEl.innerHTML = '<div class="text-center text-muted my-3">কোন ফলাফল পাওয়া যায়নি</div>';
        return;
    }

    res.results.forEach(certificate => {

        /* Status class */
        const statusClass =
            certificate.approval_status === 'Approved' ? 'success' :
            certificate.approval_status === 'Pending'  ? 'warning' :
            certificate.approval_status === 'Rejected' ? 'danger'  :
            'secondary';

        /* Action buttons */
        let buttons = `
            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                   class="btn btn-outline-info btn-sm" title="আবেদন দেখুন"
                   onclick="openApplicationDetails('${certificate.certificate_type}', '${certificate.application_id}')">
                    <i class="fas fa-eye"></i>
                </button>

                <a href="/applications/${certificate.certificate_type}/edit/${certificate.application_id}"
                   class="btn btn-outline-warning btn-sm" title="সম্পাদনা করুন">
                    <i class="fas fa-pencil-alt"></i>
                </a>
        `;

        if (certificate.approval_status === 'Approved') {
            buttons += `
                <button type="button"
                   class="btn btn-outline-success btn-sm" title="বাংলা সনদ দেখুন"
                   onclick="openPreview('/application/${certificate.certificate_type}/bangla/${certificate.sonod_number}', 'বাংলা সনদ')">বাংলা</button>

                <button type="button"
                   class="btn btn-outline-primary btn-sm" title="English সনদ দেখুন"
                   onclick="openPreview('/application/${certificate.certificate_type}/english/${certificate.sonod_number}', 'English সনদ')">ইংরেজি</button>
            `;
        }

        buttons += `</div>`;

        /* Card render */
        listEl.insertAdjacentHTML('beforeend', `
            <div class="list-group-item mb-4 p-4 rounded-4 shadow-sm border-0 bg-white hover-shadow">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-primary">সনদ পত্রের বিবরণ</h5>
                    <span class="badge bg-${statusClass} py-2 px-3 text-white text-uppercase">
                        ${certificate.approval_status || 'N/A'}
                    </span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6"><strong>ট্রাকিং নং:</strong> ${toBn(certificate.application_id)}</div>
                    <div class="col-md-6"><strong>আবেদনকারী নং:</strong> ${toBn(certificate.applicant_id)}</div>
                    <div class="col-md-6"><strong>সনদ নং:</strong> ${toBn(certificate.sonod_number)}</div>
                    <div class="col-md-6"><strong>সনদের ধরন (বাংলা):</strong> ${certificate.certificate_name_bn || '—'}</div>
                    <div class="col-md-6"><strong>সনদের ধরন (ইংরেজি):</strong> ${certificate.certificate_name_bl || '—'}</div>
                    <div class="col-md-6"><strong>আবেদনকারী (বাংলা):</strong> ${certificate.name_bn || '—'}</div>
                    <div class="col-md-6"><strong>আবেদনকারী (ইংরেজি):</strong> ${certificate.name_en || '—'}</div>
                    <div class="col-md-6"><strong>আবেদনের তারিখ:</strong>
                        <span class="badge bg-light text-dark">${toBn(certificate.apply_date)}</span>
                    </div>
                    <div class="col-md-6"><strong>ইস্যুর তারিখ:</strong>
                        <span class="badge bg-light text-dark">${toBn(certificate.issue_date)}</span>
                    </div>
                </div>

                ${
                    certificate.member_name_bn || certificate.member_name_en
                    ? `<div class="border-top pt-2 mb-2 text-muted small">
                        <strong>সদস্য:</strong>
                        ${certificate.member_name_bn || certificate.member_name_en}
                        (${certificate.relation_bn || certificate.relation_en || '—'},
                        NID: ${toBn(certificate.member_nid)})
                      </div>`
                    : ''
                }

                ${
                    certificate.business_name_bn || certificate.business_name_en
                    ? `<div class="border-top pt-2 mb-2 text-muted small">
                        <strong>ব্যবসা:</strong>
                        ${certificate.business_name_bn || certificate.business_name_en}
                        (VAT: ${toBn(certificate.vat_id)}, TAX: ${toBn(certificate.tax_id)})
                      </div>`
                    : ''
                }

                ${
                    certificate.extra_data
                    ? `<div class="border-top pt-2 mb-2 text-muted small">
                        <strong>অতিরিক্ত তথ্য:</strong>
                        <pre class="mb-0 p-2 bg-light rounded">
${toBn(JSON.stringify(certificate.extra_data, null, 2))}
                        </pre>
                      </div>`
                    : ''
                }

                <div class="mt-3">${buttons}</div>
            </div>
        `);
    });
}


/* ===============================
   Search Logic
================================= */
// Dashboard navigation cards - migrated from inline onclick
document.addEventListener('click', function(e) {
    var card = e.target.closest('.dashboard-nav-card');
    if (!card) return;
    var href = card.dataset.href;
    if (href) location.href = href;
});

document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('certificateSearch');
    var searchLoader = document.getElementById('searchLoader');
    var searchDropdown = document.createElement('div');
    searchDropdown.className = 'position-absolute bg-white shadow rounded';
    searchDropdown.style.cssText = 'display:none;top:100%;left:0;right:0;z-index:1000;max-height:300px;overflow-y:auto;';
    if (searchInput && searchInput.parentNode) searchInput.parentNode.appendChild(searchDropdown);
    var searchDebounce = null;
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchDebounce);
            var q = this.value.trim();
            if (q.length < 2) { searchDropdown.style.display = 'none'; return; }
            searchDebounce = setTimeout(function() {
                if (searchLoader) searchLoader.classList.remove('d-none');
                fetch('/certificate-search?q=' + encodeURIComponent(q))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (searchLoader) searchLoader.classList.add('d-none');
                    var results = (data.results || []).map(function(r) {
                        return '<div class="search-result-item p-2" style="cursor:pointer;border-bottom:1px solid #eee" data-json=' + JSON.stringify(r) + '><strong>' + r.name_bn + '</strong> <span class="badge bg-secondary">' + r.sonod_number + '</span></div>';
                    });
                    searchDropdown.innerHTML = results.join('');
                    searchDropdown.style.display = results.length ? 'block' : 'none';
                })
                .catch(function() { if (searchLoader) searchLoader.classList.add('d-none'); });
            }, 300);
        });
        searchDropdown.addEventListener('click', function(e) {
            var item = e.target.closest('.search-result-item');
            if (item) {
                var data = JSON.parse(item.dataset.json);
                renderResults({results: [data]});
                searchDropdown.style.display = 'none';
            }
        });
    }
});


/* ===============================
   Charts
================================= */
document.addEventListener('DOMContentLoaded', function() {

    /**
     * Load simple chart (line / bar)
     */
    function loadChart(url, chartId, type, titleText) {
        fetch(url)
            .then(res => {
                if (!res.ok) throw new Error('Network error');
                return res.json();
            })
            .then(data => {
                new Chart(document.getElementById(chartId), {
                    type: type,
                    data: data,
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' },
                            title: {
                                display: true,
                                text: titleText
                            }
                        },
                        scales: {
                            y: { beginAtZero: true },
                            x: {
                                ticks: {
                                    autoSkip: false,
                                    maxRotation: 45
                                }
                            }
                        }
                    }
                });
            })
            .catch(() => {
                var el = document.getElementById(chartId);
                if (el && el.parentNode) {
                    el.parentNode.insertAdjacentHTML('beforeend', '<div class="text-danger mt-2">চার্ট ডেটা লোড করতে ব্যর্থ হয়েছে।</div>');
                }
            });
    }

    /* ===============================
       Monthly Charts
    ================================= */
    loadChart(
        '/chart-data-monthly',
        'monthlyChart',
        'line',
        'মাসভিত্তিক আবেদন সংখ্যা'
    );

    loadChart(
        '/chart-data-monthly-status',
        'statusChart',
        'bar',
        'মাসভিত্তিক আবেদন (স্ট্যাটাস অনুযায়ী)'
    );

    /* ===============================
       Certificate-wise Chart
    ================================= */
    var chartLoader = document.getElementById('chartLoader'); if (chartLoader) chartLoader.style.display = '';

    fetch('/chart-data')
    .then(function(r) { return r.json(); })
    .then(function (chartData) {
            if (chartLoader) chartLoader.style.display = 'none';

            /* Summary info */
            const summaryHtml = `
                <div class="mb-3">
                    <strong>মোট সার্টিফিকেট:</strong> ${chartData.total_certificates}<br>
                    <strong>মোট আবেদন:</strong> ${chartData.total_applications}
                </div>
            `;
            var chartLegend = document.getElementById('chartLegend'); if (chartLegend) chartLegend.insertAdjacentHTML('beforebegin', summaryHtml);

            /* Chart */
            const ctx = document.getElementById('certificateChart').getContext('2d');
            const myChart = new Chart(ctx, {
                type: 'bar',
                data: chartData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { bottom: 40 } },
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45
                            }
                        },
                        y: { beginAtZero: true }
                    }
                }
            });

            /* Custom legend */
            var legendContainer = document.getElementById('chartLegend');

            legendContainer.innerHTML = '';

            chartData.datasets.forEach((dataset, index) => {
                const legendItem = document.createElement('div');
                legendItem.style.cssText = 'display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;user-select:none';

                const colorBox = document.createElement('div');
                colorBox.style.cssText = `width:18px;height:18px;background-color:${dataset.backgroundColor};border:2px solid ${dataset.borderColor};border-radius:3px`;

                const labelText = document.createElement('span');
                labelText.textContent = dataset.label;

                legendItem.appendChild(colorBox);
                legendItem.appendChild(labelText);
                legendContainer.appendChild(legendItem);

                legendItem.addEventListener('click', function () {
                    const meta = myChart.getDatasetMeta(index);
                    meta.hidden = !meta.hidden;
                    myChart.update();
                    legendItem.style.opacity = meta.hidden ? 0.5 : 1;
                });
            });
        })
        .catch(function () {
            var loader = document.getElementById('chartLoader');
            if (loader) loader.textContent = '\u099A\u09BE\u09B0\u09CD\u099F \u09A1\u09C7\u099F\u09BE \u09B2\u09CB\u09A1 \u0995\u09B0\u09A4\u09C7 \u09AC\u09CD\u09AF\u09B0\u09CD\u09A5 \u09B9\u09AF়\u09C7\u099B\u09C7\u0964';
        });
});


/* ===============================
   Error Statistics — Live Load
================================= */
document.addEventListener('DOMContentLoaded', function() {
    fetch('/admin/error-stats')
    .then(function(r) { return r.json(); })
    .then(function (stats) {
            var errorLoader = document.getElementById('errorStatsLoader');
            var errorGrid = document.getElementById('errorStatsGrid');
            if (errorLoader) errorLoader.style.display = 'none';
            if (errorGrid) { errorGrid.style.display = ''; errorGrid.style.opacity = '1'; }

            // Helper: animate number
            function animate(el, val) {
                var el2 = typeof el === 'string' ? document.querySelector(el) : el;
                if (!el2) return;
                var startTime = null;
                function step(timestamp) {
                    if (!startTime) startTime = timestamp;
                    var progress = Math.min((timestamp - startTime) / 600, 1);
                    el2.textContent = toBn(Math.round(progress * val));
                    if (progress < 1) requestAnimationFrame(step);
                    else el2.textContent = toBn(val);
                }
                requestAnimationFrame(step);
            }

            animate('#statTotal', stats.total_errors);
            animate('#statFatal', stats.fatal_errors);
            animate('#statWarning', stats.warnings);
            animate('#statException', stats.exceptions);
            animate('#statNotice', stats.notices);
            animate('#statRoute', stats.route_errors);
            animate('#statTwig', stats.twig_errors);
            animate('#statHttp', stats.http_errors || 0);
            animate('#stat404', stats.route_404_errors || 0);
            var fileSizeEl = document.getElementById('statFileSize');
            if (fileSizeEl) fileSizeEl.textContent = stats.file_size_display || '\u2014';
    })
    .catch(function () {
        var errorLoader2 = document.getElementById('errorStatsLoader');
        if (errorLoader2) { errorLoader2.classList.remove('spinner-border'); errorLoader2.classList.add('text-danger'); errorLoader2.textContent = '\u26A0\uFE0F'; }
    });
});

</script>
{% endblock %}
